@implements IAsyncDisposable
@inject IJSRuntime JS

<cg-owned @ref="_root" class="slotMachine-box">
    <div class="slotMachine">
        <div class="slot slot1"><ul id="slot1"><li>0</li></ul></div>
        <div class="slot slot2"><ul id="slot2"><li>0</li></ul></div>
        <div class="slot slot3"><ul id="slot3"><li>0</li></ul></div>
        <div class="slot slot4"><ul id="slot4"><li>0</li></ul></div>
        <a class="slotMachine-btn" @onclick="() => OnClickRoll.InvokeAsync()">
            <img src="@(IsDrawNumberMode ? "https://res.cngal.org/images/expo/raffle-btn.png" : "https://res.cngal.org/_content/CnGalWebSite.Shared/images/raffle-btn.png")" alt="button">
        </a>
    </div>
    <div id="prize" class="prizeTips"></div>
    <div id="luckyOne" class="prizeTips"></div>
</cg-owned>

@code {
    [Parameter]
    public EventCallback OnClickRoll { get; set; }

    /// <summary>
    /// 抽号模式：切换按钮图标为 Expo 专用样式
    /// </summary>
    [Parameter]
    public bool IsDrawNumberMode { get; set; }

    private ElementReference _root;
    private IJSObjectReference? _module, _controller;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/CnGalWebSite.MainSite.Shared/Components/Features/Lottery/Draw/LotteryAnimationCard.razor.js");
        _controller = await _module.InvokeAsync<IJSObjectReference>("create", _root);
    }
    public async Task Roll(int index)
    {
        if (_controller is not null) await _controller.InvokeVoidAsync("roll", index);
    }
    public async ValueTask DisposeAsync()
    {
        try {
            if (_controller is not null) { await _controller.InvokeVoidAsync("dispose"); await _controller.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }
}
