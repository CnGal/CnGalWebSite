@using CnGalWebSite.DataModel.Sorting
@using CnGalWebSite.Core.Models
@using CnGalWebSite.DataModel.ViewModel.Perfections

@inject IPerfectionQueryService PerfectionQueryService

<CgDataTable TItem="PerfectionOverviewModel" TSort="PerfectionSortField"
             Title="完善度列表"
             OnServerQuery="LoadPerfectionsAsync"
             DefaultSortField="PerfectionSortField.Id"
             DefaultSortDesc="true"
             @ref="_dataTable">

    <CgDataTableColumn TItem="PerfectionOverviewModel" TSort="PerfectionSortField" Title="Id" SortField="PerfectionSortField.Id" Value="item => item.Id" Width="80px" />

    <CgDataTableColumn TItem="PerfectionOverviewModel" TSort="PerfectionSortField" Title="词条名称" Sortable="false">
        <ChildContent Context="item">
            <a href="/entries/index/@item.Id">@item.Name</a>
        </ChildContent>
    </CgDataTableColumn>

    <CgDataTableColumn TItem="PerfectionOverviewModel" TSort="PerfectionSortField" Title="完善度" SortField="PerfectionSortField.Grade" Value="item => item.Grade" Sortable="false">
        <ChildContent Context="item">
            @item.Grade.ToString("F1")
        </ChildContent>
    </CgDataTableColumn>

    <CgDataTableColumn TItem="PerfectionOverviewModel" TSort="PerfectionSortField" Title="击败全站百分比" SortField="PerfectionSortField.VictoryPercentage" Value="item => item.VictoryPercentage" Sortable="false">
        <ChildContent Context="item">
            @item.VictoryPercentage.ToString("F1")%
        </ChildContent>
    </CgDataTableColumn>

</CgDataTable>

@code {
    private CgDataTable<PerfectionOverviewModel, PerfectionSortField>? _dataTable;

    private async Task<CgDataTableResult<PerfectionOverviewModel>> LoadPerfectionsAsync(CgDataTableRequest<PerfectionSortField> request)
    {
        var parameter = request.ToQueryParameter();

        var result = await PerfectionQueryService.ListPerfectionsAsync(parameter);

        if (result.Success && result.Data != null)
        {
            return new CgDataTableResult<PerfectionOverviewModel>(
                result.Data.Items.ToList(),
                result.Data.Total);
        }

        return new CgDataTableResult<PerfectionOverviewModel>([], 0);
    }
}
