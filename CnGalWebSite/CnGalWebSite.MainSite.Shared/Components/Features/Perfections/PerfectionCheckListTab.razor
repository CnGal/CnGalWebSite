@using CnGalWebSite.DataModel.Sorting
@using CnGalWebSite.Core.Models
@using CnGalWebSite.DataModel.ViewModel.Perfections

@inject IPerfectionQueryService PerfectionQueryService

<CgDataTable TItem="PerfectionCheckOverviewModel" TSort="PerfectionCheckSortField"
             Title="完善度检查列表"
             OnServerQuery="LoadPerfectionChecksAsync"
             DefaultSortField="PerfectionCheckSortField.Id"
             DefaultSortDesc="true"
             @ref="_dataTable">

    <CgDataTableColumn TItem="PerfectionCheckOverviewModel" TSort="PerfectionCheckSortField" Title="Id" SortField="PerfectionCheckSortField.Id" Value="item => item.Id" Width="80px" />

    <CgDataTableColumn TItem="PerfectionCheckOverviewModel" TSort="PerfectionCheckSortField" Title="词条名称" Sortable="false">
        <ChildContent Context="item">
            <a href="/entries/index/@item.Id">@item.Name</a>
        </ChildContent>
    </CgDataTableColumn>

    <CgDataTableColumn TItem="PerfectionCheckOverviewModel" TSort="PerfectionCheckSortField" Title="检查项类型" Sortable="false">
        <ChildContent Context="item">
            @item.Type.GetDisplayName()
        </ChildContent>
    </CgDataTableColumn>

    <CgDataTableColumn TItem="PerfectionCheckOverviewModel" TSort="PerfectionCheckSortField" Title="分数" SortField="PerfectionCheckSortField.Grade" Value="item => item.Grade" Sortable="false">
        <ChildContent Context="item">
            @item.Grade.ToString("F1")
        </ChildContent>
    </CgDataTableColumn>

    <CgDataTableColumn TItem="PerfectionCheckOverviewModel" TSort="PerfectionCheckSortField" Title="击败全站百分比" SortField="PerfectionCheckSortField.VictoryPercentage" Value="item => item.VictoryPercentage" Sortable="false">
        <ChildContent Context="item">
            @item.VictoryPercentage.ToString("F1")%
        </ChildContent>
    </CgDataTableColumn>

</CgDataTable>

@code {
    private CgDataTable<PerfectionCheckOverviewModel, PerfectionCheckSortField>? _dataTable;

    private async Task<CgDataTableResult<PerfectionCheckOverviewModel>> LoadPerfectionChecksAsync(CgDataTableRequest<PerfectionCheckSortField> request)
    {
        var parameter = request.ToQueryParameter();

        var result = await PerfectionQueryService.ListPerfectionChecksAsync(parameter);

        if (result.Success && result.Data != null)
        {
            return new CgDataTableResult<PerfectionCheckOverviewModel>(
                result.Data.Items.ToList(),
                result.Data.Total);
        }

        return new CgDataTableResult<PerfectionCheckOverviewModel>([], 0);
    }
}
