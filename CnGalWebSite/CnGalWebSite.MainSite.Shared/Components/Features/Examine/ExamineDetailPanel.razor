@using CnGalWebSite.DataModel.ViewModel.Admin
@inject IExamineCommandService ExamineCommandService
@inject IExamineQueryService ExamineQueryService
@inject ICgToastService ToastService
@implements IDisposable

<div class="examine-detail-panel">
    <RecordObjectSummary Type="_record.Type" ObjectId="_record.ObjectId" UserId="@_record.UserId" Name="@_record.ObjectName"
        Description="@_record.ObjectBriefIntroduction" Image="@_record.Image" IsThumbnail="_record.IsThumbnail">
        @if (_record.IsPassed == true && RecordPresentation.SupportsHistory(_record.Type))
        {
            <a class="record-object__action" href="@($"/home/editrecord?ContrastId={_record.Id}&Mode=record")">
                查看编辑记录 <span aria-hidden="true">→</span>
            </a>
        }
    </RecordObjectSummary>
    <RecordMetadata Model="_record" />

    @if (_record.PrepositionExamineId > 0 && _record.IsPassed is null)
    {
        <div class="examine-detail-panel__alert" role="status">
            <span><strong>请先处理前置审核</strong><a href="/examine?Id=@_record.PrepositionExamineId">查看前置审核 #@_record.PrepositionExamineId →</a></span>
            <CgButton Variant="secondary" Size="sm" Async OnClick="RefreshRecordAsync" Disabled="_processing || _refreshing">刷新状态</CgButton>
        </div>
    }
    <ReviewContent Model="_record" />
    <RecordNotes Comments="@_record.Comments" Note="@_record.Note" ShowEmpty="true" />
    @if (_record.ContributionValue > 0)
    { <p class="examine-detail-panel__contribution">附加贡献值 <strong>@_record.ContributionValue</strong></p> }
    @if (_record.SensitiveWords is { Count: > 0 })
    {
        <section class="examine-detail-panel__alert"><h3>敏感词检测 · @_record.SensitiveWords.Count</h3><ul>
            @foreach (var word in _record.SensitiveWords) { <li>@word</li> }
        </ul></section>
    }
    @if (_record.IsAdmin && _record.IsPassed is null)
    {
        <section class="examine-detail-panel__admin-actions" aria-label="审核操作" aria-busy="@(_processing ? "true" : "false")">
            <h4 class="examine-detail-panel__section-title">
                <CgMdiIcon Name="mdiShieldCheckOutline" aria-hidden="true" />
                审核操作
            </h4>
            <div class="examine-detail-panel__action-body">
                <div class="examine-detail-panel__action-input">
                    <label for="examine-comments">批注</label>
                    <CgTextarea Id="examine-comments" @bind-Value="_comments" Placeholder="可选，输入审核批注..." Disabled="_processing" />
                </div>
                @if (_error is not null) { <p class="examine-detail-panel__error" role="alert">@_error</p> }
                <div class="examine-detail-panel__action-buttons">
                    <CgButton Variant="primary" OnClick="() => HandleProc(true)" Disabled="@(!CanProcess || _processing)">
                        <CgMdiIcon Name="mdiCheck" aria-hidden="true" />
                        通过
                    </CgButton>
                    <CgButton Variant="danger" OnClick="() => HandleProc(false)" Disabled="@(!CanProcess || _processing)">
                        <CgMdiIcon Name="mdiClose" aria-hidden="true" />
                        驳回
                    </CgButton>
                </div>
            </div>
        </section>
    }
    else if (_error is not null)
    { <p class="examine-detail-panel__error" role="alert">@_error</p> }
</div>

@code {
    [Parameter, EditorRequired] public ExamineViewModel Model { get; set; } = default!;
    [Parameter] public EventCallback OnProcCompleted { get; set; }
    private ExamineViewModel _record = default!;
    private ExamineViewModel? _source;
    private string? _comments = "";
    private string? _error;
    private bool _processing;
    private bool _refreshing;
    private bool _submitted;
    private bool _disposed;
    private CancellationTokenSource? _cts;
    private bool CanProcess => !_submitted && RecordPresentation.CanProcess(_record);

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_source, Model)) return;
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new();
        _source = Model;
        _record = Model;
        _comments = "";
        _processing = false;
        _submitted = false;
        _error = null;
    }

    private async Task RefreshRecordAsync()
    {
        if (_disposed || _refreshing) return;
        var token = _cts!.Token;
        _refreshing = true;
        _error = null;
        try
        {
            var latest = await ExamineQueryService.RefreshExamineDetailAsync(_record.Id, token);
            if (_disposed || token.IsCancellationRequested) return;
            if (latest.Success && latest.Data is { } record)
            {
                _record = record;
            }
            else
            {
                _error = latest.Error?.Message ?? "刷新审核状态失败，请重试。";
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed && !token.IsCancellationRequested) _refreshing = false;
        }
    }

    private async Task HandleProc(bool isPassed)
    {
        if (_disposed || _processing || !CanProcess) return;
        var token = _cts!.Token;
        var id = _record.Id;
        var comments = _comments ?? "";
        _processing = true;
        _error = null;
        try
        {
            var result = await ExamineCommandService.ProcExamineAsync(id, isPassed, comments, token);
            if (_disposed || token.IsCancellationRequested) return;
            if (result.Success)
            {
                _submitted = true;
                ToastService.Show(isPassed ? "审核已通过" : "审核已驳回", variant: "success");
                await OnProcCompleted.InvokeAsync();
            }
            else
            {
                _error = result.Error?.Message ?? "审核提交失败，请重试。";
                // The command invalidates its detail cache. Re-read permissions/dependencies and detect another reviewer.
                var latest = await ExamineQueryService.GetExamineDetailAsync(id, token);
                if (_disposed || token.IsCancellationRequested) return;
                if (latest.Success && latest.Data is { } record)
                {
                    _record = record;
                    if (record.IsPassed.HasValue) _error = "此记录已被处理，已更新为最新审核结果。";
                }
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        finally
        {
            if (!_disposed && !token.IsCancellationRequested) _processing = false;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
