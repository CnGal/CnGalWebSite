@using CnGalWebSite.DataModel.ViewModel.Admin
@using CnGalWebSite.SDK.MainSite.Models

<div class="record-comparison @(SubmissionOnly ? "record-comparison--single" : "")">
    @if (SnapshotIncomplete)
    {
        <p class="record-comparison__empty" role="status">版本快照不完整，无法确认是否存在变化。</p>
    }
    @if (!_diff.HasChanges)
    {
        @if (!SnapshotIncomplete)
        {
            <p class="record-comparison__empty" role="status">无变化</p>
        }
    }
    else
    {
        @foreach (var group in ChangedItems.GroupBy(i => i.Item.Group))
        {
            <section class="record-comparison__section" aria-label="@group.Key">
                <h3>@group.Key</h3>
                <div class="record-comparison__headings">
                    @if (!SubmissionOnly) { <span>@BeforeTitle</span> }
                    <span>@AfterTitle</span>
                </div>
                @foreach (var row in group)
                {
                    <article class="record-comparison__row record-comparison__row--@row.Change.ToString().ToLowerInvariant()">
                        @if (ShowItemLabel(row))
                        {
                            <header>@row.Item.Label</header>
                        }
                        <div class="record-comparison__columns">
                            @if (!SubmissionOnly)
                            {
                                <div class="record-comparison__side">
                                    <span class="record-comparison__side-heading">@BeforeTitle</span>
                                    <RecordItemValue Item="row.Before" Other="row.After" IsBefore="true" InlineDiff="@(row.Change == RecordChangeKind.Modified && !SubmissionOnly)" />
                                </div>
                            }
                            <div class="record-comparison__side">
                                <span class="record-comparison__side-heading">@AfterTitle</span>
                                <RecordItemValue Item="row.After" Other="row.Before" IsBefore="false" InlineDiff="@(row.Change == RecordChangeKind.Modified && !SubmissionOnly)" />
                            </div>
                        </div>
                    </article>
                }
            </section>
        }
    }
</div>

@code {
    [Parameter] public ExaminePreDataModel? Before { get; set; }
    [Parameter] public ExaminePreDataModel? After { get; set; }
    [Parameter] public string BeforeTitle { get; set; } = "修改前";
    [Parameter] public string AfterTitle { get; set; } = "修改后";
    [Parameter] public bool SubmissionOnly { get; set; }
    private RecordDiff _diff = new([]);
    private ExaminePreDataModel? _before;
    private ExaminePreDataModel? _after;
    private bool _submissionOnly;
    private IEnumerable<RecordDiffItem> ChangedItems => _diff.Items.Where(i => i.Changed);
    private bool SnapshotIncomplete => !SubmissionOnly
        && (Before is null || After is null || !Before.IsComplete || !After.IsComplete);

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_before, Before) && ReferenceEquals(_after, After) && _submissionOnly == SubmissionOnly) return;
        _before = Before;
        _after = After;
        _submissionOnly = SubmissionOnly;
        _diff = RecordDiffBuilder.Build(Before, After, SubmissionOnly);
    }

    private static bool ShowItemLabel(RecordDiffItem row) =>
        !string.IsNullOrWhiteSpace(row.Item.Label)
        && !string.Equals(row.Item.Label, row.Item.Group, StringComparison.Ordinal)
        && !string.Equals(row.Item.Label, RecordPresentation.Display(row.Item), StringComparison.Ordinal);
}
