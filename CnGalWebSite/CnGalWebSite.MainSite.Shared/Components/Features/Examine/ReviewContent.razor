@using CnGalWebSite.DataModel.ViewModel.Admin

@if (RecordPresentation.IsSingleSubmission(Model.Operation))
{
    <RecordContentComparison After="Model.AfterModel" AfterTitle="记录提交内容" Single="true" />
}
else
{
    <RecordContentComparison Before="Model.BeforeModel" After="Model.AfterModel"
        BeforeTitle="@(Model.IsPassed is null ? "当前内容" : "记录保存内容")"
        AfterTitle="@(Model.IsPassed is null ? "提交内容" : "查询时内容")" />
}

@code {
    [Parameter, EditorRequired] public ExamineViewModel Model { get; set; } = default!;
}
