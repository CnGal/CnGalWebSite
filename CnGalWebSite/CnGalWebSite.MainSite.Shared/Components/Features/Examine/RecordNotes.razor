<div class="record-notes">
    @if (!string.IsNullOrWhiteSpace(Overview))
    { <section><h3>原始数据</h3><div class="record-notes__overview"><CgHtmlContent Content="@Overview" /></div></section> }
    @if (!string.IsNullOrWhiteSpace(Comments))
    { <section><h3>审核批注</h3><p>@Comments</p></section> }
    @if (!string.IsNullOrWhiteSpace(Note))
    { <section><h3>提交备注</h3><p>@Note</p></section> }
</div>

@code {
    [Parameter] public string? Overview { get; set; }
    [Parameter] public string? Comments { get; set; }
    [Parameter] public string? Note { get; set; }
}
