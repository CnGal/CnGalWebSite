@using CnGalWebSite.DataModel.ViewModel.Admin

<div class="record-value">
    @if (Item is null)
    {
        <span class="record-value__empty">—</span>
    }
    else
    {
        @switch (Item.Kind)
        {
            case RecordPreviewKind.Body:
                @if (InlineDiff)
                {
                    <div class="record-value__body-diff @(IsBefore ? "record-value__body-diff--before" : "record-value__body-diff--after")">
                        <CgHtmlContent Content="@RecordHtmlDiff.Build(DiffBeforeHtml, DiffAfterHtml)" />
                    </div>
                }
                else
                {
                    <CgHtmlContent Content="@ThisHtml" />
                }
                break;
            case RecordPreviewKind.Image:
                @if (RecordPresentation.HttpUrl(Item.Url ?? Item.Value) is { } imageUrl)
                {
                    <a href="@imageUrl" target="_blank" rel="noopener noreferrer" aria-label="@($"查看原图：{Item.Label}")">
                        <RecordImage Url="@imageUrl" Alt="@(Item.Label ?? "记录图片")" Contain="true" />
                    </a>
                }
                else { <span class="record-value__empty">—</span> }
                break;
            case RecordPreviewKind.Audio:
                @if (ShowAudioNameDiff)
                {
                    <span class="record-value__audio-name">
                        <RecordDiffText Before="@DiffBeforeLabel" After="@DiffAfterLabel" IsBefore="IsBefore" />
                    </span>
                }
                @if (RecordPresentation.HttpUrl(Item.Url ?? Item.Value) is { } audioUrl)
                {
                    <audio controls preload="none" src="@audioUrl" aria-label="@(Item.Label ?? "记录音频")"></audio>
                    <a href="@audioUrl" target="_blank" rel="noopener noreferrer">打开音频</a>
                }
                else { <span class="record-value__empty">—</span> }
                break;
            default:
                @if (InlineDiff)
                {
                    @if (SafeUrl is { } diffUrl)
                    {
                        <a href="@diffUrl" target="_blank" rel="noopener noreferrer">
                            <RecordDiffText Before="@DiffBeforeText" After="@DiffAfterText" IsBefore="IsBefore" />
                        </a>
                    }
                    else
                    {
                        <span class="record-value__text">
                            <RecordDiffText Before="@DiffBeforeText" After="@DiffAfterText" IsBefore="IsBefore" />
                        </span>
                    }
                }
                else if (SafeUrl is { } url)
                {
                    <a href="@url" target="_blank" rel="noopener noreferrer">@Text</a>
                }
                else
                {
                    <span class="record-value__text">@Text</span>
                }
                @if (ShowLinkDestination)
                {
                    <span class="record-value__url">
                        <RecordDiffText Before="@DiffBeforeUrl" After="@DiffAfterUrl" IsBefore="IsBefore" />
                    </span>
                }
                break;
        }
        @if (VisibleProperties.Any())
        {
            <dl>
                @foreach (var property in VisibleProperties)
                {
                    <div>
                        <dt>@property.Label</dt>
                        <dd>
                            @if (InlineDiff)
                            {
                                <RecordDiffText Before="@(IsBefore ? property.DisplayValue : OtherPropertyValue(property))"
                                    After="@(IsBefore ? OtherPropertyValue(property) : property.DisplayValue)" IsBefore="IsBefore" />
                            }
                            else
                            {
                                @property.DisplayValue
                            }
                        </dd>
                    </div>
                }
            </dl>
        }
    }
</div>

@code {
    [Parameter] public RecordPreviewItem? Item { get; set; }
    [Parameter] public RecordPreviewItem? Other { get; set; }
    [Parameter] public bool IsBefore { get; set; }
    [Parameter] public bool InlineDiff { get; set; } = true;

    private string Text => string.IsNullOrEmpty(Item?.DisplayValue) ? Item?.Value is { Length: > 0 } value ? value : "—" : Item.DisplayValue;
    private string RawText => string.IsNullOrEmpty(Item?.DisplayValue) ? Item?.Value ?? string.Empty : Item.DisplayValue;
    private string OtherRawText => string.IsNullOrEmpty(Other?.DisplayValue) ? Other?.Value ?? string.Empty : Other?.DisplayValue ?? string.Empty;
    private string? DiffBeforeText => IsBefore ? RawText : OtherRawText;
    private string? DiffAfterText => IsBefore ? OtherRawText : RawText;
    private string? ThisHtml => Item?.Html ?? Item?.Value;
    private string? OtherHtml => Other?.Kind == RecordPreviewKind.Body ? Other.Html ?? Other.Value : null;
    private string? DiffBeforeHtml => IsBefore ? ThisHtml : OtherHtml;
    private string? DiffAfterHtml => IsBefore ? OtherHtml : ThisHtml;
    private string? SafeUrl => RecordPresentation.ContentUrl(Item?.Url);
    private string? RawUrl => Item?.Url ?? Item?.Value;
    private string? OtherRawUrl => Other?.Url ?? Other?.Value;
    private string? DiffBeforeUrl => IsBefore ? RawUrl : OtherRawUrl;
    private string? DiffAfterUrl => IsBefore ? OtherRawUrl : RawUrl;
    private string? RawLabel => Item?.Label;
    private string? OtherRawLabel => Other?.Label;
    private string? DiffBeforeLabel => IsBefore ? RawLabel : OtherRawLabel;
    private string? DiffAfterLabel => IsBefore ? OtherRawLabel : RawLabel;
    private bool ShowLinkDestination => Item?.Kind == RecordPreviewKind.Link
        && !string.IsNullOrWhiteSpace(DiffBeforeUrl ?? DiffAfterUrl)
        && (!string.Equals(DiffBeforeText, DiffBeforeUrl, StringComparison.Ordinal)
            || !string.Equals(DiffAfterText, DiffAfterUrl, StringComparison.Ordinal));
    private bool ShowAudioNameDiff => Item?.Kind == RecordPreviewKind.Audio
        && !string.Equals(RawLabel ?? string.Empty, OtherRawLabel ?? string.Empty, StringComparison.Ordinal)
        && (!string.IsNullOrWhiteSpace(RawLabel) || !string.IsNullOrWhiteSpace(OtherRawLabel));
    private string? OtherPropertyValue(RecordPreviewProperty property) =>
        Other?.Properties.FirstOrDefault(other => other.Key == property.Key)?.DisplayValue ?? string.Empty;
    private IEnumerable<RecordPreviewProperty> VisibleProperties => (Item?.Properties ?? [])
        .Where(p => !string.IsNullOrWhiteSpace(p.DisplayValue))
        .Where(p => Other is null || Other.Properties.FirstOrDefault(o => o.Key == p.Key)?.Value != p.Value)
        .Where(p => IsChangedProperty(p) || (p.DisplayValue != Item!.Label && p.DisplayValue != Item.DisplayValue))
        .Where(p => !(Item!.Kind == RecordPreviewKind.Audio && p.Key == "Name"));

    private bool IsChangedProperty(RecordPreviewProperty property) =>
        Other?.Properties.FirstOrDefault(other => other.Key == property.Key) is { } other
        && !string.Equals(other.Value, property.Value, StringComparison.Ordinal);
}