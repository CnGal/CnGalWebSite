@inject NavigationManager NavigationManager

<section class="record-selector" aria-label="选择历史版本">
    <div class="record-selector__fields">
        <div class="record-selector__field"><span>基准版本</span><CgSelect AriaLabel="基准版本" Value="@_contrastId" ValueChanged="v => _contrastId = v" Options="ExamineOptions" /></div>
        <div class="record-selector__field"><span>目标版本</span><CgSelect AriaLabel="目标版本" Value="@_currentId" ValueChanged="v => _currentId = v" Options="ExamineOptions" /></div>
        <CgButton OnClick="NavigateToContrast" Disabled="@(SelectionError is not null)">对比版本</CgButton>
    </div>
    @if (SelectionError is { } error) { <p role="status">@error</p> }
</section>

@code {
    [Parameter] public IEnumerable<KeyValuePair<string, string>> ExamineOptions { get; set; } = [];
    [Parameter] public long ContrastId { get; set; }
    [Parameter] public long CurrentId { get; set; }
    [Parameter] public long SelectedId { get; set; }
    private string? _contrastId;
    private string? _currentId;
    private (long, long)? _loaded;

    protected override void OnParametersSet()
    {
        if (_loaded == (ContrastId, CurrentId)) return;
        _loaded = (ContrastId, CurrentId);
        _contrastId = ContrastId.ToString();
        _currentId = CurrentId.ToString();
    }

    private string? SelectionError => !long.TryParse(_contrastId, out var before) || !long.TryParse(_currentId, out var after)
        || !ExamineOptions.Any(o => o.Key == _contrastId) || !ExamineOptions.Any(o => o.Key == _currentId)
        ? "请选择此对象的有效历史版本。"
        : before > after ? "基准版本不能晚于目标版本，请调整选择。" : null;

    private void NavigateToContrast()
    {
        if (SelectionError is not null) return;
        NavigationManager.NavigateTo($"/home/editrecord?ContrastId={_contrastId}&CurrentId={_currentId}&SelectedId={SelectedId}&Mode=compare");
    }
}
