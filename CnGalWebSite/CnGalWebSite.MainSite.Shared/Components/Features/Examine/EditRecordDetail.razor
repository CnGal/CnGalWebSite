@using CnGalWebSite.DataModel.ViewModel.Home
@using CnGalWebSite.DataModel.ViewModel.Admin

@if (Model is not null)
{
    <div class="edit-record-detail">
        <RecordMetadata Model="@Metadata">
            <a class="edit-record-detail__link" href="/examine?Id=@Model.Id">查看审核详情 →</a>
        </RecordMetadata>
        <RecordNotes Overview="@Model.EditOverview" Comments="@Model.Comments" Note="@Model.Note" />
    </div>
}

@code {
    [Parameter] public EditRecordAloneViewModel? Model { get; set; }
    private ExamineViewModel Metadata => new() { Id = Model!.Id, Operation = Model.Operation,
        UserId = Model.UserId, UserName = Model.UserName, ApplyTime = Model.ApplyTime,
        PassedTime = Model.PassedTime, PassedAdminName = Model.PassedAdminName, IsPassed = true };
}
