@using CnGalWebSite.DataModel.Sorting
@using CnGalWebSite.DataModel.ViewModel.Admin
@using CnGalWebSite.DataModel.Model
@using CnGalWebSite.Core.Models

@inject IExamineQueryService ExamineQueryService
@inject IExamineCommandService ExamineCommandService
@inject ICgToastService ToastService
@inject NavigationManager NavigationManager

@* 审核列表面板（服务端分页） *@

<CgDataTable TItem="ExamineOverviewModel" TSort="ExamineSortField"
             Title="审核列表"
             OnServerQuery="LoadExaminesAsync"
             DefaultSortField="ExamineSortField.PassedTime"
             DefaultSortDesc="true"
             @ref="_dataTable">

    <CgDataTableColumn TItem="ExamineOverviewModel" TSort="ExamineSortField" Title="Id" SortField="ExamineSortField.Id" Value="item => item.Id" Width="80px" />

    <CgDataTableColumn TItem="ExamineOverviewModel" TSort="ExamineSortField" Title="操作" SortField="ExamineSortField.Operation" Value="item => item.Operation" Sortable="false">
        <ChildContent Context="item">
            @item.Operation.GetDisplayName()
        </ChildContent>
    </CgDataTableColumn>

    <CgDataTableColumn TItem="ExamineOverviewModel" TSort="ExamineSortField" Title="状态" SortField="ExamineSortField.IsPassed" Value="item => item.IsPassed" Sortable="false">
        <ChildContent Context="item">
            <ExamineStatusBadge IsPassed="@item.IsPassed" />
        </ChildContent>
    </CgDataTableColumn>

    <CgDataTableColumn TItem="ExamineOverviewModel" TSort="ExamineSortField" Title="处理时间" SortField="ExamineSortField.PassedTime" Value="item => item.PassedTime">
        <ChildContent Context="item">
            @(item.PassedTime?.ToString("yyyy-MM-dd HH:mm") ?? "—")
        </ChildContent>
    </CgDataTableColumn>

    <CgDataTableColumn TItem="ExamineOverviewModel" TSort="ExamineSortField" Title="申请时间" SortField="ExamineSortField.ApplyTime" Value="item => item.ApplyTime">
        <ChildContent Context="item">
            @item.ApplyTime.ToString("yyyy-MM-dd HH:mm")
        </ChildContent>
    </CgDataTableColumn>

    <CgDataTableColumn TItem="ExamineOverviewModel" TSort="ExamineSortField" Title="申请人" Sortable="false">
        <ChildContent Context="item">
            <a class="examine-user-link" href="/space/index/@item.ApplicationUserId">@(item.UserName ?? "—")</a>
        </ChildContent>
    </CgDataTableColumn>

    <CgDataTableColumn TItem="ExamineOverviewModel" TSort="ExamineSortField" Title="处理人" SortField="ExamineSortField.PassedAdminName" Value="item => item.PassedAdminName" Sortable="false" />

    <CgDataTableColumn TItem="ExamineOverviewModel" TSort="ExamineSortField" Title="批注" SortField="ExamineSortField.Comments" Value="item => item.Comments" Sortable="false" />

    <CgDataTableColumn TItem="ExamineOverviewModel" TSort="ExamineSortField" Title="操作" Sortable="false" Width="140px">
        <ChildContent Context="item">
            <div class="examine-actions">
                <button class="examine-action-btn examine-action-btn--view" title="查看" data-cg-server-action @onclick="() => LookItem(item)">
                    <CgMdiIcon Name="mdiEyeOutline" aria-hidden="true" />
                </button>
                @if (item.IsPassed == null)
                {
                    <button class="examine-action-btn examine-action-btn--approve" title="通过" data-cg-server-action @onclick="() => ProcItem(item, true)">
                        <CgMdiIcon Name="mdiCheck" aria-hidden="true" />
                    </button>
                    <button class="examine-action-btn examine-action-btn--reject" title="驳回" data-cg-server-action @onclick="() => ProcItem(item, false)">
                        <CgMdiIcon Name="mdiClose" aria-hidden="true" />
                    </button>
                }
            </div>
        </ChildContent>
    </CgDataTableColumn>

</CgDataTable>

@code {
    private CgDataTable<ExamineOverviewModel, ExamineSortField>? _dataTable;

    private async Task<CgDataTableResult<ExamineOverviewModel>> LoadExaminesAsync(CgDataTableRequest<ExamineSortField> request)
    {
        var parameter = request.ToQueryParameter();

        var result = await ExamineQueryService.GetExaminesAsync(parameter);
        if (result.Success && result.Data != null)
        {
            return new CgDataTableResult<ExamineOverviewModel>(
                result.Data.Items.ToList(),
                result.Data.Total);
        }

        return new CgDataTableResult<ExamineOverviewModel>([], 0);
    }

    private void LookItem(ExamineOverviewModel model)
    {
        NavigationManager.NavigateTo($"/examine?Id={model.Id}");
    }

    private async Task ProcItem(ExamineOverviewModel model, bool isPassed)
    {
        var operationName = isPassed ? "通过审核" : "驳回审核";
        var result = await ExamineCommandService.ProcExamineAsync(model.Id, isPassed);
        if (result.Success)
        {
            ToastService.Show(operationName + "成功", variant: "success");
            if (_dataTable != null)
            {
                await _dataTable.RefreshAsync();
            }
        }
        else
        {
            ToastService.Show(operationName + "失败", result.Error?.Message, "error");
        }
    }
}
