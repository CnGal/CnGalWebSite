@using CnGalWebSite.DataModel.ViewModel.Admin

<div class="record-content">
    @foreach (var item in BodyItems)
    {
        <section class="record-content__section">
            <CgHtmlContent Content="@item.Html" />
        </section>
    }

    @if (TextGroups.Count > 0)
    {
        <section class="record-content__section" aria-label="文本信息">
            <h4>文本信息</h4>
            @foreach (var group in TextGroups)
            {
                @if (!string.IsNullOrWhiteSpace(group.Key)) { <h5>@group.Key</h5> }
                <dl class="record-content__fields">
                    @foreach (var item in group)
                    {
                        <div>
                            <dt>@item.Label</dt>
                            <dd>@RecordPresentation.Display(item)</dd>
                        </div>
                    }
                </dl>
            }
        </section>
    }

    @if (Images.Count > 0)
    {
        <section class="record-content__section" aria-label="图片">
            <h4>图片</h4>
            <div class="record-content__pictures">
                @foreach (var image in Images)
                {
                    <figure>
                        @if (RecordPresentation.HttpUrl(image.Url ?? image.Value) is { } imageUrl)
                        {
                            <a href="@imageUrl" target="_blank" rel="noopener noreferrer" aria-label="@($"查看原图：{image.Label ?? "图片"}")">
                                <RecordImage Url="@imageUrl" Alt="@(image.Label ?? "记录图片")" Contain="true" />
                            </a>
                        }
                        else { <span class="record-content__empty">—</span> }
                        @if (!string.IsNullOrWhiteSpace(image.Label)) { <figcaption>@image.Label</figcaption> }
                    </figure>
                }
            </div>
        </section>
    }

    @if (Relations.Count > 0)
    {
        <section class="record-content__section" aria-label="关联对象">
            <h4>关联对象</h4>
            <ul class="record-content__links">
                @foreach (var relation in Relations)
                {
                    <li>
                        @if (RecordPresentation.ContentUrl(relation.Url) is { } url)
                        { <a href="@url" target="_blank" rel="noopener noreferrer">@RecordPresentation.Display(relation)</a> }
                        else { <span>@RecordPresentation.Display(relation)</span> }
                    </li>
                }
            </ul>
        </section>
    }

    @if (Outlinks.Count > 0)
    {
        <section class="record-content__section" aria-label="外链">
            <h4>外链</h4>
            <dl class="record-content__fields">
                @foreach (var link in Outlinks)
                {
                    <div>
                        <dt>@link.Label</dt>
                        <dd>
                            @if (RecordPresentation.HttpUrl(link.Url ?? link.Value) is { } url)
                            { <a href="@url" target="_blank" rel="noopener noreferrer">@(string.IsNullOrWhiteSpace(link.DisplayValue) ? url : link.DisplayValue)</a> }
                            else { <span>@RecordPresentation.Display(link)</span> }
                        </dd>
                    </div>
                }
            </dl>
        </section>
    }

    @if (AudioItems.Count > 0)
    {
        <section class="record-content__section" aria-label="音频">
            <h4>音频</h4>
            @foreach (var audio in AudioItems)
            {
                <div class="record-content__audio">
                    @if (!string.IsNullOrWhiteSpace(audio.Label)) { <span>@audio.Label</span> }
                    @if (RecordPresentation.HttpUrl(audio.Url ?? audio.Value) is { } audioUrl)
                    {
                        <audio controls preload="none" src="@audioUrl" aria-label="@(audio.Label ?? "记录音频")"></audio>
                        <a href="@audioUrl" target="_blank" rel="noopener noreferrer">打开音频</a>
                    }
                    else { <span class="record-content__empty">—</span> }
                </div>
            }
        </section>
    }

    @if (!HasContent) { <p class="record-content__empty">@EmptyText</p> }
</div>

@code {
    [Parameter] public ExaminePreDataModel? Model { get; set; }
    [Parameter] public string EmptyText { get; set; } = "此侧无内容";

    private List<RecordPreviewItem> Items => Model?.Items ?? new();
    private List<RecordPreviewItem> BodyItems => Items.Where(i => i.Kind == RecordPreviewKind.Body).ToList();
    private List<IGrouping<string, RecordPreviewItem>> TextGroups => Items
        .Where(i => i.Kind == RecordPreviewKind.Text)
        .GroupBy(i => i.Group ?? "")
        .ToList();
    private List<RecordPreviewItem> Images => Items.Where(i => i.Kind == RecordPreviewKind.Image).ToList();
    private List<RecordPreviewItem> Relations => Items.Where(i => i.Kind == RecordPreviewKind.Relation).ToList();
    private List<RecordPreviewItem> Outlinks => Items.Where(i => i.Kind == RecordPreviewKind.Link).ToList();
    private List<RecordPreviewItem> AudioItems => Items.Where(i => i.Kind == RecordPreviewKind.Audio).ToList();
    private bool HasContent => Items.Count > 0;
}
