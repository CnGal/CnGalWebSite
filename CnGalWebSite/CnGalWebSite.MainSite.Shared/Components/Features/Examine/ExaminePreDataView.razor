@using CnGalWebSite.DataModel.ViewModel.Admin
@using CnGalWebSite.DataModel.ViewModel.Search

<div class="record-content">
    @foreach (var kind in VisibleKinds)
    {
        <section class="record-content__section" aria-label="@RecordPresentation.Title(kind)">
            @if (Kind is null) { <h4>@RecordPresentation.Title(kind)</h4> }
            @switch (kind)
            {
                case RecordContentKind.MainPage:
                    <CgHtmlContent Content="@Model!.MainPage" />
                    break;
                case RecordContentKind.Texts:
                    @foreach (var group in Model!.Texts ?? [])
                    {
                        @if (!string.IsNullOrWhiteSpace(group.Modifier)) { <h5>@group.Modifier</h5> }
                        <dl class="record-content__fields">
                            @foreach (var field in group.Informations ?? [])
                            { <div><dt>@field.DisplayName</dt><dd>@(string.IsNullOrWhiteSpace(field.DisplayValue) ? "—" : field.DisplayValue)</dd></div> }
                        </dl>
                    }
                    break;
                case RecordContentKind.Pictures:
                    <div class="record-content__pictures">
                        @foreach (var image in Model!.Pictures ?? [])
                        {
                            <figure>
                                @if (RecordPresentation.HttpUrl(image.Url) is { } imageUrl)
                                {
                                    <a href="@imageUrl" target="_blank" rel="noopener noreferrer" aria-label="@($"查看原图：{image.Note ?? "图片"}")">
                                        <RecordImage Url="@imageUrl" Alt="@(image.Note ?? "记录图片")" Contain="true" />
                                    </a>
                                }
                                else { <span class="record-content__empty">图片地址不可用</span> }
                                @if (!string.IsNullOrWhiteSpace(image.Note)) { <figcaption>@image.Note</figcaption> }
                            </figure>
                        }
                    </div>
                    break;
                case RecordContentKind.Relevances:
                    <ul class="record-content__links">
                        @foreach (var relevance in Model!.Relevances ?? [])
                        {
                            var (name, url) = Relevance(relevance);
                            <li>@if (url is not null) { <a href="@url" target="_blank" rel="noopener noreferrer">@name</a> }
                                else { <span>@name</span> }</li>
                        }
                    </ul>
                    break;
                case RecordContentKind.Outlinks:
                    <dl class="record-content__fields">
                        @foreach (var link in Model!.Outlinks ?? [])
                        {
                            var url = RecordPresentation.HttpUrl(link.Link) ?? RecordPresentation.HttpUrl(link.DisplayValue);
                            var text = string.IsNullOrWhiteSpace(link.DisplayValue) ? url ?? "—" : link.DisplayValue;
                            <div><dt>@(link.DisplayName ?? "链接")</dt><dd>
                                @if (url is not null) { <a href="@url" target="_blank" rel="noopener noreferrer">@text</a> }
                                else { <span>@text</span> }
                            </dd></div>
                        }
                    </dl>
                    break;
                case RecordContentKind.Audio:
                    @foreach (var audio in Model!.Audio ?? [])
                    {
                        <div class="record-content__audio">
                            <span>@(audio.Name ?? "音频")</span>
                            @if (RecordPresentation.HttpUrl(audio.Url) is { } audioUrl)
                            { <audio controls preload="none" src="@audioUrl" aria-label="@(audio.Name ?? "记录音频")"></audio><a href="@audioUrl" target="_blank" rel="noopener noreferrer">打开音频</a> }
                            else { <span class="record-content__empty">音频地址不可用</span> }
                        </div>
                    }
                    break;
            }
        </section>
    }
    @if (!VisibleKinds.Any()) { <p class="record-content__empty">@EmptyText</p> }
</div>

@code {
    [Parameter] public ExaminePreDataModel? Model { get; set; }
    [Parameter] public RecordContentKind? Kind { get; set; }
    [Parameter] public string EmptyText { get; set; } = "此侧无内容";
    private IEnumerable<RecordContentKind> VisibleKinds => RecordPresentation.ContentKinds
        .Where(k => (Kind is null || Kind == k) && RecordPresentation.HasContent(Model, k));

    private static (string Name, string? Url) Relevance(SearchAloneModel model)
    {
        if (model.entry is { } e) return (e.Name ?? "未命名词条", RecordPresentation.ObjectUrl(ExaminedNormalListModelType.Entry, e.Id));
        if (model.article is { } a) return (a.DisplayName ?? a.Name ?? "未命名文章", RecordPresentation.ObjectUrl(ExaminedNormalListModelType.Article, a.Id));
        if (model.tag is { } t) return (t.Name ?? "未命名标签", RecordPresentation.ObjectUrl(ExaminedNormalListModelType.Tag, t.Id));
        if (model.video is { } v) return (v.DisplayName ?? v.Name ?? "未命名视频", RecordPresentation.ObjectUrl(ExaminedNormalListModelType.Video, v.Id));
        if (model.periphery is { } p) return (p.Name ?? "未命名周边", RecordPresentation.ObjectUrl(ExaminedNormalListModelType.Periphery, p.Id));
        if (model.user is { } u) return (u.UserName ?? "未知用户", RecordPresentation.ObjectUrl(ExaminedNormalListModelType.User, 0, u.Id));
        return ("关联对象信息不可用", null);
    }
}
