               HeaderIcon="mdiPencilOutline"
               OnSubmit="OnSubmit" OnCancel="OnCancel" OnDiscardDraft="OnDiscardDraft" IsCreate="IsCreate" />

@code {
    [Parameter] public bool IsCreate { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public bool HasDraftRecovered { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnDiscardDraft { get; set; }

    // ── 导航项定义（视频编辑 4 个 section）──
    private static readonly CgEditNavItem[] _navItems =
    [
        new("section-main", "主要信息", "mdiVideoOutline"),
        new("section-images", "预览图", "mdiImageOutline"),
        new("section-relevances", "关联信息", "mdiHub"),
        new("section-mainpage", "正文", "mdiBookOpenVariant"),
    ];

}
