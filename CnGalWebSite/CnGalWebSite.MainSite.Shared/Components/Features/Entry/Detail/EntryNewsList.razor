@using CnGalWebSite.DataModel.Model
@using CnGalWebSite.DataModel.ViewModel

<div class="entry-news">
    <EntryCardList LimitCount="PreviewCount" ShowExpandButton="News.Count > PreviewCount" ListClass="entry-news-list">
        @for (var index = 0; index < News.Count; index++)
        {
            var item = News[index];
            <li class="@(index == PreviewCount - 1 ? "entry-news-list-preview-end" : null)">
                <div class="entry-news-row-clip">
                    <div class="entry-news-row">
                        <a href="@(GetNewsLink?.Invoke(item) ?? "")" target="@GetTarget?.Invoke(item.Link)" rel="noopener noreferrer">@item.Title</a>
                        <span>@item.HappenedTime.ToString("yyyy-MM-dd")</span>
                    </div>
                </div>
            </li>
        }
    </EntryCardList>
</div>

@code {
    private const int PreviewCount = 10;

    [Parameter] public IReadOnlyList<NewsModel> News { get; set; } = [];
    // 渲染辅助函数，非事件回调
    [Parameter] public Func<NewsModel, string>? GetNewsLink { get; set; } = _ => "";
    // 渲染辅助函数，非事件回调
    [Parameter] public Func<string?, string?>? GetTarget { get; set; } = _ => null;
}
