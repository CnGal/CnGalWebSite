<div class="entry-card-list-container">
    <ul id="list_@_guid" class="entry-card-list @(LimitCount > 0 ? $"limit-{LimitCount}" : "") @ListClass">
        @ChildContent
    </ul>

    @if (LimitCount > 0 && ShowExpandButton)
    {
        <input type="checkbox" id="tgl_@_guid" class="entry-card-list-toggle"
               aria-label="显示更多条目" aria-controls="list_@_guid" />
        <div class="entry-card-list-action">
            <label for="tgl_@_guid" class="entry-card-list-btn">
                <span class="show-text">展开</span>
                <span class="hide-text">收起</span>
                <CgMdiIcon Name="mdiChevronDown" Class="icon-arrow" aria-hidden="true" />
            </label>
        </div>
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int LimitCount { get; set; }
    [Parameter] public bool ShowExpandButton { get; set; }
    [Parameter] public string? ListClass { get; set; }

    private readonly string _guid = Guid.NewGuid().ToString("N");
}
