@* 评分概览区域（交互式包装器，仅登录用户使用）
   拥有数据所有权并处理刷新，将渲染委托给 EntryScoreOverview *@

@rendermode InteractiveServer
@implements IDisposable

@inject IPlayedGameQueryService PlayedGameQueryService

@if (_model is not null)
{
    <EntryScoreOverview Model="_model" OnDataChanged="RefreshAsync" />
}

@code {
    [Parameter]
    public int EntryId { get; set; }

    [Parameter] public PlayedGameOverviewViewModel? InitialModel { get; set; }
    [Parameter] public bool HasInitialResult { get; set; }
    private int? _loadedId;
    private PlayedGameOverviewViewModel? _model;
    private CancellationTokenSource? _request;

    protected override Task OnParametersSetAsync()
    {
        if (_loadedId == EntryId) return Task.CompletedTask;
        _request?.Cancel(); _request?.Dispose();
        _loadedId = EntryId;
        _model = InitialModel;
        return !HasInitialResult && _model is null ? LoadDataAsync() : Task.CompletedTask;
    }

    private async Task LoadDataAsync()
    {
        _request?.Cancel(); _request?.Dispose();
        var request = _request = new CancellationTokenSource();
        var id = EntryId;
        try
        {
            var result = await PlayedGameQueryService.GetOverviewAsync(id, request.Token);
            if (!request.IsCancellationRequested && id == EntryId) _model = result.Success ? result.Data : null;
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested) { }
    }

    public void Dispose() { _request?.Cancel(); _request?.Dispose(); }

    private async Task RefreshAsync()
    {
        await LoadDataAsync();
    }
}
