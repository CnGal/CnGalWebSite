@using CnGalWebSite.DataModel.Model
@using CnGalWebSite.DataModel.ViewModel

<CgEditSidebar Class="entry-edit-sidebar" Items="_navItems"
               IsSubmitting="IsSubmitting" HasDraftRecovered="HasDraftRecovered"
               HeaderIcon="mdiPencilOutline"
               OnSubmit="OnSubmit" OnCancel="OnCancel" OnDiscardDraft="OnDiscardDraft" IsCreate="IsCreate"
               WarningText="@(EntryType == EntryType.Staff ? "这个词条可能涉及到现实人物，请勿过分较真，也请谨慎编辑，仔细斟酌词句" : null)">
    <BeforeContent>
        <EntrySteamImportCard Model="Model" OnModelChanged="OnModelChanged" />
    </BeforeContent>
</CgEditSidebar>

@code {
    [Parameter]
    public bool IsCreate { get; set; }

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter]
    public bool HasDraftRecovered { get; set; }

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback OnDiscardDraft { get; set; }

    [Parameter]
    public EventCallback OnModelChanged { get; set; }

    [Parameter]
    public EntryType EntryType { get; set; }

    [Parameter]
    public EstablishEntryViewModel Model { get; set; } = default!;

    // ── 导航项定义 ──
    private static readonly CgEditNavItem[] _navItems =
    [
        new("section-main", "主要信息", "mdiFileDocumentOutline"),
        new("section-addinfo", "附加信息", "mdiInformationOutline"),
        new("section-images", "相册", "mdiImageOutline"),
        new("section-mainpage", "正文主页", "mdiBookOpenVariant"),
        new("section-relevances", "关联信息", "mdiHub"),
        new("section-tags", "标签", "mdiTagOutline"),
        new("section-audio", "音频", "mdiMusicNoteOutline"),
        new("section-website", "专题页设置", "mdiEarth"),
    ];

}
