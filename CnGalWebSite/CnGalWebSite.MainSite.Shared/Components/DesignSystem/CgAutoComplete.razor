@* CgAutoComplete — 自定义下拉自动补全（类 CgSelect 风格） *@
<div class="cg-autocomplete @ClassName"
     data-cg-autocomplete="true"
     @oncgfocusleave="OnFocusLeave"
     tabindex="-1">
    <input @key="_inputKey"
           class="cg-autocomplete__input"
           type="text"
           value="@_draft"
           placeholder="@Placeholder"
           disabled="@Disabled"
           data-cg-ime-input="true"
           @oncginputcommit="OnInput"
           @onfocus="OpenDropdown"
           autocomplete="off"/>

    @if (_isOpen && _filtered.Any())
    {
        <ul class="cg-autocomplete__menu" role="listbox">
            @foreach (var item in _filtered)
            {
                <li role="option">
                    <button type="button"
                            class="cg-autocomplete__option"
                            @onpointerdown:preventDefault="true"
                            @onclick="() => SelectOption(item)">
                        @item
                    </button>
                </li>
            }
        </ul>
    }
</div>

@code {
    private const int MaxResults = 20;
    private bool _isOpen;
    private List<string> _filtered = [];
    private int _inputKey;
    private string? _draft;
    private string? _boundValue;
    private bool _initialized;
    private bool _editing;

    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter] public IEnumerable<string> Items { get; set; } = [];

    /// <summary>仅接受 Items 中的完整名称；搜索草稿在离开组件时确认或清空。</summary>
    [Parameter] public bool RestrictToItems { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string ClassName { get; set; } = string.Empty;

    protected override void OnParametersSet()
    {
        // 父组件回传有效值（或空值）时保留尚未完成的搜索草稿。
        // 外部主动更改 Value 时才替换输入，不在候选项异步加载时校验已有值。
        if (!_initialized || !string.Equals(Value ?? string.Empty, _boundValue ?? string.Empty, StringComparison.Ordinal))
        {
            _inputKey++;
            _draft = Value;
            _boundValue = Value;
            _editing = false;
            _initialized = true;
        }
    }

    private void UpdateFiltered(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            _filtered = Items.Take(MaxResults).ToList();
        }
        else
        {
            _filtered = Items
                .Where(s => s.Contains(text, StringComparison.OrdinalIgnoreCase))
                .Take(MaxResults)
                .ToList();
        }
    }

    private async Task OnInput(ChangeEventArgs args)
    {
        var text = args.Value?.ToString();
        _draft = text;
        _editing = true;
        await SetValueAsync(RestrictToItems ? FindItem(text) : text);
        UpdateFiltered(text);
        _isOpen = _filtered.Any();
    }

    private void OpenDropdown()
    {
        if (Disabled)
        {
            return;
        }

        UpdateFiltered(_draft);
        _isOpen = _filtered.Any();
    }

    private string? FindItem(string? text) => string.IsNullOrEmpty(text)
        ? null
        : Items.FirstOrDefault(item => string.Equals(item, text, StringComparison.OrdinalIgnoreCase));

    private async Task SetValueAsync(string? value)
    {
        _boundValue = value;
        await ValueChanged.InvokeAsync(value);
    }

    private async Task OnFocusLeave(CgFocusLeaveEventArgs args)
    {
        if (args.IsInternal) return;
        _isOpen = false;
        if (RestrictToItems && _editing)
        {
            _draft = FindItem(_draft);
            _editing = false;
            _inputKey++;
            await SetValueAsync(_draft);
        }
    }

    private async Task SelectOption(string item)
    {
        _isOpen = false;
        _draft = item;
        _editing = false;
        _inputKey++;
        await SetValueAsync(item);
    }

}
