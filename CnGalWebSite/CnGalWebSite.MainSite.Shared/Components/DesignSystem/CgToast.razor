@inject ICgToastService ToastService
@inject IJSRuntime JS
@implements IAsyncDisposable

<cg-owned @ref="_root" class="cg-toast-container" aria-live="polite">
    @foreach (var variant in new[] { "info", "success", "warning", "error" })
    {
        <template data-variant="@variant">
            <div class="cg-toast cg-toast--@variant" role="status">
                <CgMdiIcon Name="@GetVariantIcon(variant)" Class="cg-toast__icon" aria-hidden="true" />
                <div class="cg-toast__content"><div class="cg-toast__title"></div><div class="cg-toast__detail"></div></div>
            </div>
        </template>
    }
    @if (_loadError)
    {
        @foreach (var item in _queue)
        {
            <div class="cg-toast" role="status"><div class="cg-toast__title">@item.Title</div><div class="cg-toast__detail">@item.Detail</div></div>
        }
        <button type="button" data-cg-server-action @onclick="RetryAsync">重试通知组件</button>
    }
</cg-owned>

@code {
    [Parameter] public int Duration { get; set; } = 3000;
    private ElementReference _root;
    private IJSObjectReference? _module, _controller;
    private readonly Queue<(string Title, string? Detail, string Variant)> _queue = new();
    private bool _disposed, _draining, _loadError;
    private Task _delivery = Task.CompletedTask;
    protected override void OnInitialized()
    {
        ToastService.OnShow += HandleShow;
        foreach (var message in ToastService.DrainPending()) _queue.Enqueue((message.Title, message.Detail, message.Variant));
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _controller is not null || _loadError) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/CnGalWebSite.MainSite.Shared/Components/DesignSystem/CgToast.razor.js");
            if (_disposed) { await _module.DisposeAsync(); return; }
            _controller = await _module.InvokeAsync<IJSObjectReference>("create", _root);
            if (_disposed) { await _controller.InvokeVoidAsync("dispose"); await _controller.DisposeAsync(); return; }
            await DrainAsync();
        }
        catch (JSException ex) { _loadError = true; Console.Error.WriteLine($"CgToast mount: {ex.Message}"); if (!_disposed) StateHasChanged(); }
    }
    private Task RetryAsync() { _loadError = false; StateHasChanged(); return Task.CompletedTask; }
    private void HandleShow(string title, string? detail, string variant)
    {
        _delivery = InvokeAsync(async () => {
            if (_disposed) return;
            _queue.Enqueue((title, detail, variant));
            while (_queue.Count > 5) _queue.Dequeue();
            await DrainAsync();
            if (_loadError) StateHasChanged();
        });
    }
    private async Task DrainAsync()
    {
        if (_draining || _controller is null || _disposed) return;
        _draining = true;
        try
        {
            while (!_disposed && _queue.TryDequeue(out var item))
                await _controller.InvokeVoidAsync("show", item.Title, item.Detail, item.Variant, Duration);
        }
        catch (JSDisconnectedException) { }
        catch (JSException ex) { Console.Error.WriteLine($"CgToast deliver: {ex.Message}"); }
        finally { _draining = false; }
    }
    private static string GetVariantIcon(string variant) => variant switch {
        "success" => "mdiCheckCircleOutline", "warning" => "mdiAlertOutline", "error" => "mdiAlertCircleOutline", _ => "mdiInformationOutline"
    };
    public async ValueTask DisposeAsync()
    {
        _disposed = true; ToastService.OnShow -= HandleShow; _queue.Clear();
        try {
            await _delivery;
            if (_controller is not null) { await _controller.InvokeVoidAsync("dispose"); await _controller.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }
}
