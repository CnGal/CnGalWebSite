@* CgPieChart — 基于 Canvas 的环形图组件，通过 JS 模块渲染 *@
@inject IJSRuntime JsRuntime
@using Microsoft.JSInterop
@implements IAsyncDisposable

<cg-owned @ref="_root" class="cg-pie-chart @CssClass" style="@Style">
    @if (Chart.ErrorMessage is not null)
    {
        <CgAlert>@Chart.ErrorMessage</CgAlert><button type="button" data-cg-server-action @onclick="RetryAsync">重试</button>
    }

    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <div class="cg-pie-chart__header">
            <span class="cg-pie-chart__title">@Title</span>
        </div>
    }
    <div class="cg-pie-chart__body">
        <canvas @ref="_canvas" width="400" height="@Height" style="width: 100%; height: @(Height)px; max-height: @(Height)px;"></canvas>
    </div>
</cg-owned>

@code {
    private ElementReference _root, _canvas;
    private CanvasChartController? _chart;
    private CanvasChartController Chart => _chart ??= new(JsRuntime,
        "./_content/CnGalWebSite.MainSite.Shared/Components/DesignSystem/CgPieChart.razor.js");

    [Parameter]
    public string? Title { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<CgPieChartSlice>? Slices { get; set; }

    [Parameter]
    public int Height { get; set; } = 300;

    [Parameter]
    public double InnerRadius { get; set; } = 0.55;

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? Style { get; set; }

    protected override Task OnAfterRenderAsync(bool firstRender) => RenderChart();

    private async Task RetryAsync()
    {
        await Chart.RetryAsync();
        StateHasChanged();
    }

    private async Task RenderChart()
    {
        var slices = Slices ?? [];
        var data = slices.Select(s => new { name = s.Name, value = s.Value, color = s.Color }).ToList();

        if (await Chart.UpdateAsync(_root, _canvas, data, Title ?? "", InnerRadius)) StateHasChanged();
    }

    public Task RefreshAsync() => RenderChart();

    public ValueTask DisposeAsync() => _chart?.DisposeAsync() ?? ValueTask.CompletedTask;
}
