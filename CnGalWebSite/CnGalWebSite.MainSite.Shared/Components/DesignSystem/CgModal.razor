@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<cg-owned @ref="_root" style="display:contents">
    <dialog class="cg-modal-panel" style="@(Width is not null ? $"width:{Width};max-width:92vw" : null)" aria-label="@Title">
        @if (_renderContent && _loadError is null)
        {
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <header class="cg-modal-header"><h3>@Title</h3></header>
            }
            <div class="cg-modal-content">@ChildContent</div>
            @if (Footer is not null)
            {
                <footer class="cg-modal-footer">@Footer</footer>
            }
        }
    </dialog>
    @if (_loadError is not null && IsOpen)
    {
        <section class="cg-modal-fallback" aria-label="@Title">
            <CgAlert>@_loadError</CgAlert>
            <button type="button" data-cg-server-action @onclick="RetryAsync">重试弹层</button>
            <button type="button" data-cg-server-action @onclick="RequestClose">关闭</button>
            @ChildContent
            @Footer
        </section>
    }
</cg-owned>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Width { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private ElementReference _root;
    private IJSObjectReference? _module, _controller;
    private DotNetObjectReference<CgModal>? _callback;
    private bool _renderContent, _disposed;
    private string? _loadError;

    protected override void OnParametersSet() { if (IsOpen) _renderContent = true; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _loadError is not null || (!_renderContent && _controller is null)) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/CnGalWebSite.MainSite.Shared/Components/DesignSystem/CgModal.razor.js");
            if (_disposed) { await _module.DisposeAsync(); return; }
            _callback ??= DotNetObjectReference.Create(this);
            _controller ??= await _module.InvokeAsync<IJSObjectReference>("create", _root, _callback);
            if (_disposed) { await _controller.InvokeVoidAsync("dispose"); await _controller.DisposeAsync(); return; }
            await _controller.InvokeVoidAsync("setOpen", IsOpen);
            if (!IsOpen && _renderContent) { _renderContent = false; StateHasChanged(); }
        }
        catch (JSDisconnectedException) { }
        catch (JSException ex) { _loadError = "弹层加载失败，内容已在页面中显示"; Console.Error.WriteLine($"CgModal mount: {ex.Message}"); if (!_disposed) StateHasChanged(); }
    }

    private Task RetryAsync() { _loadError = null; StateHasChanged(); return Task.CompletedTask; }

    [JSInvokable] public Task RequestClose() => _disposed ? Task.CompletedTask : OnClose.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_controller is not null) { await _controller.InvokeVoidAsync("dispose"); await _controller.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        finally { _callback?.Dispose(); }
    }
}
