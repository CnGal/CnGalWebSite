@inject IJSRuntime JS
@inject IAccountQueryService AccountQueryService
@inject ILogger<CgHumanMachineVerification> Logger
@inject ICgToastService ToastService
@using CnGalWebSite.DataModel.ViewModel.Others
@using CnGalWebSite.SDK.MainSite.Abstractions
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable

<cg-owned @ref="_root" style="display:contents"></cg-owned>

@code {
    [Parameter]
    public EventCallback<HumanMachineVerificationResult> OnVerficated { get; set; }

    [Parameter]
    public bool WaitChecked { get; set; }

    private bool _isChecked, _running, _disposed;
    private ElementReference _root;
    private readonly CancellationTokenSource _lifetime = new();
    private TaskCompletionSource? _completion;
    private IJSObjectReference? _controller;
    private DotNetObjectReference<CgHumanMachineVerification>? _objRef;
    private IJSObjectReference? _module;

    private const string ModulePath = "./_content/CnGalWebSite.MainSite.Shared/Components/DesignSystem/CgHumanMachineVerification.razor.js";

    public async Task StartVerification()
    {
        if (_running || _disposed) return;
        _running = true;
        _completion = new(TaskCreationOptions.RunContinuationsAsynchronously);
        try
        {
            _isChecked = false;

            var result = await AccountQueryService.GetGeetestCodeAsync(_lifetime.Token);
            if (!result.Success || result.Data is null)
            {
                Logger.LogError("获取 Geetest 初始化参数失败：{Message}", result.Error?.Message);
                ToastService.Show("人机验证初始化失败", result.Error?.Message ?? "请稍后重试", "error");
                _running = false;
                await OnVerficated.InvokeAsync(new HumanMachineVerificationResult());
                return;
            }

            var geetestCode = result.Data;
            _objRef ??= DotNetObjectReference.Create(this);
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            if (_disposed) { await _module.DisposeAsync(); return; }
            _controller ??= await _module.InvokeAsync<IJSObjectReference>("create", _root, _objRef);
            if (_disposed) { await _controller.InvokeVoidAsync("dispose"); await _controller.DisposeAsync(); return; }
            await _controller.InvokeVoidAsync("start", geetestCode.Gt, geetestCode.Challenge, geetestCode.Success);
            if (WaitChecked) await _completion.Task.WaitAsync(_lifetime.Token);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }

        catch (Exception ex)
        {
            _running = false;
            Logger.LogError(ex, "初始化极验人机验证失败");
            ToastService.Show("人机验证初始化失败", "请稍后重试", "error");
            await OnVerficated.InvokeAsync(new HumanMachineVerificationResult());
        }
    }

    [JSInvokable]
    public async Task OnChecked(string challenge, string validate, string seccode)
    {
        if (_disposed || _isChecked) return;
        _isChecked = true;
        var completion = _completion;
        try
        {
            await OnVerficated.InvokeAsync(new HumanMachineVerificationResult
            {
                Success = true,
                Challenge = challenge,
                Validate = validate,
                Seccode = seccode
            });
        }
        finally
        {
            _running = false;
            completion?.TrySetResult();
        }
    }

    [JSInvokable]
    public async Task OnCancel()
    {
        if (_disposed || _isChecked) return;
        _isChecked = true;
        var completion = _completion;
        try { await OnVerficated.InvokeAsync(new HumanMachineVerificationResult()); }
        finally
        {
            _running = false;
            completion?.TrySetResult();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true; _lifetime.Cancel(); _completion?.TrySetCanceled();
        try
        {
            if (_controller is not null) { await _controller.InvokeVoidAsync("dispose"); await _controller.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        finally { _objRef?.Dispose(); }
    }
}
