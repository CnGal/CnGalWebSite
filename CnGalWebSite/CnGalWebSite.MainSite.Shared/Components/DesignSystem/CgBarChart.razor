@* CgBarChart — 基于 Canvas 的柱状图组件，通过 JS 模块渲染 *@
@inject IJSRuntime JsRuntime
@using Microsoft.JSInterop
@implements IAsyncDisposable

<cg-owned @ref="_root" class="cg-bar-chart @CssClass" style="@Style">
    @if (Chart.ErrorMessage is not null)
    {
        <CgAlert>@Chart.ErrorMessage</CgAlert><button type="button" @onclick="RetryAsync">重试</button>
    }

    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <div class="cg-bar-chart__header">
            <span class="cg-bar-chart__title">@Title</span>
        </div>
    }
    <div class="cg-bar-chart__body">
        <canvas @ref="_canvas" width="500" height="@Height" style="width: 100%; height: @(Height)px; max-height: @(Height)px;"></canvas>
    </div>
</cg-owned>

@code {
    private ElementReference _root, _canvas;
    private CanvasChartController? _chart;
    private CanvasChartController Chart => _chart ??= new(JsRuntime,
        "./_content/CnGalWebSite.MainSite.Shared/Components/DesignSystem/CgBarChart.razor.js");

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public IReadOnlyList<string>? Labels { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<CgBarChartSeries>? Series { get; set; }

    [Parameter]
    public int Height { get; set; } = 250;

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? Style { get; set; }

    protected override Task OnAfterRenderAsync(bool firstRender) => RenderChart();

    private async Task RetryAsync()
    {
        await Chart.RetryAsync();
        StateHasChanged();
    }

    private async Task RenderChart()
    {
        var labels = Labels ?? [];
        var datasets = (Series ?? []).Select(s => new { label = s.Name, data = s.Data, color = s.Color }).ToList();

        if (await Chart.UpdateAsync(_root, _canvas, labels, datasets, Title ?? "")) StateHasChanged();
    }

    public Task RefreshAsync() => RenderChart();

    public ValueTask DisposeAsync() => _chart?.DisposeAsync() ?? ValueTask.CompletedTask;
}
