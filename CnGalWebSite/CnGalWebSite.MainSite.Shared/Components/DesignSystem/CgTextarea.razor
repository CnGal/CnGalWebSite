<textarea @key="_textareaKey"
          class="cg-textarea @(Monospace ? "cg-textarea--mono" : string.Empty)"
          rows="@Rows"
          disabled="@Disabled"
          placeholder="@Placeholder"
          data-cg-ime-input="true"
          value="@Value"
          @oncginputcommit="OnInputAsync"></textarea>

@code {
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public int Rows { get; set; } = 3;

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// 是否使用等宽字体（适合代码/HTML 输入）
    /// </summary>
    [Parameter]
    public bool Monospace { get; set; }

    private int _textareaKey;
    private string? _lastUserInput;

    protected override void OnParametersSet()
    {
        // 正常输入时以浏览器当前值为准；仅当父组件主动替换或规范化值时，
        // 才重建元素并同步外部值，避免 Server 回写旧值导致光标跳动。
        if (_lastUserInput is not null && Value != _lastUserInput)
        {
            _textareaKey++;
            _lastUserInput = null;
        }
    }

    private Task OnInputAsync(ChangeEventArgs args)
    {
        _lastUserInput = args.Value?.ToString() ?? string.Empty;
        return ValueChanged.InvokeAsync(_lastUserInput);
    }
}
