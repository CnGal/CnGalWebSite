@using CnGalWebSite.MainSite.Shared.Services.Editing
@inject IJSRuntime JS
@page "/articles/create"
@page "/articles/edit/{Id:long}"

@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@using CnGalWebSite.DataModel.ViewModel.Articles
@using CnGalWebSite.MainSite.Shared.Components.Features.Article.Editor
@using CnGalWebSite.MainSite.Shared.Services
@using CnGalWebSite.SDK.MainSite.Abstractions
@using CnGalWebSite.SDK.MainSite.Models
@using CnGalWebSite.SDK.MainSite.Models.ArticleEdit
@using System.Text.Json
@inject IArticleCommandService ArticleCommandService
@inject NavigationManager NavigationManager
@inject ILocalStorageService LocalStorage
@inject ICgToastService ToastService
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IAsyncDisposable

<CgPageMeta Title="@(Session.IsCreate ? "发表文章" : "编辑文章")" />

@if (Session.IsLoading)
{
    <section class="article-edit-loading" aria-label="加载中">
        <div class="article-edit-loading-spinner"></div>
        <p>正在获取数据...</p>
    </section>
}
else if (Session.LoadErrorMessage != null)
{
    <section class="article-edit-error">
        <h1>加载失败</h1>
        <p>@Session.LoadErrorMessage</p>
        <CgButton Variant="primary" OnClick="Session.LoadDataAsync">重试</CgButton>
    </section>
}
else if (Session.Model != null)
{
    <article class="article-edit-page" @ref="_editRoot" data-cg-edit-root>
        <div class="article-edit-layout">
            <ArticleEditorSidebar IsCreate="Session.IsCreate"
                                  IsSubmitting="Session.IsSubmitting"
                                  HasDraftRecovered="Session.HasDraftRecovered"
                                  OnDiscardDraft="Session.DiscardDraft"
                                  OnSubmit="Session.SubmitAsync"
                                  OnCancel="Session.Cancel" />

            <main class="article-edit-main">
                <ArticleMainEditor Model="Session.Model.Data.Main" MainPageModel="Session.Model.Data.MainPage" IsAdmin="Session.IsAdmin"
                                   OnTypeChangedCallback="StateHasChanged" />
                <ArticleSupplementaryEditor Model="Session.Model.Data.Main" IsAdmin="Session.IsAdmin" />
                <ArticleRelevancesEditor Model="Session.Model.Data.Relevances" MetaOptions="Session.Model.MetaOptions" />
            </main>
        </div>

    </article>
}

@code {
    [Parameter] public long? Id { get; set; }

    private EditSessionHost<ArticleEditSession>? _sessions;
    private ArticleEditSession Session => _sessions!.Current;
    private ElementReference _editRoot;
    protected override Task OnParametersSetAsync()
    {
        _sessions ??= new(() => InvokeAsync(StateHasChanged));
        return _sessions.SetAsync($"{Id}", () =>
        {
            var session = new ArticleEditSession(ArticleCommandService, NavigationManager, LocalStorage, ToastService, AuthenticationStateProvider) { Id = Id };
            session.Draft.Dispatch = work => InvokeAsync(work);
            session.Draft.FlushInputs = () => CgMarkdownEditor.FlushAllAsync(JS, _editRoot);
            return session;
        });
    }

    public ValueTask DisposeAsync() => _sessions?.DisposeAsync() ?? ValueTask.CompletedTask;

}
