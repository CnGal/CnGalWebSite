@page "/home/editrecord"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using CnGalWebSite.DataModel.ViewModel.Home
@using CnGalWebSite.DataModel.ViewModel.Admin
@using CnGalWebSite.SDK.MainSite.Models
@using CnGalWebSite.MainSite.Shared.Components.Features.Examine
@inject IExamineQueryService ExamineQueryService
@implements IDisposable

<CgPageMeta Title="编辑记录" />
<div class="edit-record-page">
    <header class="edit-record-page__header">
        <h1><CgMdiIcon Name="mdiHistory" aria-hidden="true" />编辑记录</h1>
    </header>
    @if (_isLoading)
    { <div class="edit-record-page__state" role="status"><CgProgressRing /><span>正在加载编辑记录…</span></div> }
    else if (_pageError is not null)
    {
        <div class="edit-record-page__state" role="alert"><p>@_pageError</p><CgButton OnClick="LoadDataAsync">重试</CgButton><a href="/">返回首页</a></div>
    }
    else if (_overview is not null)
    {
        <RecordObjectSummary Type="_overview.Type" ObjectId="_overview.ObjectId" Name="@_overview.ObjectName"
            Description="@_overview.ObjectBriefIntroduction" Image="@_overview.Image" IsThumbnail="_overview.IsThumbnail" />
        @if (_overview.Examines.Count == 0)
        { <div class="edit-record-page__state">此对象暂无已通过的编辑记录。</div> }
        else
        {
            <div class="edit-record-page__body">
                <aside class="edit-record-page__sidebar" aria-label="历史记录导航">
                    <div class="edit-record-page__records @(_recordsOpen ? "is-open" : "")">
                        <div class="edit-record-page__records-heading"><strong>编辑记录 · @_overview.Examines.Count</strong><span>@SelectionSummary</span></div>
                        <button class="edit-record-page__records-toggle" type="button" aria-expanded="@(_recordsOpen ? "true" : "false")" aria-controls="edit-record-navigation" @onclick="() => _recordsOpen = !_recordsOpen">
                            <strong>编辑记录 · @_overview.Examines.Count</strong><span>@SelectionSummary</span><span class="edit-record-page__expand">@(_recordsOpen ? "收起记录" : "展开记录")</span>
                        </button>
                        <div id="edit-record-navigation" class="edit-record-page__record-list">
                            <EditRecordTimeline Items="_overview.Examines" SelectedId="_selectedId" ContrastId="ContrastId" CurrentId="_currentId" />
                        </div>
                    </div>
                </aside>
                <div class="edit-record-page__main">
                    <nav class="edit-record-page__modes" aria-label="记录查看方式">
                        <a class="@(!IsCompare ? "is-active" : "")" href="@ModeUrl(false)" aria-current="@(!IsCompare ? "page" : null)">该次修改</a>
                        <a class="@(IsCompare ? "is-active" : "")" href="@ModeUrl(true)" aria-current="@(IsCompare ? "page" : null)">历史版本对比</a>
                    </nav>
                    @if (IsCompare)
                    {
                        <EditRecordContrastPanel ExamineOptions="Options" ContrastId="ContrastId" CurrentId="_currentId" SelectedId="_selectedId" />
                    }
                    else if (_selectedRecord is not null)
                    { <EditRecordDetail Model="_selectedRecord" /> }

                    @if (_contentLoading)
                    { <div class="edit-record-page__state" role="status"><CgProgressRing /><span>@(IsCompare ? "正在重建历史版本…" : "正在加载记录内容…")</span></div> }
                    else if (_contentNotice is not null)
                    { <p class="edit-record-page__notice" role="status">@_contentNotice</p> }
                    else if (_contentError is not null)
                    { <div class="edit-record-page__notice" role="alert"><p>@_contentError</p><CgButton Variant="secondary" OnClick="LoadDataAsync">重试</CgButton></div> }
                    else if (IsCompare && _comparison is not null)
                    {
                        <div class="edit-record-page__comparison-heading"><h2>版本 #@_comparison.ContrastId → #@_comparison.CurrentId</h2></div>
                        <RecordContentComparison Before="_comparison.Before" After="_comparison.After"
                            BeforeTitle="@($"基准版本 #{_comparison.ContrastId}")" AfterTitle="@($"目标版本 #{_comparison.CurrentId}")"
                            />
                    }
                    else if (!IsCompare && _record is not null)
                    { <ReviewContent Model="_record" /><RecordNotes Comments="@_record.Comments" Note="@_record.Note" ShowEmpty="true" /> }
                </div>
            </div>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "ContrastId"), Parameter] public string? ContrastIdQuery { get; set; }
    [SupplyParameterFromQuery(Name = "CurrentId"), Parameter] public string? CurrentIdQuery { get; set; }
    [SupplyParameterFromQuery(Name = "SelectedId"), Parameter] public string? SelectedIdQuery { get; set; }
    private long ContrastId => long.TryParse(ContrastIdQuery, out var id) ? id : 0;
    private long? CurrentId => CurrentIdQuery is null ? null : long.TryParse(CurrentIdQuery, out var id) ? id : -1;
    private long SelectedId => SelectedIdQuery is null ? 0 : long.TryParse(SelectedIdQuery, out var id) ? id : -1;
    [SupplyParameterFromQuery, Parameter] public string? Mode { get; set; }

    private ExaminesOverviewViewModel? _overview;
    private EditRecordAloneViewModel? _selectedRecord;
    private ExamineViewModel? _record;
    private EditRecordComparison? _comparison;
    private long _selectedId;
    private long _currentId;
    private bool _isLoading = true;
    private bool _recordsOpen;
    private string SelectionSummary => _selectedRecord is null ? "选择记录" : $"已选 #{_selectedRecord.Id} · {_selectedRecord.UserName}";
    private bool _contentLoading;
    private string? _pageError;
    private string? _contentError;
    private string? _contentNotice;
    private CancellationTokenSource? _cts;
    private bool _disposed;
    private bool IsCompare => RecordPresentation.IsCompareMode(Mode, CurrentId);
    private IEnumerable<KeyValuePair<string, string>> Options => (_overview?.Examines ?? []).OrderByDescending(e => e.PassedTime).ThenByDescending(e => e.Id)
        .Select(e => new KeyValuePair<string, string>(e.Id.ToString(), $"#{e.Id} · {e.Operation.GetDisplayName()} · {e.ApplyTime:yyyy-MM-dd HH:mm}"));

    protected override Task OnParametersSetAsync() => LoadDataAsync();

    private async Task LoadDataAsync()
    {
        if (_disposed) return;
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new();
        var token = _cts.Token;
        var contrastId = ContrastId;
        var selectedId = SelectedId;
        var currentId = CurrentId;
        var compare = IsCompare;
        _pageError = _contentError = _contentNotice = null;
        _recordsOpen = false;
        _record = null;
        _comparison = null;
        _selectedRecord = null;
        _contentLoading = false;
        _isLoading = _overview is null || !_overview.Examines.Any(e => e.Id == contrastId);
        if (contrastId <= 0)
        {
            _pageError = "请提供有效的编辑记录 ID。";
            _isLoading = false;
            return;
        }
        try
        {
            if (_isLoading)
            {
                var result = await ExamineQueryService.GetExaminesOverviewAsync(contrastId, token);
                if (_disposed || token.IsCancellationRequested) return;
                if (!result.Success || result.Data is null)
                {
                    _overview = null;
                    _pageError = result.Error?.Message ?? "无法加载编辑记录。";
                    return;
                }
                _overview = result.Data;
            }
            _isLoading = false;
            _selectedId = selectedId > 0 ? selectedId : contrastId;
            _selectedRecord = _overview!.Examines.FirstOrDefault(e => e.Id == _selectedId);
            _currentId = currentId is null or 0 ? _overview.Examines.OrderBy(e => e.PassedTime).ThenBy(e => e.Id).LastOrDefault()?.Id ?? contrastId : currentId.Value;
            if (_overview.Examines.Count == 0) return;
            if (_selectedRecord is null || selectedId < 0)
            {
                _contentError = "选中的记录不属于此对象或已不可用，请重新选择左侧记录。";
                return;
            }
            if (compare && contrastId == _currentId)
            {
                _contentNotice = "两个版本相同。";
                return;
            }
            if (compare && (IsReversed(_overview.Examines, contrastId, _currentId) || !_overview.Examines.Any(e => e.Id == contrastId)
                || !_overview.Examines.Any(e => e.Id == _currentId)))
            {
                _contentError = "请选择同一对象的已通过版本，且基准版本不能晚于目标版本。";
                return;
            }
            _contentLoading = true;
            StateHasChanged();
            if (compare)
            {
                var result = await ExamineQueryService.GetEditRecordComparisonAsync(_overview.Type, contrastId, _currentId, token);
                if (_disposed || token.IsCancellationRequested) return;
                if (result.Success && result.Data is not null) _comparison = result.Data;
                else _contentError = result.Error?.Message ?? "历史版本对比加载失败。";
            }
            else
            {
                var result = await ExamineQueryService.GetExamineDetailAsync(_selectedId, token);
                if (_disposed || token.IsCancellationRequested) return;
                if (result.Success && result.Data is not null) _record = result.Data;
                else _contentError = result.Error?.Message ?? "记录内容加载失败，请重试。";
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        finally
        {
            if (!_disposed && !token.IsCancellationRequested) { _isLoading = false; _contentLoading = false; }
        }
    }

    private static bool IsReversed(List<EditRecordAloneViewModel> records, long before, long after)
    {
        var ordered = records.OrderBy(r => r.PassedTime).ThenBy(r => r.Id).Select(r => r.Id).ToList();
        return ordered.IndexOf(before) > ordered.IndexOf(after);
    }

    private string ModeUrl(bool compare) => compare
        ? $"/home/editrecord?ContrastId={_selectedId}&CurrentId=0&SelectedId={_selectedId}&Mode=compare"
        : $"/home/editrecord?ContrastId={ContrastId}&SelectedId={_selectedId}&Mode=record";

    public void Dispose()
    {
        _disposed = true;
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
