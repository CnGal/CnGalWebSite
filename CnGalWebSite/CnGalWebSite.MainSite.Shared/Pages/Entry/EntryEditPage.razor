@using CnGalWebSite.MainSite.Shared.Services.Editing
@inject IJSRuntime JS
@page "/entries/establish"
@page "/entries/create"
@page "/entries/edit/{Id:int}"

@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@using CnGalWebSite.DataModel.Model
@using CnGalWebSite.MainSite.Shared.Components.Features.Entry.Editor
@using CnGalWebSite.MainSite.Shared.Services
@using CnGalWebSite.SDK.MainSite.Abstractions
@using CnGalWebSite.SDK.MainSite.Models
@using System.Text.Json
@using CnGalWebSite.SDK.MainSite.Models.EntryEdit
@using CnGalWebSite.DataModel.ViewModel
@inject IEntryCommandService EntryCommandService
@inject ITagQueryService TagQueryService
@inject NavigationManager NavigationManager
@inject ILocalStorageService LocalStorage
@inject ICgToastService ToastService
@implements IAsyncDisposable

<CgPageMeta Title="@(Session.IsCreate ? "创建词条" : "编辑词条")" />

@if (Session.IsLoading)
{
    <section class="entry-edit-loading" aria-label="加载中">
        <div class="entry-edit-loading-spinner"></div>
        <p>正在获取数据...</p>
    </section>
}
else if (Session.LoadErrorMessage != null)
{
    <section class="entry-edit-error">
        <h1>加载失败</h1>
        <p>@Session.LoadErrorMessage</p>
        <CgButton Variant="primary" OnClick="Session.LoadDataAsync">重试</CgButton>
    </section>
}
else if (Session.Model != null)
{
    <article class="entry-edit-page" @ref="_editRoot" data-cg-edit-root>
        <div class="entry-edit-layout">
            <EntryEditorSidebar IsCreate="Session.IsCreate"
                                IsSubmitting="Session.IsSubmitting"
                                HasDraftRecovered="Session.HasDraftRecovered"
                                EntryType="Session.Model.Data.Main.Type"
                                Model="Session.Model.Data"
                                OnModelChanged="OnSteamImportCompleted"
                                OnDiscardDraft="Session.DiscardDraft"
                                OnSubmit="Session.SubmitAsync"
                                OnCancel="Session.Cancel" />

            <main class="entry-edit-main">
                <EntryMainEditor Model="Session.Model.Data.Main" TypeChanged="OnTypeChanged" />
                <EntryAddInforEditor @ref="_addInforEditorRef" Model="Session.Model.Data.AddInfor" MetaOptions="Session.Model.MetaOptions" />
                <EntryImagesEditor Model="Session.Model.Data.Images" />
                <EntryMainPageEditor Model="Session.Model.Data.MainPage" />
                <EntryRelevancesEditor Model="Session.Model.Data.Relevances" MetaOptions="Session.Model.MetaOptions" />
                <EntryTagsEditor Model="Session.Model.Data.Tags" MetaOptions="Session.Model.MetaOptions" />
                <EntryAudioEditor Model="Session.Model.Data.Audio" />
                <EntryWebsiteEditor Model="Session.Model.Data.Website" />
            </main>
        </div>

    </article>
}

@code {
    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery] public string? Type { get; set; }
    private EditSessionHost<EntryEditSession>? _sessions;
    private EntryEditSession Session => _sessions!.Current;
    private ElementReference _editRoot;
    private EntryAddInforEditor? _addInforEditorRef;
    protected override Task OnParametersSetAsync()
    {
        _sessions ??= new(() => InvokeAsync(StateHasChanged));
        return _sessions.SetAsync($"{Id}:{Type}", () =>
        {
            var session = new EntryEditSession(EntryCommandService, TagQueryService, NavigationManager, LocalStorage, ToastService) { Id = Id, Type = Type };
            session.Draft.Dispatch = work => InvokeAsync(work);
            session.Draft.FlushInputs = () => CgMarkdownEditor.FlushAllAsync(JS, _editRoot);
            return session;
        });
    }

    public ValueTask DisposeAsync() => _sessions?.DisposeAsync() ?? ValueTask.CompletedTask;

    private async Task OnTypeChanged(EntryType newType)
    {
        if (Session.Model != null)
        {
            Session.Model.Data.Type = newType;
            Session.Model.Data.Main.Type = newType;
            Session.Model.Data.AddInfor.Type = newType;
            Session.Model.Data.Relevances.Type = newType;

            if (_addInforEditorRef != null)
            {
                await _addInforEditorRef.RefreshInformationsAsync(newType);
            }
        }
    }

    private async Task OnSteamImportCompleted()
    {
        if (Session.Model?.Data != null)
        {
            Session.Model.Data.AddInfor.Releases = [.. Session.Model.Data.AddInfor.Releases];
            Session.Model.Data.Images.Images = [.. Session.Model.Data.Images.Images];
        }

        await InvokeAsync(StateHasChanged);
    }

}
