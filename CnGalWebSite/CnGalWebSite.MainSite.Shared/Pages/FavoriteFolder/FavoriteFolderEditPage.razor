@using CnGalWebSite.MainSite.Shared.Services.Editing
@page "/favoritefolders/edit/{Id:long}"
@page "/favoritefolders/create"

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CnGalWebSite.DataModel.Model
@using CnGalWebSite.DataModel.ViewModel.Favorites
@using CnGalWebSite.SDK.MainSite.Abstractions
@using CnGalWebSite.SDK.MainSite.Models
@using CnGalWebSite.MainSite.Shared.Components.DesignSystem
@using CnGalWebSite.MainSite.Shared.Components.Features.FavoriteFolder
@using CnGalWebSite.MainSite.Shared.Services
@using Microsoft.JSInterop
@using CnGalWebSite.SDK.MainSite.Models.Files

@inject IFavoriteFolderQueryService FavoriteFolderQueryService
@inject IFavoriteFolderCommandService FavoriteFolderCommandService
@inject NavigationManager NavigationManager
@inject ICgToastService ToastService

@implements IAsyncDisposable

<CgPageMeta Title="@(Session.IsCreateMode ? "创建收藏夹" : "编辑收藏夹")" />

@if (Session.IsLoading)
{
    <section class="cg-ff-edit-loading" aria-label="加载中">
        <div class="cg-ff-edit-loading-spinner"></div>
        <p>正在获取数据...</p>
    </section>
}
else if (Session.ErrorMessage is not null)
{
    <section class="cg-ff-edit-error">
        <h1>加载失败</h1>
        <p>@Session.ErrorMessage</p>
        <CgButton Variant="primary" OnClick="@(() => NavigationManager.NavigateTo("/"))">返回首页</CgButton>
    </section>
}
else
{
    <article class="cg-ff-edit-page">
        <div class="cg-ff-edit-layout">
            <CgEditSidebar Class="cg-ff-edit-sidebar" Items="GetNavItems()"
                           IsCreate="Session.IsCreateMode" IsSubmitting="Session.IsSaving"
                           HeaderIcon="mdiHeartMultiple" Hint="完成后点击保存" BusyText="保存中..."
                           SubmitText="@(Session.IsCreateMode ? "创建" : "保存")"
                           ShowSpinner="false" DisableCancelWhileSubmitting="false"
                           OnSubmit="Session.SubmitAsync" OnCancel="Session.Cancel" />

            <main class="cg-ff-edit-main">
                <section id="basic-info" class="cg-ff-edit-section">
                    <h2>
                        <CgMdiIcon Name="mdiTextBoxOutline" aria-hidden="true" />
                        基本信息
                    </h2>

                    <CgFormGroup Label="名称">
                        <CgInput @bind-Value="Session.Name" Placeholder="请输入收藏夹名称" />
                    </CgFormGroup>

                    <CgFormGroup Label="简介">
                        <CgTextarea @bind-Value="Session.BriefIntroduction" Placeholder="请输入收藏夹简介" />
                    </CgFormGroup>

                    <CgFormGroup Label="主图">
                        <CgImageUpload @bind-Value="Session.MainImage"
                                       Text="上传主图"
                                       ShowCropper
                                       Type="ImageAspectType._16_9" />
                    </CgFormGroup>

                    <div class="cg-ff-edit-checkboxes">
                        <CgCheckbox Label="默认收藏夹" @bind-Value="Session.IsDefault" />
                        <CgCheckbox Label="向他人公开" @bind-Value="Session.ShowPublicly" />
                        <CgCheckbox Label="不展示在个人主页中" @bind-Value="Session.IsHidden" />
                    </div>
                </section>

                @if (!Session.IsCreateMode)
                {
                    <section id="manage-objects" class="cg-ff-edit-section">
                        <h2>
                            <CgMdiIcon Name="mdiFormatListBulleted" aria-hidden="true" />
                            管理收藏
                        </h2>
                        <FavoriteFolderObjectManager FolderId="Id" />
                    </section>
                }
            </main>
        </div>
    </article>
}

@code {
    [Parameter] public long Id { get; set; }
    private EditSessionHost<FavoriteFolderEditSession>? _sessions;
    private FavoriteFolderEditSession Session => _sessions!.Current;
    protected override Task OnParametersSetAsync()
    {
        _sessions ??= new(() => InvokeAsync(StateHasChanged));
        return _sessions.SetAsync($"{Id}", () => new FavoriteFolderEditSession(Id, FavoriteFolderQueryService, FavoriteFolderCommandService, NavigationManager, ToastService));
    }

    public ValueTask DisposeAsync() => _sessions?.DisposeAsync() ?? ValueTask.CompletedTask;
    private CgEditNavItem[] GetNavItems() => Session.IsCreateMode
        ? [new("basic-info", "基本信息", "mdiTextBoxOutline")]
        : [new("basic-info", "基本信息", "mdiTextBoxOutline"), new("manage-objects", "管理收藏", "mdiFormatListBulleted")];
}