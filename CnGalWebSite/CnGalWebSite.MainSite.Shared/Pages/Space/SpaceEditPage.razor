@using CnGalWebSite.MainSite.Shared.Services.Editing
@inject IJSRuntime JS
@page "/space/edit"

@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@using CnGalWebSite.DataModel.ViewModel.Space
@using CnGalWebSite.MainSite.Shared.Components.Features.Space.Editor
@using CnGalWebSite.MainSite.Shared.Services
@using CnGalWebSite.SDK.MainSite.Abstractions
@using CnGalWebSite.SDK.MainSite.Models
@using CnGalWebSite.SDK.MainSite.Models.SpaceEdit
@using System.Text.Json
@inject ISpaceCommandService SpaceCommandService
@inject NavigationManager NavigationManager
@inject ILocalStorageService LocalStorage
@inject ICgToastService ToastService
@implements IAsyncDisposable

<CgPageMeta Title="编辑个人空间" />

@if (Session.IsLoading)
{
    <section class="space-edit-loading" aria-label="加载中">
        <div class="space-edit-loading-spinner"></div>
        <p>正在获取数据...</p>
    </section>
}
else if (Session.LoadErrorMessage != null)
{
    <section class="space-edit-error">
        <h1>加载失败</h1>
        <p>@Session.LoadErrorMessage</p>
        <CgButton Variant="primary" OnClick="Session.LoadDataAsync">重试</CgButton>
    </section>
}
else if (Session.Model != null)
{
    <article class="space-edit-page" @ref="_editRoot" data-cg-edit-root>
        <div class="space-edit-layout">
            <SpaceEditorSidebar IsSubmitting="Session.IsSubmitting"
                                HasDraftRecovered="Session.HasDraftRecovered"
                                OnDiscardDraft="Session.DiscardDraft"
                                OnSubmit="Session.SubmitAsync"
                                OnCancel="Session.Cancel" />

            <main class="space-edit-main">
                <SpaceProfileEditor Model="Session.Model.UserData" />
                <SpaceAccountEditor Model="Session.Model.UserData" />
                <SpacePrivacyEditor Model="Session.Model.UserData" />
                <SpaceMainPageEditor Model="Session.Model.MainPage" />
            </main>
        </div>

    </article>
}

@code {

    private EditSessionHost<SpaceEditSession>? _sessions;
    private SpaceEditSession Session => _sessions!.Current;
    private ElementReference _editRoot;
    protected override Task OnParametersSetAsync()
    {
        _sessions ??= new(() => InvokeAsync(StateHasChanged));
        return _sessions.SetAsync("space", () =>
        {
            var session = new SpaceEditSession(SpaceCommandService, NavigationManager, LocalStorage, ToastService);
            session.Draft.Dispatch = work => InvokeAsync(work);
            session.Draft.FlushInputs = () => CgMarkdownEditor.FlushAllAsync(JS, _editRoot);
            return session;
        });
    }

    public ValueTask DisposeAsync() => _sessions?.DisposeAsync() ?? ValueTask.CompletedTask;

}
