@using CnGalWebSite.MainSite.Shared.Services.Editing
@inject IJSRuntime JS
@page "/videos/create"
@page "/videos/edit/{Id:long}"

@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@using CnGalWebSite.DataModel.ViewModel.Videos
@using CnGalWebSite.MainSite.Shared.Components.Features.Video.Editor
@using CnGalWebSite.MainSite.Shared.Services
@using CnGalWebSite.SDK.MainSite.Abstractions
@using CnGalWebSite.SDK.MainSite.Models
@using CnGalWebSite.SDK.MainSite.Models.VideoEdit
@using System.Text.Json
@inject IVideoCommandService VideoCommandService
@inject NavigationManager NavigationManager
@inject ILocalStorageService LocalStorage
@inject ICgToastService ToastService
@implements IAsyncDisposable

<CgPageMeta Title="@(Session.IsCreate ? "发布视频" : "编辑视频")" />

@if (Session.IsLoading)
{
    <section class="video-edit-loading" aria-label="加载中">
        <div class="video-edit-loading-spinner"></div>
        <p>正在获取数据...</p>
    </section>
}
else if (Session.LoadErrorMessage != null)
{
    <section class="video-edit-error">
        <h1>加载失败</h1>
        <p>@Session.LoadErrorMessage</p>
        <CgButton Variant="primary" OnClick="Session.LoadDataAsync">重试</CgButton>
    </section>
}
else if (Session.Model != null)
{
    <article class="video-edit-page" @ref="_editRoot" data-cg-edit-root>
        <div class="video-edit-layout">
            <VideoEditorSidebar IsCreate="Session.IsCreate"
                                IsSubmitting="Session.IsSubmitting"
                                HasDraftRecovered="Session.HasDraftRecovered"
                                OnDiscardDraft="Session.DiscardDraft"
                                OnSubmit="Session.SubmitAsync"
                                OnCancel="Session.Cancel" />

            <main class="video-edit-main">
                <VideoMainEditor Model="Session.Model.Data.Main" />
                <VideoImagesEditor Model="Session.Model.Data.Images" />
                <VideoRelevancesEditor Model="Session.Model.Data.Relevances" MetaOptions="Session.Model.MetaOptions" />
                <VideoMainPageEditor Model="Session.Model.Data.MainPage" />
            </main>
        </div>

    </article>
}

@code {
    [Parameter] public long? Id { get; set; }

    private EditSessionHost<VideoEditSession>? _sessions;
    private VideoEditSession Session => _sessions!.Current;
    private ElementReference _editRoot;
    protected override Task OnParametersSetAsync()
    {
        _sessions ??= new(() => InvokeAsync(StateHasChanged));
        return _sessions.SetAsync($"{Id}", () =>
        {
            var session = new VideoEditSession(VideoCommandService, NavigationManager, LocalStorage, ToastService) { Id = Id };
            session.Draft.Dispatch = work => InvokeAsync(work);
            session.Draft.FlushInputs = () => CgMarkdownEditor.FlushAllAsync(JS, _editRoot);
            return session;
        });
    }

    public ValueTask DisposeAsync() => _sessions?.DisposeAsync() ?? ValueTask.CompletedTask;

}
