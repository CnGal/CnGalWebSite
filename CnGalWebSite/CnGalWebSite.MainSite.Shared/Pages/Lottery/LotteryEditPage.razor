@using CnGalWebSite.MainSite.Shared.Services.Editing
@inject IJSRuntime JS
@page "/lotteries/createlottery"
@page "/lotteries/editlottery/{Id:long}"

@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using CnGalWebSite.DataModel.ViewModel.Lotteries
@using CnGalWebSite.MainSite.Shared.Components.Features.Lottery.Editor
@using CnGalWebSite.SDK.MainSite.Models
@using System.Text.Json
@inject ILotteryCommandService LotteryCommandService
@inject NavigationManager NavigationManager
@inject ILocalStorageService LocalStorage
@inject ICgToastService ToastService
@implements IAsyncDisposable

<CgPageMeta Title="@(Session.IsCreate ? "创建抽奖" : "编辑抽奖")" />

@if (Session.IsLoading)
{
    <section class="lottery-edit-loading" aria-label="加载中">
        <div class="lottery-edit-loading-spinner"></div>
        <p>正在获取数据...</p>
    </section>
}
else if (Session.LoadErrorMessage != null)
{
    <section class="lottery-edit-error">
        <h1>加载失败</h1>
        <p>@Session.LoadErrorMessage</p>
        <CgButton Variant="primary" OnClick="Session.LoadDataAsync">重试</CgButton>
    </section>
}
else if (Session.Model != null)
{
    <article class="lottery-edit-page" @ref="_editRoot" data-cg-edit-root>
        <div class="lottery-edit-layout">
            <LotteryEditorSidebar IsCreate="Session.IsCreate"
                                  IsSubmitting="Session.IsSubmitting"
                                  HasDraftRecovered="Session.HasDraftRecovered"
                                  OnDiscardDraft="Session.DiscardDraft"
                                  OnSubmit="Session.SubmitAsync"
                                  OnCancel="Session.Cancel" />

            <main class="lottery-edit-main">
                <LotteryMainEditor Model="Session.Model" EntryGameItems="Session.EntryGameItems" />
                <LotteryIntroEditor Model="Session.Model" />
                <LotteryAwardsEditor Model="Session.Model" ToastService="ToastService" />
            </main>
        </div>

    </article>
}

@code {
    [Parameter] public long? Id { get; set; }

    private EditSessionHost<LotteryEditSession>? _sessions;
    private LotteryEditSession Session => _sessions!.Current;
    private ElementReference _editRoot;
    protected override Task OnParametersSetAsync()
    {
        _sessions ??= new(() => InvokeAsync(StateHasChanged));
        return _sessions.SetAsync($"{Id}", () =>
        {
            var session = new LotteryEditSession(LotteryCommandService, NavigationManager, LocalStorage, ToastService) { Id = Id };
            session.Draft.Dispatch = work => InvokeAsync(work);
            session.Draft.FlushInputs = () => CgMarkdownEditor.FlushAllAsync(JS, _editRoot);
            return session;
        });
    }

    public ValueTask DisposeAsync() => _sessions?.DisposeAsync() ?? ValueTask.CompletedTask;

}
