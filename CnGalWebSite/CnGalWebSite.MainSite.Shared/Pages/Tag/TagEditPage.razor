@using CnGalWebSite.MainSite.Shared.Services.Editing
@inject IJSRuntime JS
@page "/tags/create"
@page "/tags/createtag"
@page "/tags/edit/{Id:int}"

@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@using CnGalWebSite.DataModel.ViewModel.Tags
@using CnGalWebSite.MainSite.Shared.Components.Features.Tag.Editor
@using CnGalWebSite.MainSite.Shared.Services
@using CnGalWebSite.SDK.MainSite.Abstractions
@using CnGalWebSite.SDK.MainSite.Models
@using CnGalWebSite.SDK.MainSite.Models.TagEdit
@using System.Text.Json
@inject ITagCommandService TagCommandService
@inject ITagQueryService TagQueryService
@inject NavigationManager NavigationManager
@inject ILocalStorageService LocalStorage
@inject ICgToastService ToastService
@implements IAsyncDisposable

<CgPageMeta Title="@(Session.IsCreate ? "创建标签" : "编辑标签")" />

@if (Session.IsLoading)
{
    <section class="tag-edit-loading" aria-label="加载中">
        <div class="tag-edit-loading-spinner"></div>
        <p>正在获取数据...</p>
    </section>
}
else if (Session.LoadErrorMessage != null)
{
    <section class="tag-edit-error">
        <h1>加载失败</h1>
        <p>@Session.LoadErrorMessage</p>
        <CgButton Variant="primary" OnClick="Session.LoadDataAsync">重试</CgButton>
    </section>
}
else if (Session.Model != null)
{
    <article class="tag-edit-page" @ref="_editRoot" data-cg-edit-root>
        <div class="tag-edit-layout">
            <TagEditorSidebar IsCreate="Session.IsCreate"
                              IsSubmitting="Session.IsSubmitting"
                              HasDraftRecovered="Session.HasDraftRecovered"
                              OnDiscardDraft="Session.DiscardDraft"
                              OnSubmit="Session.SubmitAsync"
                              OnCancel="Session.Cancel" />

            <main class="tag-edit-main">
                <TagMainEditor Model="Session.Model.Data.Main" TagItems="Session.Model.MetaOptions.TagItems" />
                <TagChildEntriesEditor Model="Session.Model.Data.Entries" EntryItems="Session.Model.MetaOptions.EntryItems" />
                <TagChildTagsEditor Model="Session.Model.Data.Tags" TagItems="Session.Model.MetaOptions.TagItems" TagTreeItems="Session.Model.MetaOptions.TagTreeItems" />
            </main>
        </div>

    </article>
}

@code {
    [Parameter] public int? Id { get; set; }

    private EditSessionHost<TagEditSession>? _sessions;
    private TagEditSession Session => _sessions!.Current;
    private ElementReference _editRoot;
    protected override Task OnParametersSetAsync()
    {
        _sessions ??= new(() => InvokeAsync(StateHasChanged));
        return _sessions.SetAsync($"{Id}", () =>
        {
            var session = new TagEditSession(TagCommandService, TagQueryService, NavigationManager, LocalStorage, ToastService) { Id = Id };
            session.Draft.Dispatch = work => InvokeAsync(work);
            session.Draft.FlushInputs = () => CgMarkdownEditor.FlushAllAsync(JS, _editRoot);
            return session;
        });
    }

    public ValueTask DisposeAsync() => _sessions?.DisposeAsync() ?? ValueTask.CompletedTask;

}
