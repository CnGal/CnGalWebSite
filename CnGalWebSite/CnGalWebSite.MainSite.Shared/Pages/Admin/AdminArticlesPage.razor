@using CnGalWebSite.DataModel.Sorting
@page "/admin/listarticles"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IAdminQueryService AdminQueryService
@inject IAdminCommandService AdminCommandService
@inject ICgToastService ToastService
@implements IDisposable
@using CnGalWebSite.Core.Models
@using CnGalWebSite.DataModel.ViewModel.Admin

<CgPageMeta Title="文章管理" />

<div class="admin-list-page">
    <h1 class="admin-page-title">
        <CgMdiIcon Name="mdiNoteTextOutline" aria-hidden="true" />
        文章管理
    </h1>

    <CgDataTable TItem="ArticleOverviewModel" TSort="ArticleSortField"
                 Title="文章列表"
                 OnServerQuery="OnServerQuery"
                 DefaultSortField="ArticleSortField.Id"
                 DefaultSortDesc="true"
                 @ref="_dataTable">
        <CgDataTableColumn TItem="ArticleOverviewModel" TSort="ArticleSortField" Title="Id" SortField="ArticleSortField.Id" Value="item => item.Id" Width="80px" />
        <CgDataTableColumn TItem="ArticleOverviewModel" TSort="ArticleSortField" Title="名称" SortField="ArticleSortField.Name" Value="item => item.Name">
            <ChildContent Context="item">
                <a class="admin-cell-name" href="@($"/articles/index/{item.Id}")">@item.Name</a>
            </ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="ArticleOverviewModel" TSort="ArticleSortField" Title="创建时间" SortField="ArticleSortField.CreateTime" Value="item => item.CreateTime">
            <ChildContent Context="item">
                @item.CreateTime.ToString("yyyy-MM-dd HH:mm")
            </ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="ArticleOverviewModel" TSort="ArticleSortField" Title="最后编辑" SortField="ArticleSortField.LastEditTime" Value="item => item.LastEditTime">
            <ChildContent Context="item">
                @item.LastEditTime.ToString("yyyy-MM-dd HH:mm")
            </ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="ArticleOverviewModel" TSort="ArticleSortField" Title="优先级" SortField="ArticleSortField.Priority" Value="item => item.Priority" Width="80px" />
        <CgDataTableColumn TItem="ArticleOverviewModel" TSort="ArticleSortField" Title="状态" SortField="ArticleSortField.IsHidden" Value="item => item.IsHidden">
            <ChildContent Context="item">
                @if (item.IsHidden)
                {
                    <span class="admin-badge admin-badge--hidden">已隐藏</span>
                }
                else
                {
                    <span class="admin-badge admin-badge--visible">可见</span>
                }
            </ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="ArticleOverviewModel" TSort="ArticleSortField" Title="留言板" SortField="ArticleSortField.CanComment" Value="item => item.CanComment">
            <ChildContent Context="item">
                @if (item.CanComment)
                {
                    <span class="admin-badge admin-badge--yes">开启</span>
                }
                else
                {
                    <span class="admin-badge admin-badge--no">关闭</span>
                }
            </ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="ArticleOverviewModel" TSort="ArticleSortField" Title="操作" Sortable="false" Width="150px">
            <ChildContent Context="item">
                <div class="admin-actions">
                    <button class="admin-action-btn admin-action-btn--up" title="增加权重"
                            data-cg-server-action @onclick="() => EditPriority(item, true)">
                        <CgMdiIcon Name="mdiArrowUpBold" aria-hidden="true" />
                    </button>
                    <button class="admin-action-btn admin-action-btn--down" title="降低权重"
                            data-cg-server-action @onclick="() => EditPriority(item, false)">
                        <CgMdiIcon Name="mdiArrowDownBold" aria-hidden="true" />
                    </button>
                    @if (item.CanComment)
                    {
                        <button class="admin-action-btn admin-action-btn--nocomment" title="关闭留言板"
                                data-cg-server-action @onclick="() => ToggleCanComment(item, false)">
                            <CgMdiIcon Name="mdiCommentRemoveOutline" aria-hidden="true" />
                        </button>
                    }
                    else
                    {
                        <button class="admin-action-btn admin-action-btn--comment" title="开启留言板"
                                data-cg-server-action @onclick="() => ToggleCanComment(item, true)">
                            <CgMdiIcon Name="mdiCommentCheckOutline" aria-hidden="true" />
                        </button>
                    }
                    @if (item.IsHidden)
                    {
                        <button class="admin-action-btn admin-action-btn--show" title="显示"
                                data-cg-server-action @onclick="() => ToggleHidden(item, false)">
                            <CgMdiIcon Name="mdiEyeOutline" aria-hidden="true" />
                        </button>
                    }
                    else
                    {
                        <button class="admin-action-btn admin-action-btn--hide" title="隐藏"
                                data-cg-server-action @onclick="() => ToggleHidden(item, true)">
                            <CgMdiIcon Name="mdiEyeOffOutline" aria-hidden="true" />
                        </button>
                    }
                </div>
            </ChildContent>
        </CgDataTableColumn>
    </CgDataTable>
</div>

@code {
    private CancellationTokenSource? _cts = new();
    private CgDataTable<ArticleOverviewModel, ArticleSortField>? _dataTable;

    private async Task<CgDataTableResult<ArticleOverviewModel>> OnServerQuery(CgDataTableRequest<ArticleSortField> request)
    {
        var parameter = request.ToQueryParameter();
        var result = await AdminQueryService.GetArticlesAsync(parameter, _cts.Token);
        return result.Success && result.Data is not null
            ? new CgDataTableResult<ArticleOverviewModel>(result.Data.Items.ToList(), result.Data.Total)
            : new CgDataTableResult<ArticleOverviewModel>([], 0);
    }

    private async Task EditPriority(ArticleOverviewModel item, bool up)
    {
        var r = await AdminCommandService.EditArticlePriorityAsync(new[] { item.Id }, up ? 1 : -1, _cts.Token);
        await HandleResult(r, up ? "已增加权重" : "已降低权重");
    }

    private async Task ToggleHidden(ArticleOverviewModel item, bool hide)
    {
        var r = await AdminCommandService.HideArticleAsync(new[] { item.Id }, hide, _cts.Token);
        await HandleResult(r, hide ? "已隐藏文章" : "已显示文章");
    }

    private async Task ToggleCanComment(ArticleOverviewModel item, bool canComment)
    {
        var r = await AdminCommandService.EditArticleCanCommentAsync(new[] { item.Id }, canComment, _cts.Token);
        await HandleResult(r, canComment ? "已开启留言板" : "已关闭留言板");
    }

    private async Task HandleResult(SdkResult<bool> result, string successMessage)
    {
        if (result.Success) { ToastService.Show(successMessage, variant: "success"); if (_dataTable is not null) await _dataTable.RefreshAsync(); }
        else { ToastService.Show(result.Error?.Message ?? "操作失败", variant: "error"); }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
