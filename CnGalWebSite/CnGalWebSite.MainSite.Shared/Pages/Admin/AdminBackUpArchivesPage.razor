@using CnGalWebSite.DataModel.Sorting
@page "/admin/listbackuparchives"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IAdminQueryService AdminQueryService
@inject IAdminCommandService AdminCommandService
@inject ICgToastService ToastService
@implements IDisposable
@using CnGalWebSite.Core.Models
@using CnGalWebSite.DataModel.ViewModel.BackUpArchives

<CgPageMeta Title="备份管理" />

<div class="admin-list-page">
    <h1 class="admin-page-title">
        <CgMdiIcon Name="mdiDatabaseOutline" aria-hidden="true" />
        备份管理
    </h1>

    <CgDataTable TItem="BackUpArchiveOverviewModel" TSort="BackUpArchiveSortField"
                 Title="备份列表"
                 OnServerQuery="OnServerQuery"
                 DefaultSortField="BackUpArchiveSortField.Id"
                 DefaultSortDesc="true"
                 @ref="_dataTable">
        <CgDataTableColumn TItem="BackUpArchiveOverviewModel" TSort="BackUpArchiveSortField" Title="Id" SortField="BackUpArchiveSortField.Id" Value="item => item.Id" Width="80px" />
        <CgDataTableColumn TItem="BackUpArchiveOverviewModel" TSort="BackUpArchiveSortField" Title="最后备份时间" SortField="BackUpArchiveSortField.LastBackUpTime" Value="item => item.LastBackUpTime">
            <ChildContent Context="item">@item.LastBackUpTime.ToString("yyyy-MM-dd HH:mm")</ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="BackUpArchiveOverviewModel" TSort="BackUpArchiveSortField" Title="用时" SortField="BackUpArchiveSortField.LastTimeUsed" Value="item => item.LastTimeUsed" Width="100px">
            <ChildContent Context="item">
                @item.LastTimeUsed.ToString("0.0 秒")
            </ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="BackUpArchiveOverviewModel" TSort="BackUpArchiveSortField" Title="目标" SortField="BackUpArchiveSortField.Type" Value="item => item.Type" Width="100px">
            <ChildContent Context="item">
                <span class="admin-badge">@item.Type</span>
            </ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="BackUpArchiveOverviewModel" TSort="BackUpArchiveSortField" Title="状态" SortField="BackUpArchiveSortField.IsLastFail" Value="item => item.IsLastFail" Width="80px">
            <ChildContent Context="item">
                @if (item.IsLastFail)
                {
                    <span class="admin-badge admin-badge--hidden">失败</span>
                }
                else
                {
                    <span class="admin-badge admin-badge--visible">成功</span>
                }
            </ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="BackUpArchiveOverviewModel" TSort="BackUpArchiveSortField" Title="操作" Sortable="false" Width="50px">
            <ChildContent Context="item">
                <div class="admin-actions">
                    <button class="admin-action-btn admin-action-btn--run" title="执行备份" data-cg-server-action @onclick="() => RunBackUp(item)">
                        <CgMdiIcon Name="mdiPlayCircleOutline" aria-hidden="true" />
                    </button>
                </div>
            </ChildContent>
        </CgDataTableColumn>
    </CgDataTable>
</div>

@code {
    private CgDataTable<BackUpArchiveOverviewModel, BackUpArchiveSortField>? _dataTable;
    private CancellationTokenSource? _cts = new();

    private async Task<CgDataTableResult<BackUpArchiveOverviewModel>> OnServerQuery(CgDataTableRequest<BackUpArchiveSortField> request)
    {
        var parameter = request.ToQueryParameter();
        try
        {
            var result = await AdminQueryService.GetBackUpArchivesAsync(parameter, _cts!.Token);
            return result.Success && result.Data is not null ? new CgDataTableResult<BackUpArchiveOverviewModel>(result.Data.Items.ToList(), result.Data.Total) : new CgDataTableResult<BackUpArchiveOverviewModel>([], 0);
        }
        catch (OperationCanceledException)
        {
            return new CgDataTableResult<BackUpArchiveOverviewModel>([], 0);
        }
    }

    private async Task RunBackUp(BackUpArchiveOverviewModel item)
    {
        try
        {
            var r = await AdminCommandService.RunBackUpArchiveAsync(new[] { item.Id }, _cts!.Token);
            if (r.Success) { ToastService.Show("备份任务已执行", variant: "success"); if (_dataTable is not null) await _dataTable.RefreshAsync(); }
            else { ToastService.Show(r.Error?.Message ?? "执行备份失败", variant: "error"); }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
