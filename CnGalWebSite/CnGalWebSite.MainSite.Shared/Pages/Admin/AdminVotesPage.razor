@using CnGalWebSite.DataModel.Sorting
@page "/admin/listvotes"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IAdminQueryService AdminQueryService
@inject IAdminCommandService AdminCommandService
@inject ICgToastService ToastService
@implements IDisposable
@using CnGalWebSite.Core.Models
@using CnGalWebSite.DataModel.ViewModel.Admin

<CgPageMeta Title="投票管理" />

<div class="admin-list-page">
    <h1 class="admin-page-title">
        <CgMdiIcon Name="mdiVoteOutline" aria-hidden="true" />
        投票管理
    </h1>

    <CgDataTable TItem="VoteOverviewModel" TSort="VoteSortField" Title="投票列表" OnServerQuery="OnServerQuery" DefaultSortField="VoteSortField.Id" DefaultSortDesc="true" @ref="_dataTable">
        <CgDataTableColumn TItem="VoteOverviewModel" TSort="VoteSortField" Title="Id" SortField="VoteSortField.Id" Value="item => item.Id" Width="80px" />
        <CgDataTableColumn TItem="VoteOverviewModel" TSort="VoteSortField" Title="名称" SortField="VoteSortField.Name" Value="item => item.Name">
            <ChildContent Context="item"><a class="admin-cell-name" href="@($"/votes/index/{item.Id}")">@item.Name</a></ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="VoteOverviewModel" TSort="VoteSortField" Title="开始时间" SortField="VoteSortField.BeginTime" Value="item => item.BeginTime">
            <ChildContent Context="item">@item.BeginTime.ToString("yyyy-MM-dd HH:mm")</ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="VoteOverviewModel" TSort="VoteSortField" Title="结束时间" SortField="VoteSortField.EndTime" Value="item => item.EndTime">
            <ChildContent Context="item">@item.EndTime.ToString("yyyy-MM-dd HH:mm")</ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="VoteOverviewModel" TSort="VoteSortField" Title="优先级" SortField="VoteSortField.Priority" Value="item => item.Priority" Width="80px" />
        <CgDataTableColumn TItem="VoteOverviewModel" TSort="VoteSortField" Title="状态" SortField="VoteSortField.IsHidden" Value="item => item.IsHidden">
            <ChildContent Context="item">
                @if (item.IsHidden) { <span class="admin-badge admin-badge--hidden">已隐藏</span> }
                else { <span class="admin-badge admin-badge--visible">可见</span> }
            </ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="VoteOverviewModel" TSort="VoteSortField" Title="留言板" SortField="VoteSortField.CanComment" Value="item => item.CanComment">
            <ChildContent Context="item">
                @if (item.CanComment) { <span class="admin-badge admin-badge--yes">开启</span> }
                else { <span class="admin-badge admin-badge--no">关闭</span> }
            </ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="VoteOverviewModel" TSort="VoteSortField" Title="操作" Sortable="false" Width="150px">
            <ChildContent Context="item">
                <div class="admin-actions">
                    <button class="admin-action-btn admin-action-btn--up" title="增加权重" data-cg-server-action @onclick="() => EditPriority(item, true)"><CgMdiIcon Name="mdiArrowUpBold" aria-hidden="true" /></button>
                    <button class="admin-action-btn admin-action-btn--down" title="降低权重" data-cg-server-action @onclick="() => EditPriority(item, false)"><CgMdiIcon Name="mdiArrowDownBold" aria-hidden="true" /></button>
                    @if (item.CanComment) { <button class="admin-action-btn admin-action-btn--nocomment" title="关闭留言板" data-cg-server-action @onclick="() => ToggleCanComment(item, false)"><CgMdiIcon Name="mdiCommentRemoveOutline" aria-hidden="true" /></button> }
                    else { <button class="admin-action-btn admin-action-btn--comment" title="开启留言板" data-cg-server-action @onclick="() => ToggleCanComment(item, true)"><CgMdiIcon Name="mdiCommentCheckOutline" aria-hidden="true" /></button> }
                    @if (item.IsHidden) { <button class="admin-action-btn admin-action-btn--show" title="显示" data-cg-server-action @onclick="() => ToggleHidden(item, false)"><CgMdiIcon Name="mdiEyeOutline" aria-hidden="true" /></button> }
                    else { <button class="admin-action-btn admin-action-btn--hide" title="隐藏" data-cg-server-action @onclick="() => ToggleHidden(item, true)"><CgMdiIcon Name="mdiEyeOffOutline" aria-hidden="true" /></button> }
                </div>
            </ChildContent>
        </CgDataTableColumn>
    </CgDataTable>
</div>

@code {
    private CancellationTokenSource? _cts;
    private CgDataTable<VoteOverviewModel, VoteSortField>? _dataTable;

    private async Task<CgDataTableResult<VoteOverviewModel>> OnServerQuery(CgDataTableRequest<VoteSortField> request)
    {
        var parameter = request.ToQueryParameter();
        var result = await AdminQueryService.GetVotesAsync(parameter, _cts?.Token ?? CancellationToken.None);
        return result.Success && result.Data is not null ? new CgDataTableResult<VoteOverviewModel>(result.Data.Items.ToList(), result.Data.Total) : new CgDataTableResult<VoteOverviewModel>([], 0);
    }

    private async Task EditPriority(VoteOverviewModel item, bool up) { var r = await AdminCommandService.EditVotePriorityAsync(new[] { item.Id }, up ? 1 : -1, _cts?.Token ?? CancellationToken.None); await HandleResult(r, up ? "已增加权重" : "已降低权重"); }
    private async Task ToggleHidden(VoteOverviewModel item, bool hide) { var r = await AdminCommandService.HideVoteAsync(new[] { item.Id }, hide, _cts?.Token ?? CancellationToken.None); await HandleResult(r, hide ? "已隐藏" : "已显示"); }
    private async Task ToggleCanComment(VoteOverviewModel item, bool canComment) { var r = await AdminCommandService.EditVoteCanCommentAsync(new[] { item.Id }, canComment, _cts?.Token ?? CancellationToken.None); await HandleResult(r, canComment ? "已开启留言板" : "已关闭留言板"); }

    private async Task HandleResult(SdkResult<bool> result, string successMessage)
    {
        if (result.Success) { ToastService.Show(successMessage, variant: "success"); if (_dataTable is not null) await _dataTable.RefreshAsync(); }
        else { ToastService.Show(result.Error?.Message ?? "操作失败", variant: "error"); }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
