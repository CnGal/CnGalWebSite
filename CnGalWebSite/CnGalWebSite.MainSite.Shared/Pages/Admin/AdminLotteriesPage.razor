@using CnGalWebSite.DataModel.Sorting
@page "/admin/listlotteries"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IAdminQueryService AdminQueryService
@inject IAdminCommandService AdminCommandService
@inject ICgToastService ToastService
@implements IDisposable
@using CnGalWebSite.Core.Models
@using CnGalWebSite.DataModel.ViewModel.Lotteries

<CgPageMeta Title="抽奖管理" />

<div class="admin-list-page">
    <h1 class="admin-page-title">
        <CgMdiIcon Name="mdiGiftOutline" aria-hidden="true" />
        抽奖管理
    </h1>

    <CgDataTable TItem="LotteryOverviewModel" TSort="LotterySortField" Title="抽奖列表" OnServerQuery="OnServerQuery" DefaultSortField="LotterySortField.Id" DefaultSortDesc="true" @ref="_dataTable">
        <CgDataTableColumn TItem="LotteryOverviewModel" TSort="LotterySortField" Title="Id" SortField="LotterySortField.Id" Value="item => item.Id" Width="80px" />
        <CgDataTableColumn TItem="LotteryOverviewModel" TSort="LotterySortField" Title="名称" SortField="LotterySortField.Name" Value="item => item.Name">
            <ChildContent Context="item"><a class="admin-cell-name" href="@($"/lotteries/index/{item.Id}")">@item.Name</a></ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="LotteryOverviewModel" TSort="LotterySortField" Title="抽奖时间" SortField="LotterySortField.LotteryTime" Value="item => item.LotteryTime">
            <ChildContent Context="item">@(item.LotteryTime.Year == 1 ? "无" : item.LotteryTime.ToString("yyyy-MM-dd HH:mm"))</ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="LotteryOverviewModel" TSort="LotterySortField" Title="开始时间" SortField="LotterySortField.BeginTime" Value="item => item.BeginTime">
            <ChildContent Context="item">@item.BeginTime.ToString("yyyy-MM-dd HH:mm")</ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="LotteryOverviewModel" TSort="LotterySortField" Title="结束时间" SortField="LotterySortField.EndTime" Value="item => item.EndTime">
            <ChildContent Context="item">@item.EndTime.ToString("yyyy-MM-dd HH:mm")</ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="LotteryOverviewModel" TSort="LotterySortField" Title="优先级" SortField="LotterySortField.Priority" Value="item => item.Priority" Width="80px" />
        <CgDataTableColumn TItem="LotteryOverviewModel" TSort="LotterySortField" Title="已结束" SortField="LotterySortField.IsEnd" Value="item => item.IsEnd">
            <ChildContent Context="item">
                @if (item.IsEnd) { <span class="admin-badge admin-badge--hidden">已结束</span> }
                else { <span class="admin-badge admin-badge--visible">进行中</span> }
            </ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="LotteryOverviewModel" TSort="LotterySortField" Title="状态" SortField="LotterySortField.IsHidden" Value="item => item.IsHidden">
            <ChildContent Context="item">
                @if (item.IsHidden) { <span class="admin-badge admin-badge--hidden">已隐藏</span> }
                else { <span class="admin-badge admin-badge--visible">可见</span> }
            </ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="LotteryOverviewModel" TSort="LotterySortField" Title="操作" Sortable="false" Width="150px">
            <ChildContent Context="item">
                <div class="admin-actions">
                    <button class="admin-action-btn admin-action-btn--up" title="增加权重" @onclick="() => EditPriority(item, true)"><CgMdiIcon Name="mdiArrowUpBold" aria-hidden="true" /></button>
                    <button class="admin-action-btn admin-action-btn--down" title="降低权重" @onclick="() => EditPriority(item, false)"><CgMdiIcon Name="mdiArrowDownBold" aria-hidden="true" /></button>
                    @if (item.CanComment) { <button class="admin-action-btn admin-action-btn--nocomment" title="关闭留言板" @onclick="() => ToggleCanComment(item, false)"><CgMdiIcon Name="mdiCommentRemoveOutline" aria-hidden="true" /></button> }
                    else { <button class="admin-action-btn admin-action-btn--comment" title="开启留言板" @onclick="() => ToggleCanComment(item, true)"><CgMdiIcon Name="mdiCommentCheckOutline" aria-hidden="true" /></button> }
                    @if (item.IsHidden) { <button class="admin-action-btn admin-action-btn--show" title="显示" @onclick="() => ToggleHidden(item, false)"><CgMdiIcon Name="mdiEyeOutline" aria-hidden="true" /></button> }
                    else { <button class="admin-action-btn admin-action-btn--hide" title="隐藏" @onclick="() => ToggleHidden(item, true)"><CgMdiIcon Name="mdiEyeOffOutline" aria-hidden="true" /></button> }
                </div>
            </ChildContent>
        </CgDataTableColumn>
    </CgDataTable>
</div>

@code {
    private CancellationTokenSource? _cts = new();
    private CgDataTable<LotteryOverviewModel, LotterySortField>? _dataTable;

    private async Task<CgDataTableResult<LotteryOverviewModel>> OnServerQuery(CgDataTableRequest<LotterySortField> request)
    {
        var parameter = request.ToQueryParameter();
        var result = await AdminQueryService.GetLotteriesAsync(parameter, _cts.Token);
        return result.Success && result.Data is not null ? new CgDataTableResult<LotteryOverviewModel>(result.Data.Items.ToList(), result.Data.Total) : new CgDataTableResult<LotteryOverviewModel>([], 0);
    }

    private async Task EditPriority(LotteryOverviewModel item, bool up) { var r = await AdminCommandService.EditLotteryPriorityAsync(new[] { item.Id }, up ? 1 : -1, _cts.Token); await HandleResult(r, up ? "已增加权重" : "已降低权重"); }
    private async Task ToggleHidden(LotteryOverviewModel item, bool hide) { var r = await AdminCommandService.HideLotteryAsync(new[] { item.Id }, hide, _cts.Token); await HandleResult(r, hide ? "已隐藏" : "已显示"); }
    private async Task ToggleCanComment(LotteryOverviewModel item, bool canComment) { var r = await AdminCommandService.EditLotteryCanCommentAsync(new[] { item.Id }, canComment, _cts.Token); await HandleResult(r, canComment ? "已开启留言板" : "已关闭留言板"); }

    private async Task HandleResult(SdkResult<bool> result, string successMessage)
    {
        if (result.Success) { ToastService.Show(successMessage, variant: "success"); if (_dataTable is not null) await _dataTable.RefreshAsync(); }
        else { ToastService.Show(result.Error?.Message ?? "操作失败", variant: "error"); }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
