@using CnGalWebSite.DataModel.Sorting
@page "/admin/listmessages"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IAdminQueryService AdminQueryService
@inject NavigationManager NavigationManager
@implements IDisposable
@using CnGalWebSite.Core.Models
@using CnGalWebSite.DataModel.ViewModel.Admin

<CgPageMeta Title="消息管理" />

<div class="admin-list-page">
    <h1 class="admin-page-title">
        <CgMdiIcon Name="mdiEmailOutline" aria-hidden="true" />
        消息管理
    </h1>

    <CgDataTable TItem="MessageOverviewModel" TSort="MessageSortField"
                 Title="消息列表"
                 OnServerQuery="OnServerQuery"
                 DefaultSortField="MessageSortField.Id"
                 DefaultSortDesc="true">
        <CgDataTableColumn TItem="MessageOverviewModel" TSort="MessageSortField" Title="Id" SortField="MessageSortField.Id" Value="item => item.Id" Width="80px" />
        <CgDataTableColumn TItem="MessageOverviewModel" TSort="MessageSortField" Title="类型" SortField="MessageSortField.Type" Value="item => item.Type">
            <ChildContent Context="item">
                <span class="admin-badge">@item.Type</span>
            </ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="MessageOverviewModel" TSort="MessageSortField" Title="发送时间" SortField="MessageSortField.PostTime" Value="item => item.PostTime">
            <ChildContent Context="item">@item.PostTime.ToString("yyyy-MM-dd HH:mm")</ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="MessageOverviewModel" TSort="MessageSortField" Title="标题" SortField="MessageSortField.Title" Value="item => item.Title" />
        <CgDataTableColumn TItem="MessageOverviewModel" TSort="MessageSortField" Title="内容" SortField="MessageSortField.Text" Value="item => item.Text">
            <ChildContent Context="item"><div class="admin-cell-text">@item.Text</div></ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="MessageOverviewModel" TSort="MessageSortField" Title="用户" SortField="MessageSortField.UserName" Value="item => item.UserName">
            <ChildContent Context="item"><span class="admin-cell-name">@item.UserName</span></ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="MessageOverviewModel" TSort="MessageSortField" Title="已读" SortField="MessageSortField.IsReaded" Value="item => item.IsReaded">
            <ChildContent Context="item">
                @if (item.IsReaded) { <span class="admin-badge admin-badge--yes">已读</span> }
                else { <span class="admin-badge admin-badge--no">未读</span> }
            </ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="MessageOverviewModel" TSort="MessageSortField" Title="操作" Sortable="false" Width="50px">
            <ChildContent Context="item">
                <div class="admin-actions">
                    @if (!string.IsNullOrWhiteSpace(item.Link))
                    {
                        <button class="admin-action-btn admin-action-btn--show" title="查看"
                                @onclick="() => NavigationManager.NavigateTo(item.Link)">
                            <CgMdiIcon Name="mdiEyeOutline" aria-hidden="true" />
                        </button>
                    }
                </div>
            </ChildContent>
        </CgDataTableColumn>
    </CgDataTable>
</div>

@code {
    private CancellationTokenSource? _cts = new();
    private async Task<CgDataTableResult<MessageOverviewModel>> OnServerQuery(CgDataTableRequest<MessageSortField> request)
    {
        var parameter = request.ToQueryParameter();
        var result = await AdminQueryService.GetMessagesAsync(parameter, _cts.Token);
        return result.Success && result.Data is not null ? new CgDataTableResult<MessageOverviewModel>(result.Data.Items.ToList(), result.Data.Total) : new CgDataTableResult<MessageOverviewModel>([], 0);
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
