@using CnGalWebSite.DataModel.Sorting
@page "/admin/listalmanacs"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IAdminQueryService AdminQueryService
@inject NavigationManager NavigationManager
@implements IDisposable
@using CnGalWebSite.Core.Models
@using CnGalWebSite.DataModel.ViewModel.Almanacs

<CgPageMeta Title="年鉴管理" />

<div class="admin-list-page">
    <h1 class="admin-page-title">
        <CgMdiIcon Name="mdiCalendarTextOutline" aria-hidden="true" />
        年鉴管理
    </h1>

    <CgDataTable TItem="AlmanacOverviewModel" TSort="AlmanacSortField"
                 Title="年鉴列表"
                 OnServerQuery="OnServerQuery"
                 DefaultSortField="AlmanacSortField.Id"
                 DefaultSortDesc="true">
        <ToolbarContent>
            <CgButton Variant="outline" OnClick="@(() => NavigationManager.NavigateTo("/almanac/edit"))">
                <CgMdiIcon Name="mdiPlus" />
                添加年鉴
            </CgButton>
        </ToolbarContent>
        <ChildContent>
        <CgDataTableColumn TItem="AlmanacOverviewModel" TSort="AlmanacSortField" Title="Id" SortField="AlmanacSortField.Id" Value="item => item.Id" Width="80px" />
        <CgDataTableColumn TItem="AlmanacOverviewModel" TSort="AlmanacSortField" Title="年份" SortField="AlmanacSortField.Year" Value="item => item.Year" Width="80px" />
        <CgDataTableColumn TItem="AlmanacOverviewModel" TSort="AlmanacSortField" Title="名称" SortField="AlmanacSortField.Name" Value="item => item.Name" />
        <CgDataTableColumn TItem="AlmanacOverviewModel" TSort="AlmanacSortField" Title="简介" SortField="AlmanacSortField.BriefIntroduction" Value="item => item.BriefIntroduction">
            <ChildContent Context="item">
                <div class="admin-cell-text">@item.BriefIntroduction</div>
            </ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="AlmanacOverviewModel" TSort="AlmanacSortField" Title="词条数" SortField="AlmanacSortField.EntryCount" Value="item => item.EntryCount" Sortable="false" Width="80px" />
        <CgDataTableColumn TItem="AlmanacOverviewModel" TSort="AlmanacSortField" Title="文章数" SortField="AlmanacSortField.ArticleCount" Value="item => item.ArticleCount" Sortable="false" Width="80px" />
        <CgDataTableColumn TItem="AlmanacOverviewModel" TSort="AlmanacSortField" Title="更新时间" SortField="AlmanacSortField.UpdateTime" Value="item => item.UpdateTime">
            <ChildContent Context="item">
                @item.UpdateTime.ToString("yyyy-MM-dd HH:mm")
            </ChildContent>
        </CgDataTableColumn>
        <CgDataTableColumn TItem="AlmanacOverviewModel" TSort="AlmanacSortField" Title="操作" Sortable="false" Width="100px">
            <ChildContent Context="item">
                <div class="admin-actions">
                    <button class="admin-action-btn admin-action-btn--up" title="编辑"
                            data-cg-server-action @onclick="@(() => NavigationManager.NavigateTo($"/almanac/edit/{item.Id}"))">
                        <CgMdiIcon Name="mdiPencilOutline" aria-hidden="true" />
                    </button>
                    <button class="admin-action-btn admin-action-btn--show" title="查看"
                            data-cg-server-action @onclick="@(() => NavigationManager.NavigateTo($"/almanac/{item.Id}"))">
                        <CgMdiIcon Name="mdiEyeOutline" aria-hidden="true" />
                    </button>
                </div>
            </ChildContent>
        </CgDataTableColumn>
        </ChildContent>
    </CgDataTable>
</div>

@code {
    private CancellationTokenSource? _cts = new();

    private async Task<CgDataTableResult<AlmanacOverviewModel>> OnServerQuery(CgDataTableRequest<AlmanacSortField> request)
    {
        var parameter = request.ToQueryParameter();
        try
        {
            var result = await AdminQueryService.GetAlmanacsAsync(parameter, _cts!.Token);
            return result.Success && result.Data is not null ? new CgDataTableResult<AlmanacOverviewModel>(result.Data.Items.ToList(), result.Data.Total) : new CgDataTableResult<AlmanacOverviewModel>([], 0);
        }
        catch (OperationCanceledException)
        {
            return new CgDataTableResult<AlmanacOverviewModel>([], 0);
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
