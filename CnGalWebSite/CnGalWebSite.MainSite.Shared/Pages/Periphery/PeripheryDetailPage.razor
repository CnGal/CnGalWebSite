@inject IPeripheryPageQueryService PageQuery
@inject PageResponseState PageResponse
@page "/peripheries/index/{Id:long}"


@implements IDisposable
@using CnGalWebSite.DataModel.Model
@using CnGalWebSite.DataModel.ViewModel.Admin
@using CnGalWebSite.MainSite.Shared.Components.Features.Periphery.Detail
@using CnGalWebSite.MainSite.Shared.Components.Features.Entry.Detail
@using CnGalWebSite.MainSite.Shared.Components.Features.Examine

<CgPageMeta Title="@(_model is null ? null : GetDisplayTitle())" Description="@(_model?.BriefIntroduction)" Image="@(_model?.MainPicture)" />

@if (_errorMessage is not null)
{
    <section class="periphery-not-found">
        <h1>周边加载失败</h1>
        <p>@_errorMessage</p>
        <a href="/">返回首页</a>
    </section>
}
else if (_model is not null)
{
    <TrackingMeta Type="periphery" Id="@_model.Id.ToString()" Name="@_model.Name" />

    <article class="periphery-page">
        @if (HasAtmosphere())
        {
            <CgAtmosphere BackgroundPicture="@_model.BackgroundPicture" SmallBackgroundPicture="@_model.SmallBackgroundPicture" />
        }

        <PeripheryHero Name="@_model.Name"
                       DisplayName="@_model.DisplayName"
                       BriefIntroduction="@_model.BriefIntroduction"
                       MainPicture="@_model.MainPicture"
                       BackgroundPicture="@_model.BackgroundPicture"
                       ReaderCount="_model.ReaderCount"
                       CollectedCount="_model.CollectedCount"
                       PeripheryId="_model.Id"
                       IsHidden="_model.IsHidden" />

        <CgHiddenTip IsHidden="_model.IsHidden" ContentTypeName="周边" />

        @* ── 桌面端双栏布局 ── *@
        <section class="periphery-layout periphery-layout--desktop" aria-label="桌面详情布局">
            <main class="periphery-main-col">
                <PeripheryGallery Pictures="_model.Pictures" />

                <PeripheryOverviewSection OverviewModels="_model.PeripheryOverviewModels" />

                <PeripheryRelatedEntries Entries="_model.Entries" />

                <CnGalWebSite.MainSite.Shared.Components.Features.Comment.CommentSection
                    Type="CommentType.CommentPeriphery"
                    ObjectId="@_model.Id.ToString()"
                    CanComment="_model.CanComment" />
            </main>

            <aside class="periphery-side-col">
                <PeripheryInfoCard Type="_model.Type"
                                   Category="@_model.Category"
                                   Brand="@_model.Brand"
                                   Author="@_model.Author"
                                   Material="@_model.Material"
                                   Size="@_model.Size"
                                   IndividualParts="@_model.IndividualParts"
                                   Price="@_model.Price"
                                   SaleLink="@_model.SaleLink"
                                   IsReprint="_model.IsReprint"
                                   IsAvailableItem="_model.IsAvailableItem"
                                   PageCount="_model.PageCount"
                                   SongCount="_model.SongCount" />

                <PeripheryRelatedPeripheries Peripheries="_model.Peripheries" />

                <CgMiniModeContainer>
                    @if (_recordsError is not null) { <CgAlert>@_recordsError</CgAlert> }
                <EditRecordListCard Records="_editRecords" Columns="1" />
                </CgMiniModeContainer>
            </aside>
        </section>

        @* ── 移动端单栏布局 ── *@
        <section class="periphery-layout periphery-layout--mobile" aria-label="移动端详情布局">
            <PeripheryInfoCard Type="_model.Type"
                               Category="@_model.Category"
                               Brand="@_model.Brand"
                               Author="@_model.Author"
                               Material="@_model.Material"
                               Size="@_model.Size"
                               IndividualParts="@_model.IndividualParts"
                               Price="@_model.Price"
                               SaleLink="@_model.SaleLink"
                               IsReprint="_model.IsReprint"
                               IsAvailableItem="_model.IsAvailableItem"
                               PageCount="_model.PageCount"
                               SongCount="_model.SongCount" />

            <PeripheryGallery Pictures="_model.Pictures" />

            <PeripheryOverviewSection OverviewModels="_model.PeripheryOverviewModels" />

            <PeripheryRelatedEntries Entries="_model.Entries" />

            <PeripheryRelatedPeripheries Peripheries="_model.Peripheries" />

            <CgMiniModeContainer>
                @if (_recordsError is not null) { <CgAlert>@_recordsError</CgAlert> }
                <EditRecordListCard Records="_editRecords" Columns="1" />
            </CgMiniModeContainer>

            <CnGalWebSite.MainSite.Shared.Components.Features.Comment.CommentSection
                Type="CommentType.CommentPeriphery"
                ObjectId="@_model.Id.ToString()"
                CanComment="_model.CanComment" />
        </section>
    </article>
}
else
{
    <section class="periphery-loading" aria-label="加载中">
        <CgProgressRing Size="lg" Color="var(--cg-color-primary)" />
        <span class="periphery-loading-text">加载中...</span>
    </section>
}

@code {
    [Parameter]
    public long Id { get; set; }

    private PeripheryDetailViewModel? _model;
    private IReadOnlyList<ExaminedNormalListModel>? _editRecords;
    private string? _errorMessage;
    private CancellationTokenSource? _cts;
    private long _requestVersion;
    private string? _recordsError;

    protected override async Task OnParametersSetAsync()
    {
        if (_model?.Id == Id) return;
        PageResponse.Begin();
        var version = ++_requestVersion;
        _cts?.Cancel(); _cts?.Dispose();
        using var request = new CancellationTokenSource();
        _cts = request;
        _model = null; _editRecords = null; _errorMessage = null; _recordsError = null;
        try
        {
            var result = await PageQuery.GetAsync(Id, request.Token);
            if (request.IsCancellationRequested || version != _requestVersion) return;
            if (result.Success && result.Data is { } page)
            {
                PageResponse.Succeeded();
                _model = page.Periphery;
                _editRecords = page.EditRecords.Data;
                _recordsError = page.EditRecords.Error?.Message;
            }
            else
            {
                PageResponse.Failed(result.Error);
                _errorMessage = result.Error?.Message ?? "请稍后重试";
            }
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested) { }
        finally { if (ReferenceEquals(_cts, request)) _cts = null; }
    }

    private string GetDisplayTitle()
    {
        if (_model is null)
        {
            return string.Empty;
        }

        return string.IsNullOrWhiteSpace(_model.DisplayName) ? _model.Name : _model.DisplayName;
    }

    private bool HasAtmosphere()
    {
        if (_model is null)
        {
            return false;
        }

        return string.IsNullOrWhiteSpace(_model.BackgroundPicture) is false
            || string.IsNullOrWhiteSpace(_model.SmallBackgroundPicture) is false;
    }

    public void Dispose()
    {
        _requestVersion++;
        _cts?.Cancel();
        _cts?.Dispose();
    }



}
