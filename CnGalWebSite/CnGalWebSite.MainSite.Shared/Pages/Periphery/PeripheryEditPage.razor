@using CnGalWebSite.MainSite.Shared.Services.Editing
@inject IJSRuntime JS
@page "/peripheries/createperiphery"
@page "/peripheries/create"
@page "/peripheries/edit/{Id:long}"

@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@using CnGalWebSite.DataModel.ViewModel.Peripheries
@using CnGalWebSite.MainSite.Shared.Components.Features.Periphery.Editor
@using CnGalWebSite.SDK.MainSite.Models.PeripheryEdit
@using System.Text.Json
@inject IPeripheryCommandService PeripheryCommandService
@inject NavigationManager NavigationManager
@inject ILocalStorageService LocalStorage
@inject ICgToastService ToastService
@implements IAsyncDisposable

<CgPageMeta Title="@(Session.IsCreate ? "创建周边" : "编辑周边")" />

@if (Session.IsLoading)
{
    <section class="periphery-edit-loading" aria-label="加载中">
        <div class="periphery-edit-loading-spinner"></div>
        <p>正在获取数据...</p>
    </section>
}
else if (Session.LoadErrorMessage != null)
{
    <section class="periphery-edit-error">
        <h1>加载失败</h1>
        <p>@Session.LoadErrorMessage</p>
        <CgButton Variant="primary" OnClick="Session.LoadDataAsync">重试</CgButton>
    </section>
}
else if (Session.Model != null)
{
    <article class="periphery-edit-page" @ref="_editRoot" data-cg-edit-root>
        <div class="periphery-edit-layout">
            <PeripheryEditorSidebar IsCreate="Session.IsCreate"
                                    IsSubmitting="Session.IsSubmitting"
                                    HasDraftRecovered="Session.HasDraftRecovered"
                                    OnDiscardDraft="Session.DiscardDraft"
                                    OnSubmit="Session.SubmitAsync"
                                    OnCancel="Session.Cancel" />

            <main class="periphery-edit-main">
                <PeripheryMainEditor Model="Session.Model.Data.Main" />
                <PeripheryImagesEditor Model="Session.Model.Data.Images" />
                <PeripheryRelatedEntriesEditor Model="Session.Model.Data.Entries" MetaOptions="Session.Model.MetaOptions" />
                <PeripheryRelatedPeripheriesEditor Model="Session.Model.Data.Peripheries" MetaOptions="Session.Model.MetaOptions" />
            </main>
        </div>

    </article>
}

@code {
    [Parameter] public long? Id { get; set; }

    private EditSessionHost<PeripheryEditSession>? _sessions;
    private PeripheryEditSession Session => _sessions!.Current;
    private ElementReference _editRoot;
    protected override Task OnParametersSetAsync()
    {
        _sessions ??= new(() => InvokeAsync(StateHasChanged));
        return _sessions.SetAsync($"{Id}", () =>
        {
            var session = new PeripheryEditSession(PeripheryCommandService, NavigationManager, LocalStorage, ToastService) { Id = Id };
            session.Draft.Dispatch = work => InvokeAsync(work);
            session.Draft.FlushInputs = () => CgMarkdownEditor.FlushAllAsync(JS, _editRoot);
            return session;
        });
    }

    public ValueTask DisposeAsync() => _sessions?.DisposeAsync() ?? ValueTask.CompletedTask;

}
