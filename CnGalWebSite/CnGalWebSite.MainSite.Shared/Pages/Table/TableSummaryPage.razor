@using CnGalWebSite.DataModel.Sorting
@page "/tables"
@page "/webs/tables"
@page "/data"

@rendermode InteractiveServer

@using CnGalWebSite.DataModel.ViewModel.Tables
@using CnGalWebSite.DataModel.ViewModel.Steam
@using CnGalWebSite.DataModel.Model
@using CnGalWebSite.Core.Models
@using System.Text.Json
@using Microsoft.JSInterop
@using CnGalWebSite.SDK.MainSite.Infrastructure

@inject ITableQueryService TableService
@inject PageResponseState PageResponse
@inject IJSRuntime JS
@implements IDisposable

<CgPageMeta Title="CnGal资料站数据汇总" />

<div class="table-summary">

@* ── 统计 Banner ── *@
<section class="table-summary__banner">
    <h1 class="table-summary__title">CnGal资料站数据汇总</h1>
    <p class="table-summary__subtitle">浏览和导出 CnGal 全站结构化数据</p>
    @if (_summary != null)
    {
        <div class="table-summary__stats">
            <div class="table-summary__stat">
                <CgMdiIcon Name="mdiBookOpenPageVariantOutline" class="table-summary__stat-icon" aria-hidden="true"/>
                <span class="table-summary__stat-value">@_summary.EntriesCount</span>
                <span class="table-summary__stat-label">个词条</span>
            </div>
            <div class="table-summary__stat">
                <CgMdiIcon Name="mdiGamepadSquare" class="table-summary__stat-icon" aria-hidden="true"/>
                <span class="table-summary__stat-value">@_summary.GamesCount</span>
                <span class="table-summary__stat-label">个游戏</span>
            </div>
            <div class="table-summary__stat">
                <CgMdiIcon Name="mdiFileDocumentOutline" class="table-summary__stat-icon" aria-hidden="true"/>
                <span class="table-summary__stat-value">@_summary.ArticlesCount</span>
                <span class="table-summary__stat-label">篇文章</span>
            </div>
            <div class="table-summary__stat">
                <CgMdiIcon Name="mdiAccountGroupOutline" class="table-summary__stat-icon" aria-hidden="true"/>
                <span class="table-summary__stat-value">@_summary.GroupsCount</span>
                <span class="table-summary__stat-label">个制作组</span>
            </div>
            <div class="table-summary__stat">
                <CgMdiIcon Name="mdiAccountHardHat" class="table-summary__stat-icon" aria-hidden="true"/>
                <span class="table-summary__stat-value">@_summary.StaffsCount</span>
                <span class="table-summary__stat-label">位STAFF</span>
            </div>
            <div class="table-summary__stat">
                <CgMdiIcon Name="mdiClover" class="table-summary__stat-icon" aria-hidden="true"/>
                <span class="table-summary__stat-value">@_summary.RolesCount</span>
                <span class="table-summary__stat-label">个角色</span>
            </div>
            @if (_summary.LastEditTime.HasValue)
            {
                <div class="table-summary__stat table-summary__stat--time">
                    <CgMdiIcon Name="mdiClockEditOutline" class="table-summary__stat-icon" aria-hidden="true"/>
                    <span class="table-summary__stat-label">最后编辑 @_summary.LastEditTime.Value.ToString("yyyy-MM-dd HH:mm")</span>
                </div>
            }
        </div>
    }
    else if (_loadingError != null)
    {
        <div class="table-summary__error">
            <CgMdiIcon Name="mdiAlertCircleOutline" class="table-summary__error-icon" aria-hidden="true"/>
            <span>@_loadingError</span>
        </div>
    }
    else
    {
        <div class="table-summary__loading">
            <CgProgressRing/>
        </div>
    }
</section>

@* ── 导出工具栏 ── *@
<div class="table-summary__toolbar">
    <div class="table-summary__toolbar-label">
        <CgMdiIcon Name="mdiDatabaseExportOutline" class="table-summary__toolbar-icon" aria-hidden="true"/>
        <span>导出当前数据</span>
    </div>
    <div class="table-summary__toolbar-actions">
        <button class="table-summary__export-btn" @onclick="OnExportJson" disabled="@_isExporting">
            <CgMdiIcon Name="mdiCodeJson" class="table-summary__export-icon" aria-hidden="true"/>
            @(_isExporting ? "导出中..." : "JSON")
        </button>
        <button class="table-summary__export-btn" @onclick="OnExportCsv" disabled="@_isExporting">
            <CgMdiIcon Name="mdiFileDelimitedOutline" class="table-summary__export-icon" aria-hidden="true"/>
            @(_isExporting ? "导出中..." : "CSV")
        </button>
    </div>
</div>

@* ── Tab 切换栏 + 内容面板 ── *@
<CgTabs Variant="underline" Items="_tabs" DefaultActiveKey="games" Id="table-tabs" AriaLabel="数据类别" ActiveKeyChanged="key => _activeTab = key">
<PanelTemplate Context="tabKey">

@switch (tabKey)
{
    case "games":
        <CgDataTable TItem="BasicInforTableModel" TSort="BasicInforSortField"
                     Title="游戏列表"
                     OnServerQuery="QueryGamesAsync"
                     DefaultSortField="BasicInforSortField.RealId"
                     DefaultSortDesc="true"
                     DefaultPageSize="10">
            <CgDataTableColumn TItem="BasicInforTableModel" TSort="BasicInforSortField" Title="Id" SortField="BasicInforSortField.RealId" Value="item => item.RealId" Width="80px">
                <a href="/entries/index/@context.RealId" class="table-summary__link">@context.RealId</a>
            </CgDataTableColumn>
            <CgDataTableColumn TItem="BasicInforTableModel" TSort="BasicInforSortField" Title="名称" SortField="BasicInforSortField.Name" Value="item => item.Name">
                <a href="/entries/index/@context.RealId" class="table-summary__link">@context.Name</a>
            </CgDataTableColumn>
            <CgDataTableColumn TItem="BasicInforTableModel" TSort="BasicInforSortField" Title="发行时间" SortField="BasicInforSortField.IssueTime" Value="item => item.IssueTime">
                @(context.IssueTime?.ToString("yyyy-MM-dd") ?? "—")
            </CgDataTableColumn>
            <CgDataTableColumn TItem="BasicInforTableModel" TSort="BasicInforSortField" Title="原作" SortField="BasicInforSortField.Original" Value="item => item.Original"/>
            <CgDataTableColumn TItem="BasicInforTableModel" TSort="BasicInforSortField" Title="制作组" SortField="BasicInforSortField.ProductionGroup" Value="item => item.ProductionGroup"/>
            <CgDataTableColumn TItem="BasicInforTableModel" TSort="BasicInforSortField" Title="游戏平台" SortField="BasicInforSortField.GamePlatforms" Value="item => item.GamePlatforms" Sortable="false"/>
            <CgDataTableColumn TItem="BasicInforTableModel" TSort="BasicInforSortField" Title="引擎" SortField="BasicInforSortField.Engine" Value="item => item.Engine"/>
            <CgDataTableColumn TItem="BasicInforTableModel" TSort="BasicInforSortField" Title="发行商" SortField="BasicInforSortField.Publisher" Value="item => item.Publisher"/>
            <CgDataTableColumn TItem="BasicInforTableModel" TSort="BasicInforSortField" Title="别称" SortField="BasicInforSortField.GameNickname" Value="item => item.GameNickname" Sortable="false"/>
            <CgDataTableColumn TItem="BasicInforTableModel" TSort="BasicInforSortField" Title="标签" SortField="BasicInforSortField.Tags" Value="item => item.Tags" Sortable="false"/>
            <CgDataTableColumn TItem="BasicInforTableModel" TSort="BasicInforSortField" Title="发行方式" SortField="BasicInforSortField.IssueMethod" Value="item => item.IssueMethod"/>
            <CgDataTableColumn TItem="BasicInforTableModel" TSort="BasicInforSortField" Title="官网" SortField="BasicInforSortField.OfficialWebsite" Value="item => item.OfficialWebsite" Sortable="false">
                @if (!string.IsNullOrWhiteSpace(context.OfficialWebsite))
                {
                    <a href="@context.OfficialWebsite" target="_blank" rel="noopener" class="table-summary__link">链接</a>
                }
            </CgDataTableColumn>
            <CgDataTableColumn TItem="BasicInforTableModel" TSort="BasicInforSortField" Title="SteamId" SortField="BasicInforSortField.SteamId" Value="item => item.SteamId"/>
            <CgDataTableColumn TItem="BasicInforTableModel" TSort="BasicInforSortField" Title="QQ群" SortField="BasicInforSortField.QQgroupGame" Value="item => item.QQgroupGame" Sortable="false"/>
        </CgDataTable>
        break;

    case "groups":
        <CgDataTable TItem="GroupInforTableModel" TSort="GroupInforSortField"
                     Title="制作组列表"
                     OnServerQuery="QueryGroupsAsync"
                     DefaultSortField="GroupInforSortField.RealId"
                     DefaultSortDesc="true"
                     DefaultPageSize="10">
            <CgDataTableColumn TItem="GroupInforTableModel" TSort="GroupInforSortField" Title="Id" SortField="GroupInforSortField.RealId" Value="item => item.RealId" Width="80px">
                <a href="/entries/index/@context.RealId" class="table-summary__link">@context.RealId</a>
            </CgDataTableColumn>
            <CgDataTableColumn TItem="GroupInforTableModel" TSort="GroupInforSortField" Title="名称" SortField="GroupInforSortField.Name" Value="item => item.Name">
                <a href="/entries/index/@context.RealId" class="table-summary__link">@context.Name</a>
            </CgDataTableColumn>
            <CgDataTableColumn TItem="GroupInforTableModel" TSort="GroupInforSortField" Title="QQ群" SortField="GroupInforSortField.QQgroupGroup" Value="item => item.QQgroupGroup" Sortable="false"/>
            <CgDataTableColumn TItem="GroupInforTableModel" TSort="GroupInforSortField" Title="别称" SortField="GroupInforSortField.AnotherNameGroup" Value="item => item.AnotherNameGroup" Sortable="false"/>
            <CgDataTableColumn TItem="GroupInforTableModel" TSort="GroupInforSortField" Title="B站" SortField="GroupInforSortField.Bilibili" Value="item => item.Bilibili" Sortable="false">
                @if (!string.IsNullOrWhiteSpace(context.Bilibili))
                {
                    <a href="@context.Bilibili" target="_blank" rel="noopener" class="table-summary__link">链接</a>
                }
            </CgDataTableColumn>
            <CgDataTableColumn TItem="GroupInforTableModel" TSort="GroupInforSortField" Title="微博" SortField="GroupInforSortField.MicroBlog" Value="item => item.MicroBlog" Sortable="false">
                @if (!string.IsNullOrWhiteSpace(context.MicroBlog))
                {
                    <a href="@context.MicroBlog" target="_blank" rel="noopener" class="table-summary__link">链接</a>
                }
            </CgDataTableColumn>
        </CgDataTable>
        break;

    case "staffs":
        <CgDataTable TItem="StaffInforTableModel" TSort="StaffInforSortField"
                     Title="STAFF列表"
                     OnServerQuery="QueryStaffsAsync"
                     DefaultSortField="StaffInforSortField.RealId"
                     DefaultSortDesc="true"
                     DefaultPageSize="10">
            <CgDataTableColumn TItem="StaffInforTableModel" TSort="StaffInforSortField" Title="Id" SortField="StaffInforSortField.RealId" Value="item => item.RealId" Width="80px"/>
            <CgDataTableColumn TItem="StaffInforTableModel" TSort="StaffInforSortField" Title="游戏名称" SortField="StaffInforSortField.GameName" Value="item => item.GameName"/>
            <CgDataTableColumn TItem="StaffInforTableModel" TSort="StaffInforSortField" Title="分组" SortField="StaffInforSortField.Subcategory" Value="item => item.Subcategory"/>
            <CgDataTableColumn TItem="StaffInforTableModel" TSort="StaffInforSortField" Title="官方职位" SortField="StaffInforSortField.PositionOfficial" Value="item => item.PositionOfficial"/>
            <CgDataTableColumn TItem="StaffInforTableModel" TSort="StaffInforSortField" Title="官方称呼" SortField="StaffInforSortField.NicknameOfficial" Value="item => item.NicknameOfficial"/>
            <CgDataTableColumn TItem="StaffInforTableModel" TSort="StaffInforSortField" Title="通用职位" SortField="StaffInforSortField.PositionGeneral" Value="item => item.PositionGeneral"/>
            <CgDataTableColumn TItem="StaffInforTableModel" TSort="StaffInforSortField" Title="隶属组织" SortField="StaffInforSortField.SubordinateOrganization" Value="item => item.SubordinateOrganization"/>
        </CgDataTable>
        break;

    case "makers":
        <CgDataTable TItem="MakerInforTableModel" TSort="MakerInforSortField"
                     Title="制作人列表"
                     OnServerQuery="QueryMakersAsync"
                     DefaultSortField="MakerInforSortField.RealId"
                     DefaultSortDesc="true"
                     DefaultPageSize="10">
            <CgDataTableColumn TItem="MakerInforTableModel" TSort="MakerInforSortField" Title="Id" SortField="MakerInforSortField.RealId" Value="item => item.RealId" Width="80px">
                <a href="/entries/index/@context.RealId" class="table-summary__link">@context.RealId</a>
            </CgDataTableColumn>
            <CgDataTableColumn TItem="MakerInforTableModel" TSort="MakerInforSortField" Title="名称" SortField="MakerInforSortField.Name" Value="item => item.Name">
                <a href="/entries/index/@context.RealId" class="table-summary__link">@context.Name</a>
            </CgDataTableColumn>
            <CgDataTableColumn TItem="MakerInforTableModel" TSort="MakerInforSortField" Title="别称" SortField="MakerInforSortField.AnotherName" Value="item => item.AnotherName" Sortable="false"/>
            <CgDataTableColumn TItem="MakerInforTableModel" TSort="MakerInforSortField" Title="B站" SortField="MakerInforSortField.Bilibili" Value="item => item.Bilibili" Sortable="false">
                @if (!string.IsNullOrWhiteSpace(context.Bilibili))
                {
                    <a href="@context.Bilibili" target="_blank" rel="noopener" class="table-summary__link">链接</a>
                }
            </CgDataTableColumn>
            <CgDataTableColumn TItem="MakerInforTableModel" TSort="MakerInforSortField" Title="微博" SortField="MakerInforSortField.MicroBlog" Value="item => item.MicroBlog" Sortable="false">
                @if (!string.IsNullOrWhiteSpace(context.MicroBlog))
                {
                    <a href="@context.MicroBlog" target="_blank" rel="noopener" class="table-summary__link">链接</a>
                }
            </CgDataTableColumn>
        </CgDataTable>
        break;

    case "roles":
        <CgDataTable TItem="RoleInforTableModel" TSort="RoleInforSortField"
                     Title="角色列表"
                     OnServerQuery="QueryRolesAsync"
                     DefaultSortField="RoleInforSortField.RealId"
                     DefaultSortDesc="true"
                     DefaultPageSize="10">
            <CgDataTableColumn TItem="RoleInforTableModel" TSort="RoleInforSortField" Title="Id" SortField="RoleInforSortField.RealId" Value="item => item.RealId" Width="80px">
                <a href="/entries/index/@context.RealId" class="table-summary__link">@context.RealId</a>
            </CgDataTableColumn>
            <CgDataTableColumn TItem="RoleInforTableModel" TSort="RoleInforSortField" Title="名称" SortField="RoleInforSortField.Name" Value="item => item.Name">
                <a href="/entries/index/@context.RealId" class="table-summary__link">@context.Name</a>
            </CgDataTableColumn>
            <CgDataTableColumn TItem="RoleInforTableModel" TSort="RoleInforSortField" Title="声优" SortField="RoleInforSortField.CV" Value="item => item.CV"/>
            <CgDataTableColumn TItem="RoleInforTableModel" TSort="RoleInforSortField" Title="别称" SortField="RoleInforSortField.AnotherNameRole" Value="item => item.AnotherNameRole" Sortable="false"/>
            <CgDataTableColumn TItem="RoleInforTableModel" TSort="RoleInforSortField" Title="性别" SortField="RoleInforSortField.Gender" Value="item => item.Gender">
                @context.Gender.GetDisplayName()
            </CgDataTableColumn>
            <CgDataTableColumn TItem="RoleInforTableModel" TSort="RoleInforSortField" Title="身材数据" SortField="RoleInforSortField.FigureData" Value="item => item.FigureData" Sortable="false"/>
            <CgDataTableColumn TItem="RoleInforTableModel" TSort="RoleInforSortField" Title="身材(主观)" SortField="RoleInforSortField.FigureSubjective" Value="item => item.FigureSubjective" Sortable="false"/>
            <CgDataTableColumn TItem="RoleInforTableModel" TSort="RoleInforSortField" Title="生日" SortField="RoleInforSortField.Birthday" Value="item => item.Birthday">
                @(context.Birthday?.ToString("MM-dd") ?? "—")
            </CgDataTableColumn>
            <CgDataTableColumn TItem="RoleInforTableModel" TSort="RoleInforSortField" Title="发色" SortField="RoleInforSortField.Haircolor" Value="item => item.Haircolor" Sortable="false"/>
            <CgDataTableColumn TItem="RoleInforTableModel" TSort="RoleInforSortField" Title="瞳色" SortField="RoleInforSortField.Pupilcolor" Value="item => item.Pupilcolor" Sortable="false"/>
            <CgDataTableColumn TItem="RoleInforTableModel" TSort="RoleInforSortField" Title="服饰" SortField="RoleInforSortField.ClothesAccessories" Value="item => item.ClothesAccessories" Sortable="false"/>
            <CgDataTableColumn TItem="RoleInforTableModel" TSort="RoleInforSortField" Title="性格" SortField="RoleInforSortField.Character" Value="item => item.Character" Sortable="false"/>
            <CgDataTableColumn TItem="RoleInforTableModel" TSort="RoleInforSortField" Title="角色身份" SortField="RoleInforSortField.RoleIdentity" Value="item => item.RoleIdentity" Sortable="false"/>
            <CgDataTableColumn TItem="RoleInforTableModel" TSort="RoleInforSortField" Title="血型" SortField="RoleInforSortField.BloodType" Value="item => item.BloodType" Sortable="false"/>
            <CgDataTableColumn TItem="RoleInforTableModel" TSort="RoleInforSortField" Title="身高" SortField="RoleInforSortField.RoleHeight" Value="item => item.RoleHeight" Sortable="false"/>
            <CgDataTableColumn TItem="RoleInforTableModel" TSort="RoleInforSortField" Title="兴趣" SortField="RoleInforSortField.RoleTaste" Value="item => item.RoleTaste" Sortable="false"/>
            <CgDataTableColumn TItem="RoleInforTableModel" TSort="RoleInforSortField" Title="年龄" SortField="RoleInforSortField.RoleAge" Value="item => item.RoleAge" Sortable="false"/>
            <CgDataTableColumn TItem="RoleInforTableModel" TSort="RoleInforSortField" Title="登场游戏" SortField="RoleInforSortField.GameName" Value="item => item.GameName"/>
        </CgDataTable>
        break;

    case "prices":
        <CgDataTable TItem="StoreInfoViewModel" TSort="StoreTableSortField"
                     Title="游戏价格列表"
                     OnServerQuery="QueryStoreInfoAsync"
                     DefaultSortField="StoreTableSortField.Name"
                     DefaultSortDesc="false"
                     DefaultPageSize="10">
            <CgDataTableColumn TItem="StoreInfoViewModel" TSort="StoreTableSortField" Title="名称" SortField="StoreTableSortField.Name" Value="item => item.Name"/>
            <CgDataTableColumn TItem="StoreInfoViewModel" TSort="StoreTableSortField" Title="平台" SortField="StoreTableSortField.PlatformName" Value="item => item.PlatformName"/>
            <CgDataTableColumn TItem="StoreInfoViewModel" TSort="StoreTableSortField" Title="状态" SortField="StoreTableSortField.State" Value="item => item.State"/>
            <CgDataTableColumn TItem="StoreInfoViewModel" TSort="StoreTableSortField" Title="币种" SortField="StoreTableSortField.CurrencyCode" Value="item => item.CurrencyCode"/>
            <CgDataTableColumn TItem="StoreInfoViewModel" TSort="StoreTableSortField" Title="原价" SortField="StoreTableSortField.OriginalPrice" Value="item => item.OriginalPrice">
                @FormatPrice(context.OriginalPrice)
            </CgDataTableColumn>
            <CgDataTableColumn TItem="StoreInfoViewModel" TSort="StoreTableSortField" Title="现价" SortField="StoreTableSortField.PriceNow" Value="item => item.PriceNow">
                @FormatPrice(context.PriceNow)
            </CgDataTableColumn>
            <CgDataTableColumn TItem="StoreInfoViewModel" TSort="StoreTableSortField" Title="折扣" SortField="StoreTableSortField.CutNow" Value="item => item.CutNow">
                @FormatPercent(context.CutNow)
            </CgDataTableColumn>
            <CgDataTableColumn TItem="StoreInfoViewModel" TSort="StoreTableSortField" Title="史低" SortField="StoreTableSortField.PriceLowest" Value="item => item.PriceLowest">
                @FormatPrice(context.PriceLowest)
            </CgDataTableColumn>
            <CgDataTableColumn TItem="StoreInfoViewModel" TSort="StoreTableSortField" Title="最高折扣" SortField="StoreTableSortField.CutLowest" Value="item => item.CutLowest">
                @FormatPercent(context.CutLowest)
            </CgDataTableColumn>
            <CgDataTableColumn TItem="StoreInfoViewModel" TSort="StoreTableSortField" Title="游玩时长" SortField="StoreTableSortField.PlayTime" Value="item => item.PlayTime">
                @(context.PlayTime.HasValue ? $"{context.PlayTime.Value} 分钟" : "—")
            </CgDataTableColumn>
            <CgDataTableColumn TItem="StoreInfoViewModel" TSort="StoreTableSortField" Title="评测数" SortField="StoreTableSortField.EvaluationCount" Value="item => item.EvaluationCount">
                @(context.EvaluationCount?.ToString("N0") ?? "—")
            </CgDataTableColumn>
            <CgDataTableColumn TItem="StoreInfoViewModel" TSort="StoreTableSortField" Title="好评率" SortField="StoreTableSortField.RecommendationRate" Value="item => item.RecommendationRate">
                @FormatPercent(context.RecommendationRate)
            </CgDataTableColumn>
            <CgDataTableColumn TItem="StoreInfoViewModel" TSort="StoreTableSortField" Title="拥有人数(下限)" SortField="StoreTableSortField.EstimationOwnersMin" Value="item => item.EstimationOwnersMin">
                @(context.EstimationOwnersMin?.ToString("N0") ?? "—")
            </CgDataTableColumn>
            <CgDataTableColumn TItem="StoreInfoViewModel" TSort="StoreTableSortField" Title="拥有人数(上限)" SortField="StoreTableSortField.EstimationOwnersMax" Value="item => item.EstimationOwnersMax">
                @(context.EstimationOwnersMax?.ToString("N0") ?? "—")
            </CgDataTableColumn>
            <CgDataTableColumn TItem="StoreInfoViewModel" TSort="StoreTableSortField" Title="链接" SortField="StoreTableSortField.Link" Value="item => item.Link" Sortable="false">
                @if (!string.IsNullOrWhiteSpace(context.Link))
                {
                    <a href="@context.Link" target="_blank" rel="noopener" class="table-summary__link">查看</a>
                }
            </CgDataTableColumn>
        </CgDataTable>
        break;

    case "scores":
        <CgDataTable TItem="GameScoreTableModel" TSort="GameScoreSortField"
                     Title="评分列表"
                     OnServerQuery="QueryGameScoresAsync"
                     DefaultSortField="GameScoreSortField.AllTotalSocre"
                     DefaultSortDesc="true"
                     DefaultPageSize="10">
            <CgDataTableColumn TItem="GameScoreTableModel" TSort="GameScoreSortField" Title="Id" SortField="GameScoreSortField.GameId" Value="item => item.GameId" Width="80px">
                <a href="/entries/index/@context.GameId" class="table-summary__link">@context.GameId</a>
            </CgDataTableColumn>
            <CgDataTableColumn TItem="GameScoreTableModel" TSort="GameScoreSortField" Title="游戏名" SortField="GameScoreSortField.GameName" Value="item => item.GameName">
                <a href="/entries/index/@context.GameId" class="table-summary__link">@context.GameName</a>
            </CgDataTableColumn>
            <CgDataTableColumn TItem="GameScoreTableModel" TSort="GameScoreSortField" Title="配音" SortField="GameScoreSortField.AllCVSocre" Value="item => item.AllCVSocre">
                @context.AllCVSocre.ToString("F1")
            </CgDataTableColumn>
            <CgDataTableColumn TItem="GameScoreTableModel" TSort="GameScoreSortField" Title="程序" SortField="GameScoreSortField.AllSystemSocre" Value="item => item.AllSystemSocre">
                @context.AllSystemSocre.ToString("F1")
            </CgDataTableColumn>
            <CgDataTableColumn TItem="GameScoreTableModel" TSort="GameScoreSortField" Title="演出" SortField="GameScoreSortField.AllShowSocre" Value="item => item.AllShowSocre">
                @context.AllShowSocre.ToString("F1")
            </CgDataTableColumn>
            <CgDataTableColumn TItem="GameScoreTableModel" TSort="GameScoreSortField" Title="美术" SortField="GameScoreSortField.AllPaintSocre" Value="item => item.AllPaintSocre">
                @context.AllPaintSocre.ToString("F1")
            </CgDataTableColumn>
            <CgDataTableColumn TItem="GameScoreTableModel" TSort="GameScoreSortField" Title="剧本" SortField="GameScoreSortField.AllScriptSocre" Value="item => item.AllScriptSocre">
                @context.AllScriptSocre.ToString("F1")
            </CgDataTableColumn>
            <CgDataTableColumn TItem="GameScoreTableModel" TSort="GameScoreSortField" Title="音乐" SortField="GameScoreSortField.AllMusicSocre" Value="item => item.AllMusicSocre">
                @context.AllMusicSocre.ToString("F1")
            </CgDataTableColumn>
            <CgDataTableColumn TItem="GameScoreTableModel" TSort="GameScoreSortField" Title="总分(所有)" SortField="GameScoreSortField.AllTotalSocre" Value="item => item.AllTotalSocre">
                <strong>@context.AllTotalSocre.ToString("F1")</strong>
            </CgDataTableColumn>
            <CgDataTableColumn TItem="GameScoreTableModel" TSort="GameScoreSortField" Title="配音" SortField="GameScoreSortField.FilterCVSocre" Value="item => item.FilterCVSocre">
                @context.FilterCVSocre.ToString("F1")
            </CgDataTableColumn>
            <CgDataTableColumn TItem="GameScoreTableModel" TSort="GameScoreSortField" Title="程序" SortField="GameScoreSortField.FilterSystemSocre" Value="item => item.FilterSystemSocre">
                @context.FilterSystemSocre.ToString("F1")
            </CgDataTableColumn>
            <CgDataTableColumn TItem="GameScoreTableModel" TSort="GameScoreSortField" Title="演出" SortField="GameScoreSortField.FilterShowSocre" Value="item => item.FilterShowSocre">
                @context.FilterShowSocre.ToString("F1")
            </CgDataTableColumn>
            <CgDataTableColumn TItem="GameScoreTableModel" TSort="GameScoreSortField" Title="美术" SortField="GameScoreSortField.FilterPaintSocre" Value="item => item.FilterPaintSocre">
                @context.FilterPaintSocre.ToString("F1")
            </CgDataTableColumn>
            <CgDataTableColumn TItem="GameScoreTableModel" TSort="GameScoreSortField" Title="剧本" SortField="GameScoreSortField.FilterScriptSocre" Value="item => item.FilterScriptSocre">
                @context.FilterScriptSocre.ToString("F1")
            </CgDataTableColumn>
            <CgDataTableColumn TItem="GameScoreTableModel" TSort="GameScoreSortField" Title="音乐" SortField="GameScoreSortField.FilterMusicSocre" Value="item => item.FilterMusicSocre">
                @context.FilterMusicSocre.ToString("F1")
            </CgDataTableColumn>
            <CgDataTableColumn TItem="GameScoreTableModel" TSort="GameScoreSortField" Title="总分(过滤)" SortField="GameScoreSortField.FilterTotalSocre" Value="item => item.FilterTotalSocre">
                <strong>@context.FilterTotalSocre.ToString("F1")</strong>
            </CgDataTableColumn>
        </CgDataTable>
        break;
}
</PanelTemplate>
</CgTabs>

</div>

@code {

    // ── 数据 ──
    private TableViewModel? _summary;
    private string? _loadingError;
    private string _activeTab = "games";
    private bool _isExporting;
    private CancellationTokenSource? _cts;

    // ── Tab 定义 ──
    private static readonly CgTabItem[] _tabs =
    [
        new("games", "游戏", "mdiGamepadSquare"),
        new("groups", "制作组", "mdiAccountMultiple"),
        new("staffs", "STAFF", "mdiMagicStaff"),
        new("makers", "制作人", "mdiCoffeeMakerOutline"),
        new("roles", "角色", "mdiClover"),
        new("prices", "游戏价格", "mdiCurrencyUsd"),
        new("scores", "游戏评分", "mdiStar"),
    ];

    // ── 生命周期 ──

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        PageResponse.Begin();
        try
        {
        var result = await TableService.GetTableSummaryAsync(_cts!.Token);
        if (result.Success && result.Data is not null)
        {
            _summary = result.Data;
            PageResponse.Succeeded();
        }
        else
        {
            _loadingError = result.Error?.Message ?? "加载失败";
            PageResponse.Failed(result.Error);
        }
        }
        catch (OperationCanceledException)
        {
            // Component disposed, ignore.
        }
    }

    // ── 服务端查询委托 ──

    private async Task<CgDataTableResult<BasicInforTableModel>> QueryGamesAsync(CgDataTableRequest<BasicInforSortField> req)
    {
        return await ExecuteQueryAsync(req, (model, ct) => TableService.QueryGamesAsync(model, ct));
    }

    private async Task<CgDataTableResult<GroupInforTableModel>> QueryGroupsAsync(CgDataTableRequest<GroupInforSortField> req)
    {
        return await ExecuteQueryAsync(req, (model, ct) => TableService.QueryGroupsAsync(model, ct));
    }

    private async Task<CgDataTableResult<StaffInforTableModel>> QueryStaffsAsync(CgDataTableRequest<StaffInforSortField> req)
    {
        return await ExecuteQueryAsync(req, (model, ct) => TableService.QueryStaffsAsync(model, ct));
    }

    private async Task<CgDataTableResult<MakerInforTableModel>> QueryMakersAsync(CgDataTableRequest<MakerInforSortField> req)
    {
        return await ExecuteQueryAsync(req, (model, ct) => TableService.QueryMakersAsync(model, ct));
    }

    private async Task<CgDataTableResult<RoleInforTableModel>> QueryRolesAsync(CgDataTableRequest<RoleInforSortField> req)
    {
        return await ExecuteQueryAsync(req, (model, ct) => TableService.QueryRolesAsync(model, ct));
    }

    private async Task<CgDataTableResult<StoreInfoViewModel>> QueryStoreInfoAsync(CgDataTableRequest<StoreTableSortField> req)
    {
        return await ExecuteQueryAsync(req, (model, ct) => TableService.QueryStoreInfoAsync(model, ct));
    }

    private async Task<CgDataTableResult<GameScoreTableModel>> QueryGameScoresAsync(CgDataTableRequest<GameScoreSortField> req)
    {
        return await ExecuteQueryAsync(req, (model, ct) => TableService.QueryGameScoresAsync(model, ct));
    }

    // ── 通用查询适配 ──

    private async Task<CgDataTableResult<T>> ExecuteQueryAsync<T, TSort>(
        CgDataTableRequest<TSort> req,
        Func<QueryParameterModel<TSort>, CancellationToken, Task<SdkResult<QueryResultModel<T, TSort>>>> queryFunc) where T : class where TSort : struct, Enum
    {
        var model = req.ToQueryParameter();

        var result = await queryFunc(model, _cts!.Token);

        if (result.Success && result.Data != null)
        {
            return new CgDataTableResult<T>(
                result.Data.Items.ToList().AsReadOnly(),
                result.Data.Total);
        }

        return new CgDataTableResult<T>([], 0);
    }

    // ── 导出功能 ──

    private async Task OnExportJson()
    {
        await ExportDataAsync("json");
    }

    private async Task OnExportCsv()
    {
        await ExportDataAsync("csv");
    }

    private async Task ExportDataAsync(string format)
    {
        if (_isExporting) return;
        _isExporting = true;
        StateHasChanged();

        try
        {
            var tabDef = _tabs.First(t => t.Key == _activeTab);
            string content;
            string fileName;
            int count;

            switch (_activeTab)
            {
                case "games":
                    var games = await TableService.QueryGamesAsync(new QueryParameterModel<BasicInforSortField> { Page = 1, ItemsPerPage = 99999 });
                    (content, count) = BuildExportContent(games, format);
                    break;
                case "groups":
                    var groups = await TableService.QueryGroupsAsync(new QueryParameterModel<GroupInforSortField> { Page = 1, ItemsPerPage = 99999 });
                    (content, count) = BuildExportContent(groups, format);
                    break;
                case "staffs":
                    var staffs = await TableService.QueryStaffsAsync(new QueryParameterModel<StaffInforSortField> { Page = 1, ItemsPerPage = 99999 });
                    (content, count) = BuildExportContent(staffs, format);
                    break;
                case "makers":
                    var makers = await TableService.QueryMakersAsync(new QueryParameterModel<MakerInforSortField> { Page = 1, ItemsPerPage = 99999 });
                    (content, count) = BuildExportContent(makers, format);
                    break;
                case "roles":
                    var roles = await TableService.QueryRolesAsync(new QueryParameterModel<RoleInforSortField> { Page = 1, ItemsPerPage = 99999 });
                    (content, count) = BuildExportContent(roles, format);
                    break;
                case "prices":
                    var prices = await TableService.QueryStoreInfoAsync(new QueryParameterModel<StoreTableSortField> { Page = 1, ItemsPerPage = 99999 });
                    (content, count) = BuildExportContent(prices, format);
                    break;
                case "scores":
                    var scores = await TableService.QueryGameScoresAsync(new QueryParameterModel<GameScoreSortField> { Page = 1, ItemsPerPage = 99999 });
                    (content, count) = BuildExportContent(scores, format);
                    break;
                default:
                    return;
            }

            if (string.IsNullOrEmpty(content)) return;

            fileName = $"{tabDef.Label} - {count}条记录.{format}";
            var bytes = System.Text.Encoding.UTF8.GetBytes(content);
            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/CnGalWebSite.MainSite.Shared/scripts/site-shell.js");
            await module.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        finally
        {
            _isExporting = false;
            StateHasChanged();
        }
    }

    private static (string Content, int Count) BuildExportContent<T, TSort>(
        SdkResult<QueryResultModel<T, TSort>> result, string format) where T : class where TSort : struct, Enum
    {
        if (!result.Success || result.Data?.Items == null || !result.Data.Items.Any())
            return (string.Empty, 0);

        var items = result.Data.Items;
        var count = items.Count();

        if (format == "json")
        {
            var json = JsonSerializer.Serialize(items, SdkJsonSerializerOptions.Indented);
            return (json, count);
        }
        else // csv
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine(items.First().ToCsvHeader());
            foreach (var item in items)
            {
                sb.AppendLine(item.ToCsvRow());
            }

            return (sb.ToString(), count);
        }
    }

    // ── 格式化辅助 ──

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private static string FormatPrice(double? price)
    {
        return price.HasValue ? $"¥{price.Value:F2}" : "—";
    }

    private static string FormatPercent(double? value)
    {
        return value.HasValue ? $"{value.Value:F0}%" : "—";
    }

}
