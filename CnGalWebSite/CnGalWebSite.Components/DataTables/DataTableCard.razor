@typeparam TModel where TModel : class, new()
@typeparam TSort where TSort : struct, Enum

@inject IHttpService _httpService
@inject IQueryService _queryService
    @using OneOf;

<MDataTable Headers="Headers"
            Items="_items"
            FooterProps="props => { props.ItemsPerPageOptions = new List<OneOf<int, DataItemsPerPageOption>>() { 5,10, 20, 30 }; }"
            MustSort
            Page="_page"
             SortBy="@InitialSortToken"
             SortDesc="@SortDesc"
             OnOptionsUpdate="HandleOnOptionsUpdate"
             ServerItemsLength="_totalDesserts"
             Loading="_loading"
             Class="@Class"
             LoadingText="@LoadingText">
     <TopContent>
         <MToolbar Flat>
            <MToolbarTitle> @Title</MToolbarTitle>
                <MDivider Class="mx-4" Inset Vertical />
             <MSpacer></MSpacer>
             @ButtonContent
            @if (ShowAddButton)
            {
                <MButton Color="primary" Rounded="Rounded"
                          Class="me-8"
                          OnClick="OnClickAdd">
                     <MIcon Left>mdi-plus</MIcon>
                 添加
             </MButton>
            }

            <MTextField Value="_search" ValueChanged="OnSearch" TValue="string"
                        AppendIcon="mdi-magnify"
                        Label="搜索"
                            SingleLine
                         HideDetails="true"></MTextField>
         </MToolbar>

     </TopContent>
     <ItemColContent>
         @ItemColContent(context)
    </ItemColContent>
</MDataTable>

@code {
    [Parameter]
    public List<DataTableHeader<TModel>> Headers { get; set; }
    [Parameter]
    public string ApiUrl { get; set; }
    [Parameter]
    public TSort? DefaultSortField { get; set; }
    [Parameter, EditorRequired]
    public IReadOnlyDictionary<string, TSort> SortFields { get; set; }
    [Parameter]
    public SortMap<TModel, TSort> LocalSorting { get; set; }

    private string InitialSortToken => SortFields.FirstOrDefault(pair => EqualityComparer<TSort>.Default.Equals(pair.Value, DefaultSortField ?? SortFields.First().Value)).Key;
    [Parameter]
    public bool SortDesc { get; set; } = true;
    [Parameter]
    public string Title { get; set; }
    [Parameter]
    public string LoadingText { get; set; }
    [Parameter]
    public bool ShowAddButton { get; set; } = true;
    [Parameter]
    public bool Rounded { get; set; } = true;
    [Parameter]
    public string Class { get; set; } = "elevation-1";
    [Parameter]
    public RenderFragment<ItemColProps<TModel>> ItemColContent { get; set; }
    [Parameter]
    public RenderFragment ButtonContent { get; set; }
    [Parameter]
    public EventCallback OnClickAdd { get; set; }
    [Parameter]
    public Expression<Func<TModel, bool>> Predicate { get; set; }
    [Parameter]
    public List<TModel> DataSource { get; set; }


    private int _page = 1;
    private int _totalDesserts = 0;
    private IEnumerable<TModel> _items = new List<TModel>();
    private bool _loading = true;
    public string _search;
    private QueryResultModel<TModel, TSort> Data = new QueryResultModel<TModel, TSort>();
    MDataTable<TModel> _dataTable;

    [CascadingParameter]
    public ErrorHandler ErrorHandler { get; set; }

    public void HandleOnOptionsUpdate(DataOptions options)
    {
        CopyOptions(Data.Parameter, options);
        GetDataFromApi();
    }

    protected override void OnInitialized()
    {
        foreach (var header in Headers)
            header.Sortable = header.Sortable && SortFields.ContainsKey(header.Value);
        if (DefaultSortField.HasValue)
            Data.Parameter.Sorts = [new(DefaultSortField.Value, SortDesc ? SortDirection.Descending : SortDirection.Ascending)];
        GetDataFromApi();
    }

    public void GetDataFromApi()
    {
        _loading = true;
        GetDataAsync().ContinueWith(task =>
        {
            var data = task.Result;
            _items = data.items;
            _totalDesserts = data.total;
            _loading = false;
            _page = Data.Parameter.Page;
            InvokeAsync(StateHasChanged);
        });
    }

    public void OnSearch(string text)
    {
        _search = text;
        Data.Parameter.SearchText = text;
        Data.Parameter.Page = 1;
        StateHasChanged();
        GetDataFromApi();
    }

    public async Task<(IEnumerable<TModel> items, int total)> GetDataAsync()
    {
        if (string.IsNullOrWhiteSpace(ApiUrl))
        {
            return await _queryService.QueryAsync<TModel, TSort>(DataSource.AsQueryable(), Data.Parameter, Predicate == null ? s => true : Predicate, LocalSorting);
        }
        else
        {
            try
            {
                Data = await _httpService.PostAsync<QueryParameterModel<TSort>, QueryResultModel<TModel, TSort>>(ApiUrl, Data.Parameter);
                return (Data.Items, Data.Total);
            }
            catch (Exception ex)
            {
                await ErrorHandler.ProcessError(ex, $"获取 {Title} 数据失败");
                return (new List<TModel>(), 0);
            }
        }
    }

    public async Task<IEnumerable<TModel>> QueryAllAsync()
    {
        if (string.IsNullOrWhiteSpace(ApiUrl))
        {
            return DataSource;
        }
        else
        {
            try
            {
                var param = Data.Parameter.TryDeepClone();
                param.ItemsPerPage = int.MaxValue;
                var allData = await _httpService.PostAsync<QueryParameterModel<TSort>, QueryResultModel<TModel, TSort>>(ApiUrl, param);
                return allData.Items;
            }
            catch (Exception ex)
            {
                await ErrorHandler.ProcessError(ex, $"获取 {Title} 数据失败");
                return new List<TModel>();
            }
        }
    }

    public void CopyOptions(QueryParameterModel<TSort> parameter, DataOptions options)
    {
        var fields = options.SortBy.ToArray();
        var directions = options.SortDesc.ToArray();
        var sorts = new List<SortOption<TSort>>();
        for (var i = 0; i < fields.Length; i++)
        {
            if (SortFields.TryGetValue(fields[i], out var field))
                sorts.Add(new(field, i < directions.Length && directions[i] ? SortDirection.Descending : SortDirection.Ascending));
        }
        parameter.Sorts = sorts;
        parameter.ItemsPerPage = options.ItemsPerPage == 0 ? 10 : options.ItemsPerPage;
        parameter.Page = options.Page == 0 ? 1 : options.Page;
    }
}
