@using CnGalWebSite.DataModel.Sorting
@inject IHttpService _httpService
@inject IPopupService PopupService
@inject IEventService _eventService

<MDCard>
    <DataTableCard TModel="MakerInforTableModel" TSort="MakerInforSortField" SortFields="_sortFields" Headers="_headers" ApiUrl="@(_baseUrl)" DefaultSortField="MakerInforSortField.RealId" ShowAddButton="false" Title="@($"{_name}列表")" @ref="dataTableCard">
        <ButtonContent>
            <CnGalWebSite.Shared.MasaComponent.Shared.Buttons.ExportButton OnQueryAsync="@(async ()=>await dataTableCard?.QueryAllAsync())" Name="制作人" Class="me-4" />
        </ButtonContent>

        <ItemColContent>
            @if (context.Header.Value == "actions")
            {
                <MIcon Color="info"
                       Class="mr-2"
                       OnClick="()=>LookItem(context.Item)">@IconType.Look.ToIconString()</MIcon>
            }
            else
            {
                @context.Value
            }
        </ItemColContent>
    </DataTableCard>
</MDCard>




@code {
    private static readonly IReadOnlyDictionary<string, MakerInforSortField> _sortFields = new Dictionary<string, MakerInforSortField>
    {
        [nameof(MakerInforTableModel.AnotherName)] = MakerInforSortField.AnotherName,
        [nameof(MakerInforTableModel.Bilibili)] = MakerInforSortField.Bilibili,
        [nameof(MakerInforTableModel.MicroBlog)] = MakerInforSortField.MicroBlog,
        [nameof(MakerInforTableModel.Name)] = MakerInforSortField.Name,
        [nameof(MakerInforTableModel.RealId)] = MakerInforSortField.RealId,
    };

    private bool _editDialog;
    private long _editedItemId;
    private bool _detailDialog;

    private string _baseUrl = "api/tables/ListMakers";
    private string _name = "制作者";

    private List<DataTableHeader<MakerInforTableModel>> _headers = new List<DataTableHeader<MakerInforTableModel>>
    {
        new ()
          {
            Text= "Id",
            Align= DataTableHeaderAlign.Start,
            Value= nameof(MakerInforTableModel.RealId)
          },
          new (){ Text= "名称", Value= nameof(MakerInforTableModel.Name)},
          new (){ Text= "别称", Value= nameof(MakerInforTableModel.AnotherName)},
          new (){ Text= "B站", Value= nameof(MakerInforTableModel.Bilibili)},
          new (){ Text= "微博", Value= nameof(MakerInforTableModel.MicroBlog)},
          new (){ Text= "操作", Value= "actions",Sortable=false }
    };

    DataTableCard<MakerInforTableModel, MakerInforSortField> dataTableCard;

    [CascadingParameter]
    public ErrorHandler ErrorHandler { get; set; }

    public async Task LookItem(MakerInforTableModel model)
    {
        await _eventService.OpenNewPage("https://www.cngal.org/entries/index/" + model.RealId);
    }
}
