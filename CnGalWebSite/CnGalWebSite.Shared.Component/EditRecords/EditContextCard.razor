@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject IHttpService _httpService

<MDCard Outline>
    <CnGalWebSite.Components.Containers.MasaTitleContainer Icon="@IconType.MainPage.ToIconString()" Title="概览" Outline Class="mb-4">
        <ButtonContent>
            <CnGalWebSite.Components.Buttons.MasaButton Rounded Icon="mdi-share" Text="查看详情" OnClick="@(()=>NavigationManager.NavigateTo("/examine?Id="+Model.Id))" StopPropagation />
         </ButtonContent>
         <ChildContent>
             <CnGalWebSite.Shared.MasaComponent.Shared.Components.Markdown.MarkdownViewTip Text="@_editOverview" Class="overflow-y-auto" Style="max-height: 420px;" />
             @if (_isLoading)
             {
                 <div class="pa-3" role="status">正在加载概览…</div>
             }
             else if (_loadFailed)
             {
                 <div class="pa-3 d-flex align-center ga-3" role="alert">
                     <span>概览加载失败。</span>
                     <CnGalWebSite.Components.Buttons.MasaButton Text="重新加载" Small Outlined IsAsync="true" OnClick="LoadOverviewAsync" />
                 </div>
             }
         </ChildContent>
     </CnGalWebSite.Components.Containers.MasaTitleContainer>
     @if (string.IsNullOrWhiteSpace(Model.Comments) == false)
    {
        <CnGalWebSite.Components.Containers.MasaTitleContainer Icon="@IconType.Note.ToIconString()" Title="批注" Class="mb-4" Outline>
         <div style=" white-space: break-spaces;">
             @Model.Comments
         </div>
     </CnGalWebSite.Components.Containers.MasaTitleContainer>
    }
    @if (string.IsNullOrWhiteSpace(Model.Note) == false)
    {
        <CnGalWebSite.Components.Containers.MasaTitleContainer Icon="@IconType.Note.ToIconString()" Title="备注" Class="mb-4" Outline>
         <div style=" white-space: break-spaces;">
             @Model.Note
         </div>
     </CnGalWebSite.Components.Containers.MasaTitleContainer>
    }
</MDCard>

@code {
    [Parameter]
    public EditRecordAloneViewModel Model { get; set; }

    private string? _editOverview;
    private long _loadedId = -1;
    private long _lastAttemptedId = long.MinValue;
    private long _requestVersion;
    private bool _isLoading;
    private bool _loadFailed;

    protected override async Task OnParametersSetAsync()
    {
        var requestedId = Model?.Id ?? -1;
        if (requestedId == _lastAttemptedId)
        {
            return;
        }

        _lastAttemptedId = requestedId;
        await LoadOverviewAsync();
    }

    private async Task LoadOverviewAsync()
    {
        var requestedId = Model?.Id ?? -1;
        var requestVersion = ++_requestVersion;
        _editOverview = null;
        _loadedId = -1;
        _loadFailed = false;
        _isLoading = requestedId > 0;
        if (requestedId <= 0) return;

        try
        {
            var detail = await _httpService.GetAsync<ExamineViewModel>($"api/examines/GetExamineView/{requestedId}");
            if (!IsCurrentOverviewRequest(requestedId, requestVersion)) return;
            _editOverview = detail?.EditOverview;
            _loadedId = requestedId;
        }
        catch
        {
            if (!IsCurrentOverviewRequest(requestedId, requestVersion)) return;
            _loadFailed = true;
        }
        finally
        {
            if (IsCurrentOverviewRequest(requestedId, requestVersion))
            {
                _isLoading = false;
                _lastAttemptedId = requestedId;
            }
        }
    }

    private bool IsCurrentOverviewRequest(long requestedId, long requestVersion) =>
        requestVersion == _requestVersion && (Model?.Id ?? -1) == requestedId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        try
        {
            await JS.InvokeAsync<string>("highlightAllCode");
        }
        catch
        {

        }
    }
}
