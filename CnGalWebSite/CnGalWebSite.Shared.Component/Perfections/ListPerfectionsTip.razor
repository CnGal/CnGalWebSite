@using CnGalWebSite.DataModel.Sorting
@inject IHttpService _httpService
@inject IPopupService PopupService
@inject NavigationManager NavigationManager

<MDCard>
    <DataTableCard TModel="PerfectionOverviewModel" TSort="PerfectionSortField" DefaultSortField="PerfectionSortField.Id" SortFields="_sortFields" Headers="_headers" ApiUrl="@(_baseUrl)" ShowAddButton="false" Title="@($"{_name}列表")" @ref="dataTableCard">
        <ItemColContent>
            @if (context.Header.Value == nameof(PerfectionOverviewModel.Name))
            {
                <CnGalWebSite.Shared.MasaComponent.PC.Admin.Users.Certifications.EntryChip Id="@context.Item.Id" Name="@context.Item.Name" Type="@EntryType.Game" />
            }
            else
            {
                @context.Value
            }
        </ItemColContent>
    </DataTableCard>
</MDCard>




@code {
    private static readonly IReadOnlyDictionary<string, PerfectionSortField> _sortFields = new Dictionary<string, PerfectionSortField>
    {
        [nameof(PerfectionOverviewModel.Grade)] = PerfectionSortField.Grade,
        [nameof(PerfectionOverviewModel.Id)] = PerfectionSortField.Id,
        [nameof(PerfectionOverviewModel.Name)] = PerfectionSortField.Name,
        [nameof(PerfectionOverviewModel.VictoryPercentage)] = PerfectionSortField.VictoryPercentage,
    };

    private bool _editDialog;
    private long _editedItemId;
    private bool _detailDialog;

    private string _baseUrl = "api/perfections/ListPerfections";
    private string _name = "完善度";

    private List<DataTableHeader<PerfectionOverviewModel>> _headers = new List<DataTableHeader<PerfectionOverviewModel>>
    {
        new ()
          {
            Text= "Id",
            Align= DataTableHeaderAlign.Start,
            Value= nameof(PerfectionOverviewModel.Id)
          },
          new (){ Text= "词条", Value= nameof(PerfectionOverviewModel.Name), Sortable=false},
          new (){ Text= "完善度", Value= nameof(PerfectionOverviewModel.Grade)},
          new (){ Text= "击败全站词条百分比", Value= nameof(PerfectionOverviewModel.VictoryPercentage)},
    };

    DataTableCard<PerfectionOverviewModel, PerfectionSortField> dataTableCard;
}
