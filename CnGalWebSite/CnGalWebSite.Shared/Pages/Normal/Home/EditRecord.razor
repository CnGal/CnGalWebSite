@page "/home/editrecord"
@inject IDataCacheService DataCache
@using CnGalWebSite.DataModel.ViewModel.Admin
@if (_comparison is not null)
{
    <h2>版本 #@_comparison.ContrastId → #@_comparison.CurrentId</h2>
    <h3>基准版本</h3>
    <CnGalWebSite.Shared.Component.Admin.Examines.Cards.PreViewCard Model="_comparison.Before" />
    <h3>目标版本</h3>
    <CnGalWebSite.Shared.Component.Admin.Examines.Cards.PreViewCard Model="_comparison.After" />
}
@code {
    [SupplyParameterFromQuery, Parameter] public long ContrastId { get; set; }
    [SupplyParameterFromQuery, Parameter] public long CurrentId { get; set; }
    private EditRecordComparison _comparison;
    protected override async Task OnParametersSetAsync()
    {
        var overview = await DataCache.ExaminesOverviewCatche.GetCache(ContrastId.ToString());
        var current = CurrentId > 0 ? CurrentId : overview.Examines.OrderBy(r => r.PassedTime).ThenBy(r => r.Id).Last().Id;
        var key = ContrastId + "/" + current;
        _comparison = overview.Type switch
        {
            ExaminedNormalListModelType.Entry => await DataCache.EntryContrastEditRecordViewCatche.GetCache(key),
            ExaminedNormalListModelType.Article => await DataCache.ArticleContrastEditRecordViewCatche.GetCache(key),
            ExaminedNormalListModelType.Tag => await DataCache.TagContrastEditRecordViewCatche.GetCache(key),
            ExaminedNormalListModelType.Periphery => await DataCache.PeripheryContrastEditRecordViewCatche.GetCache(key),
            ExaminedNormalListModelType.Video => await DataCache.VideoContrastEditRecordViewCatche.GetCache(key),
            _ => null
        };
    }
}
