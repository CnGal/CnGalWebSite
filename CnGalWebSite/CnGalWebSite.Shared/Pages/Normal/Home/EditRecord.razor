@page "/home/editrecord"

@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject IDataCacheService _dataCatcheService
@implements IDisposable

@if (isReady && !_loadFailed)
{
    <CnGalWebSite.Shared.MasaComponent.Shared.Cards.TitleTip NoIndex Title="@("『"+ExaminesOverview.ObjectName+"』第" +(ExaminesOverview.Examines.FindIndex(s=>s.Id==ContrastId)+1)+"次编辑记录")" Description="@ExaminesOverview.ObjectBriefIntroduction" Image="@ExaminesOverview.Image"/>
}

@if (_loadFailed)
{
    <p role="alert">@_comparisonError</p>
}
else if (isReady)
{
    <OverviewCard Model="ExaminesOverview" @ref="overviewCard" />
    <ContrastOverview Model="ExaminesOverview" ContrastItem="@ContrastId.ToString()" CurrentItem="@CurrentId.ToString()"
                                                                                   ContrastChanged="ContrastChanged" CurrentChanged="CurrentChanged">
        <ContrastView>
            @if (isRefreshing)
            {
                <CnGalWebSite.Components.Progressings.ProgressingCard Page Fill />
            }
            else if (_comparison is null)
            {
                <p>@_comparisonError</p>
            }
            else
            {
                <CnGalWebSite.Shared.Component.Admin.Examines.Cards.PreViewCard Model="_comparison.Before" />
            }
        </ContrastView>
        <CurrentView>
            @if (isRefreshing)
            {
                <CnGalWebSite.Components.Progressings.ProgressingCard Page Fill />
            }
            else if (_comparison is null)
            {
                <p>@_comparisonError</p>
            }
            else
            {
                <CnGalWebSite.Shared.Component.Admin.Examines.Cards.PreViewCard Model="_comparison.After" />
            }
        </CurrentView>
    </ContrastOverview>
}
else
{
    <CnGalWebSite.Components.Progressings.ProgressingCard Page />
}


@code {

    [SupplyParameterFromQuery]
    [Parameter]
    public long ContrastId { get; set; }

    [SupplyParameterFromQuery]
    [Parameter]
    public long CurrentId { get; set; }

    bool isReady = false;
    bool isRefreshing = true;
    bool _loadFailed;

    [CascadingParameter]
    public ErrorHandler ErrorHandler { get; set; }

    public ExaminesOverviewViewModel ExaminesOverview { get; set; } = new ExaminesOverviewViewModel();

    private EditRecordComparison _comparison;
    private string _comparisonError;
    private long _comparisonRequestVersion;

    OverviewCard overviewCard;

    async Task OnReLoad()
    {
        _loadFailed = false;
        _comparisonError = null;
        try
        {
            var overview = await _dataCatcheService.ExaminesOverviewCatche.GetCache(ContrastId.ToString());
            if (overview is null)
            {
                _loadFailed = true;
                _comparisonError = "未找到可用的编辑记录。";
                return;
            }

            ExaminesOverview = overview;
            await OnRefreshContrastView(ContrastId.ToString(), CurrentId.ToString());

            isReady = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _loadFailed = true;
            _comparisonError = "加载编辑记录失败。";
            await ErrorHandler.ProcessError(ex, "获取编辑记录概览失败");
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
           await  OnReLoad();

            NavigationManager.LocationChanged -= LocationChanged;
            NavigationManager.LocationChanged += LocationChanged;
        }

    }
    public async void LocationChanged(object sender, LocationChangedEventArgs args)
    {
        if(NavigationManager.Uri.Contains("/home/editrecord"))
        {
            try
            {
                await OnRefreshContrastView(ContrastId.ToString(), CurrentId.ToString());
            }
            catch
            {

            }
        }

    }

    protected override async Task OnInitializedAsync()
    {

    }
    public void ContrastChanged(string conId)
    {
        if (overviewCard != null)
        {
            int index = ExaminesOverview.Examines.FindIndex(s => s.IsSelected);
            if (index == ExaminesOverview.Examines.Count - 1)
            {
                overviewCard.SelecteChanged(ExaminesOverview.Examines[index]);
            }
            else
            {
                overviewCard.SelecteChanged(ExaminesOverview.Examines[index + 1]);
            }
        }

        NavigationManager.NavigateTo("/home/editrecord?ContrastId=" + conId + "&CurrentId=" + CurrentId);


    }
    public void CurrentChanged(string curId)
    {
        NavigationManager.NavigateTo("/home/editrecord?ContrastId=" + ContrastId + "&CurrentId=" + curId);
    }

    public async Task OnRefreshContrastView(string conId, string curId)
    {
        var version = ++_comparisonRequestVersion;
        try
        {
            isRefreshing = true;
            _comparisonError = null;
            StateHasChanged();

            var contrastId = long.Parse(conId);
            var latest = ExaminesOverview.Examines.LastOrDefault();
            if (latest is null)
            {
                _comparison = null;
                _comparisonError = "未找到可用的编辑记录。";
                return;
            }

            var currentId = curId == "0" ? latest.Id : long.Parse(curId);
            var comparison = await _dataCatcheService.GetEditRecordComparisonAsync(ExaminesOverview.Type, contrastId, currentId);
            if (version != _comparisonRequestVersion)
            {
                return;
            }

            _comparison = comparison;
            if (_comparison is not null)
            {
                ContrastId = _comparison.ContrastId;
                CurrentId = _comparison.CurrentId;
            }
            else
            {
                _comparisonError = "无法加载版本对比，该记录可能已失效或不属于同一对象。";
            }
        }
        catch (Exception ex)
        {
            if (version != _comparisonRequestVersion)
            {
                return;
            }

            _comparison = null;
            _comparisonError = "无法加载版本对比，该记录可能已失效或不属于同一对象。";
            await ErrorHandler.ProcessError(ex, "获取详细编辑对比视图失败");
        }
        finally
        {
            if (version == _comparisonRequestVersion)
            {
                isRefreshing = false;
                StateHasChanged();
            }
        }
    }
    #region 释放实例

    public void  Dispose()
    {

        NavigationManager.LocationChanged -= LocationChanged;

        GC.SuppressFinalize(this);
    }
    #endregion
}
