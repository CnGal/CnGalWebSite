@using CnGalWebSite.DataModel.Sorting
@using CnGalWebSite.Core.Models
<div>
    @foreach (var item in sorts)
    {
        <MChip Class="ma-1" OnClick="@(()=>OnClick(item.Key))" Small
               Color="primary"
               Outlined="item.Key!=current">
            @item.Value
        </MChip>
    }
    @if (current != SearchSortField.Default)
    {
        @if (asc)
        {
            <MChip Class="ma-1" OnClick="@(()=>OnSwitchSort(false))" Small
                    Color="primary">
                <MIcon Left Small>
                    mdi-sort-ascending
                </MIcon>
                顺序
            </MChip>
        }
        else
        {
            <MChip Class="ma-1" OnClick="@(()=>OnSwitchSort(true))" Small
                    Color="primary">
                <MIcon Left Small>
                    mdi-sort-descending
                </MIcon>
                逆序
            </MChip>
        }
    }


</div>

@code {
    [Parameter]
    public SearchInputModel Model { get; set; }
    [Parameter]
    public EventCallback OnChanged { get; set; }
    [Parameter]
    public string Color { get; set; }

    bool asc = false;
    SearchSortField current;

    protected override void OnParametersSet()
    {
        current = Model.SortField;
        asc = Model.SortDirection == SortDirection.Ascending;
    }


    List<KeyValuePair<SearchSortField, string>> sorts = new List<KeyValuePair<SearchSortField, string>>
{
        new KeyValuePair<SearchSortField,string>(SearchSortField.Default,"默认排序"),
        new KeyValuePair<SearchSortField,string>(SearchSortField.LastEditTime,"最后编辑时间"),
        new KeyValuePair<SearchSortField,string>(SearchSortField.PublishTime,"发布时间"),
        new KeyValuePair<SearchSortField,string>(SearchSortField.CreateTime,"创建时间"),
        new KeyValuePair<SearchSortField,string>(SearchSortField.ReaderCount,"热度"),
    };

    public async Task OnClick(SearchSortField text)
    {
        current = text;
        Model.SortField = current;
        Model.SortDirection = asc ? SortDirection.Ascending : SortDirection.Descending;

        await OnChanged.InvokeAsync();
    }

    public  async Task OnSwitchSort(bool value)
    {
        asc = value;
        Model.SortField = current;
        Model.SortDirection = asc ? SortDirection.Ascending : SortDirection.Descending;

        await OnChanged.InvokeAsync();
    }

}
