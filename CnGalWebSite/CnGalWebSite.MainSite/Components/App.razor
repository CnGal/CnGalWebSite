<head>
    <meta charset="utf-8"/>
    <script>
        (() => {
            const match = document.cookie.match(/(?:^|;\s*)cg-theme=([^;]*)/);
            let theme = match?.[1];
            if (theme !== 'dark' && theme !== 'light') {
                try { theme = localStorage.getItem('cg-theme'); } catch { }
                if (theme === 'dark' || theme === 'light') {
                    document.cookie = 'cg-theme=' + theme + '; path=/; max-age=31536000; samesite=lax';
                    try { localStorage.removeItem('cg-theme'); } catch { }
                }
            }
            document.documentElement.dataset.theme = theme === 'dark' || theme === 'light'
                ? theme : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            try { localStorage.removeItem('cg-theme'); } catch { }
        })();
    </script>
